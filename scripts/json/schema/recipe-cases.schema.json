{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The cases of a recipe",
  "description": "The fields of a recipe that orm's scripts read to list its cases: the id of each case, the databases it names, its deadline and the op and expect of each step, and the fixture. scripts/features/schema/recipe.schema.json states the whole format, which this schema leaves open.",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "fixture": { "type": "string" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "only": { "type": "array", "items": { "type": "string" } },
          "deadline": {
            "type": "object",
            "required": ["steps"],
            "properties": { "steps": { "type": "integer", "minimum": 1 } }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["op"],
              "properties": { "op": { "type": "string" }, "expect": { "type": "object" } }
            }
          }
        }
      }
    }
  }
}
