{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config/dependency-policy.json",
  "type": "object",
  "required": [
    "schema",
    "composerPlatforms",
    "pythonManifests",
    "pythonLocks",
    "npmLocks",
    "exceptions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "composerPlatforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "manifest",
          "php"
        ],
        "additionalProperties": false,
        "properties": {
          "manifest": {
            "type": "string",
            "pattern": "^([^/\\\\][^\\\\]*/)?composer\\.json$"
          },
          "php": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        }
      }
    },
    "pythonManifests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([^/\\\\][^\\\\]*/)?pyproject\\.toml$"
      }
    },
    "npmLocks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([^/\\\\][^\\\\]*/)?package-lock\\.json$"
      }
    },
    "pythonLocks": {
      "description": "Each Python lock (PEP 751, pylock.toml or pylock.<name>.toml) with its declared source. The writer (make python-lock) resolves the source with uv; the offline check (make python-lock-check) reads the lock against the source. The source has the direct requirements and the constraints that pin every package of the lock.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lock",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "lock": {
            "type": "string",
            "pattern": "^([^/\\\\][^\\\\]*/)?pylock(\\.[A-Za-z0-9_-]+)?\\.toml$"
          },
          "source": {
            "type": "object",
            "required": [
              "requirements",
              "constraints"
            ],
            "additionalProperties": false,
            "properties": {
              "requirements": {
                "type": "string",
                "pattern": "^([^/\\\\][^\\\\]*/)?(pyproject\\.toml|[A-Za-z0-9._-]+\\.(txt|in))$",
                "description": "A requirements file (one requirement per line, name with an optional exact or range specifier, or name @ url) that names the direct dependencies, or a pyproject.toml whose static [project].dependencies name them."
              },
              "constraints": {
                "type": "string",
                "pattern": "^([^/\\\\][^\\\\]*/)?[A-Za-z0-9._-]+\\.(txt|in)$",
                "description": "A constraints file that pins every package of the lock, transitive ones too: name==version, or name @ url#sha256=<digest> for a polyspec archive."
              },
              "findLinks": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^/\\\\]",
                "description": "A directory of the checkout, relative to the root, with the local wheels that uv reads with --no-index --find-links; the lock then names each local wheel by a path relative to the lock."
              }
            }
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ecosystem",
          "manifest",
          "package",
          "reason",
          "removalCondition",
          "verification"
        ],
        "additionalProperties": false,
        "properties": {
          "ecosystem": {
            "type": "string",
            "enum": [
              "npm",
              "composer",
              "pypi",
              "go"
            ]
          },
          "manifest": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "removalCondition": {
            "type": "string",
            "pattern": "\\S"
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "taggedNpmPackages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "directory",
          "repository",
          "tag",
          "version",
          "fix"
        ],
        "additionalProperties": false,
        "properties": {
          "directory": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "fix": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
