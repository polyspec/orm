{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config/dependency-review.json",
  "type": "object",
  "required": [
    "schema",
    "comment",
    "reviewed",
    "locks",
    "dependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "comment": {
      "type": "string"
    },
    "reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lock",
          "sha256",
          "advisories"
        ],
        "additionalProperties": false,
        "properties": {
          "lock": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "advisories": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ecosystem",
          "manifest",
          "package",
          "version",
          "latest"
        ],
        "additionalProperties": false,
        "properties": {
          "ecosystem": {
            "type": "string",
            "enum": [
              "npm",
              "composer",
              "pypi",
              "go"
            ]
          },
          "manifest": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "latest": {
            "type": "string"
          }
        }
      }
    }
  }
}
