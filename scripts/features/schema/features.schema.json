{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contracts/features.json",
  "description": "The feature manifest: each feature, its client statuses, its verification commands and its coverage, and the helpers that several features use. scripts/features/check.mts checks what this schema cannot: VERSION, the paths on disk, the unique ids, the shards and the fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "contract_version", "source", "features"],
  "properties": {
    "manifest_version": { "const": 1 },
    "contract_version": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_order", "path_rule"],
      "properties": {
        "read_order": { "$ref": "#/$defs/paths", "type": "array", "minItems": 1 },
        "path_rule": { "type": "string" }
      }
    },
    "features": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feature" } },
    "helpers": { "type": "array", "items": { "$ref": "#/$defs/helper" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "fields"],
      "properties": { "type": { "type": "string" }, "fields": { "type": "array", "items": { "type": "string" } } }
    },
    "clientStatus": { "enum": ["planned", "partial", "pass", "unsupported"] },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "title_ko", "status", "description", "description_ko", "inputs", "outputs", "state", "errors", "clients", "fixtures", "tests", "docs", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "title": { "type": "string" },
        "title_ko": { "type": "string" },
        "status": { "enum": ["planned", "partial", "implemented"] },
        "description": { "type": "string" },
        "description_ko": { "type": "string" },
        "inputs": { "$ref": "#/$defs/shape" },
        "outputs": { "$ref": "#/$defs/shape" },
        "state": { "type": "array", "items": { "type": "string" } },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "when"],
            "properties": { "code": { "type": "string" }, "when": { "type": "string" } }
          }
        },
        "clients": {
          "type": "object",
          "additionalProperties": false,
          "required": ["go", "php", "rust", "typescript", "python"],
          "properties": {
            "go": { "$ref": "#/$defs/clientStatus" },
            "php": { "$ref": "#/$defs/clientStatus" },
            "rust": { "$ref": "#/$defs/clientStatus" },
            "typescript": { "$ref": "#/$defs/clientStatus" },
            "python": { "$ref": "#/$defs/clientStatus" }
          }
        },
        "fixtures": { "$ref": "#/$defs/paths" },
        "tests": { "$ref": "#/$defs/paths" },
        "docs": { "$ref": "#/$defs/paths" },
        "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
        "coverage": { "$ref": "#/$defs/coverage" },
        "public_constraints": { "type": "array", "items": { "type": "string" } },
        "vector_contract": { "$ref": "#/$defs/vectorContract" }
      },
      "allOf": [
        {
          "description": "An implemented feature names its tests and its documents.",
          "if": { "properties": { "status": { "const": "implemented" } } },
          "then": { "properties": { "tests": { "type": "array", "minItems": 1 }, "docs": { "type": "array", "minItems": 1 } } }
        },
        {
          "description": "A feature that is not planned declares its verification commands.",
          "if": { "properties": { "status": { "enum": ["partial", "implemented"] } } },
          "then": { "properties": { "verification": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "shard"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "command": { "$ref": "#/$defs/text" },
        "shard": { "type": "string" },
        "inputs": { "$ref": "#/$defs/paths" },
        "cwd": { "$ref": "#/$defs/text" },
        "environment": { "const": "linux-runner" }
      }
    },
    "vectorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "required_clients", "required_databases", "database_expectations", "minimum_vectors"],
      "properties": {
        "source": { "const": "tests/conformance/vectors.json" },
        "required_clients": { "const": ["go", "php", "rust", "typescript"] },
        "required_databases": { "const": ["mysql", "postgres", "sqlite"] },
        "database_expectations": { "$ref": "#/$defs/paths", "type": "array", "minItems": 3, "maxItems": 3 },
        "minimum_vectors": { "type": "integer", "minimum": 1 }
      }
    },
    "language": { "enum": ["go", "php", "rust", "typescript", "python"] },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "commands": {
      "type": "object",
      "propertyNames": { "enum": ["mysql", "postgres", "sqlite", "none"] },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runner", "test", "cases"],
          "properties": {
            "runner": { "enum": ["go", "php", "cargo", "node", "python"] },
            "test": { "$ref": "#/$defs/text" },
            "cases": { "$ref": "#/$defs/cases" },
            "symbols": { "type": "object", "additionalProperties": { "type": "string" } },
            "dsn_env": { "type": "string" }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cases", "owners", "dependents"],
      "properties": {
        "kind": { "enum": ["database", "independent"] },
        "cases": { "$ref": "#/$defs/cases" },
        "owners": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/language" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["part", "tests", "commands"],
            "properties": {
              "part": { "$ref": "#/$defs/text" },
              "tests": { "$ref": "#/$defs/paths" },
              "inputs": { "$ref": "#/$defs/paths" },
              "commands": { "$ref": "#/$defs/commands" }
            }
          }
        },
        "dependents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "language", "part", "tests", "cases", "commands"],
            "properties": {
              "id": { "$ref": "#/$defs/text" },
              "language": { "$ref": "#/$defs/language" },
              "part": { "$ref": "#/$defs/text" },
              "tests": { "$ref": "#/$defs/paths" },
              "cases": { "$ref": "#/$defs/cases" },
              "commands": { "$ref": "#/$defs/commands" }
            }
          }
        }
      }
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "tests", "command"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "paths": { "$ref": "#/$defs/paths", "type": "array", "minItems": 1 },
        "tests": { "$ref": "#/$defs/paths" },
        "command": { "$ref": "#/$defs/text" }
      }
    }
  }
}
