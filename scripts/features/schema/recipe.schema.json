      "model.create": {"type": "object", "required": ["op", "connection", "model", "values"], "additionalProperties": false, "properties": {"op": {"const": "model.create"}, "connection": {"$ref": "#/$defs/name"}, "model": {"$ref": "#/$defs/model"}, "values": {"$ref": "#/$defs/assignments"}, "as": {"$ref": "#/$defs/name"}, "expect": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/outcomes/error"}}}},
