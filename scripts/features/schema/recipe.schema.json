{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "orm recipe",
  "description": "The recipe format of docs/spec/feature-coverage.md (FCV-2 to FCV-4). A recipe with a fixture expects exactly mysql, postgres and sqlite; a recipe without one expects exactly none.",
  "type": "object",
  "required": ["$schema", "requirements", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "pattern": "(^|/)recipe\\.schema\\.json$" },
    "requirements": { "$ref": "#/$defs/requirements" },
    "fixture": { "type": "string", "pattern": "(^|/)dbspec-set\\.json$|^none$", "description": "A dbspec-set.json document set, or none: the cases of a recipe with fixture none run on an empty case database (FCV-3)." },
    "seed": { "$ref": "#/$defs/seed" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "schema": { "type": "string", "pattern": "\\.dbs$", "description": "The schema manifest that the ir.validate steps check their requests against, relative to the recipe file." }
  },
  "if": { "type": "object", "required": ["fixture"], "properties": { "fixture": true } },
  "then": { "$ref": "#/$defs/expectations/databases" },
  "else": {
    "allOf": [
      {
        "$ref": "#/$defs/expectations/none"
      },
      {
        "type": "object",
        "properties": {
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "op": {
                        "not": {
                          "enum": [
                            "model.connect",
                            "sql.exec"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "$defs": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]+[a-z]?$" }
    },
    "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
    "model": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$", "description": "The model name as the generator spells it, such as CompositeAccount (FCV-4)." },
    "seed": {
      "type": "object",
      "required": ["rows"],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/name" },
              "additionalProperties": { "$ref": "#/$defs/value" }
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "requirements", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "requirements": { "$ref": "#/$defs/requirements" },
        "seed": { "$ref": "#/$defs/seed" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "value": {
      "description": "A recipe wrapper: one key that names the form of the value.",
      "oneOf": [
        { "type": "object", "required": ["int"], "additionalProperties": false, "properties": { "int": { "type": "string", "pattern": "^-?(0|[1-9][0-9]{0,19})$" } } },
        { "type": "object", "required": ["text"], "additionalProperties": false, "properties": { "text": { "type": "string" } } },
        { "type": "object", "required": ["date"], "additionalProperties": false, "properties": { "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } },
        { "type": "object", "required": ["time"], "additionalProperties": false, "properties": { "time": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?$" } } },
        { "type": "object", "required": ["datetime"], "additionalProperties": false, "properties": { "datetime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?$" } } },
        { "type": "object", "required": ["decimal"], "additionalProperties": false, "properties": { "decimal": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" } } },
        { "type": "object", "required": ["bytes_hex"], "additionalProperties": false, "properties": { "bytes_hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" } } },
        { "type": "object", "required": ["bool"], "additionalProperties": false, "properties": { "bool": { "type": "boolean" } } },
        { "type": "object", "required": ["null"], "additionalProperties": false, "properties": { "null": { "type": "string", "minLength": 1 } } },
        { "type": "object", "required": ["nil"], "additionalProperties": false, "properties": { "nil": { "const": true } } },
        { "type": "object", "required": ["float"], "additionalProperties": false, "properties": { "float": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$" } } },
        { "type": "object", "required": ["f64"], "additionalProperties": false, "properties": { "f64": { "enum": ["NaN", "Infinity", "-Infinity"], "description": "A non-finite binary64 number (the bind vectors of tests/bind/vectors.json); a finite one is a float wrapper." } } },
        { "type": "object", "required": ["array"], "additionalProperties": false, "properties": { "array": { "type": "array", "items": { "$ref": "#/$defs/value" } } } },
        {
          "type": "object",
          "required": ["object"],
          "additionalProperties": false,
          "properties": {
            "object": {
              "type": "array",
              "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "$ref": "#/$defs/value" }], "minItems": 2, "maxItems": 2 }
            }
          }
        }
      ]
    },
    "ref": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": { "ref": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*(\\.[A-Za-z0-9_]+)*$" } }
    },
    "argument": {
      "oneOf": [
        { "$ref": "#/$defs/value" },
        { "$ref": "#/$defs/ref" },
        {
          "type": "object",
          "required": ["mysql", "postgres", "sqlite"],
          "additionalProperties": false,
          "properties": { "mysql": { "$ref": "#/$defs/value" }, "postgres": { "$ref": "#/$defs/value" }, "sqlite": { "$ref": "#/$defs/value" } }
        }
      ]
    },
    "encodeArgument": {
      "description": "The value of codec.encode: an argument, or an ordered_json wrapper, the ordered-json value of its value whatever the stages (FCV-4).",
      "oneOf": [
        { "$ref": "#/$defs/argument" },
        { "type": "object", "required": ["ordered_json"], "additionalProperties": false, "properties": { "ordered_json": { "$ref": "#/$defs/value" } } }
      ]
    },
    "sql": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["mysql", "postgres", "sqlite"],
          "additionalProperties": false,
          "properties": {
            "mysql": { "type": "string", "minLength": 1 },
            "postgres": { "type": "string", "minLength": 1 },
            "sqlite": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "outcome": {
      "oneOf": [
        { "type": "object", "required": ["value"], "additionalProperties": false, "properties": { "value": { "$ref": "#/$defs/value" } } },
        { "type": "object", "required": ["error"], "additionalProperties": false, "properties": { "error": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } } }
      ]
    },
    "expect": {
      "description": "The outcome of each database: exactly mysql, postgres and sqlite, or exactly none; the root selects which.",
      "oneOf": [
        {
          "type": "object",
          "required": ["mysql", "postgres", "sqlite"],
          "additionalProperties": false,
          "properties": {
            "mysql": { "$ref": "#/$defs/outcome" },
            "postgres": { "$ref": "#/$defs/outcome" },
            "sqlite": { "$ref": "#/$defs/outcome" }
          }
        },
        { "type": "object", "required": ["none"], "additionalProperties": false, "properties": { "none": { "$ref": "#/$defs/outcome" } } }
      ]
    },
    "step": {
      "type": "object",
      "required": ["op"],
      "properties": { "op": { "enum": ["dsn.connect", "model.connect", "codec.decode", "codec.encode", "codec.host_encode", "codec.host_decode", "codec.blind_index", "sql.exec", "ir.validate", "ir.answer", "catalog.current_namespace", "catalog.describe_table", "catalog.table_page", "catalog.read_only_query", "catalog.read_only_grid_query", "catalog.row_snapshot", "catalog.insert_row", "catalog.update_row", "catalog.delete_row", "schema.install", "schema.register", "schema.connect", "schema.add_tables_and_columns", "statements.count", "transaction", "model.create", "model.creates", "model.save", "model.duplicate_create", "model.update", "model.arithmetic", "model.delete", "model.count", "model.get_by", "model.query"] } },
      "oneOf": [
        { "$ref": "#/$defs/ops/dsn.connect" },
        { "$ref": "#/$defs/ops/model.connect" },
        { "$ref": "#/$defs/ops/codec.decode" },
        { "$ref": "#/$defs/ops/codec.encode" },
        { "$ref": "#/$defs/ops/codec.host_encode" },
        { "$ref": "#/$defs/ops/codec.host_decode" },
        { "$ref": "#/$defs/ops/codec.blind_index" },
        { "$ref": "#/$defs/ops/sql.exec" }, { "$ref": "#/$defs/ops/ir.validate" }, { "$ref": "#/$defs/ops/ir.answer" },
        { "$ref": "#/$defs/ops/catalog.current_namespace" },
        { "$ref": "#/$defs/ops/catalog.describe_table" },
        { "$ref": "#/$defs/ops/catalog.table_page" },
        { "$ref": "#/$defs/ops/catalog.read_only_query" },
        { "$ref": "#/$defs/ops/catalog.read_only_grid_query" },
        { "$ref": "#/$defs/ops/catalog.row_snapshot" },
        { "$ref": "#/$defs/ops/catalog.insert_row" },
        { "$ref": "#/$defs/ops/catalog.update_row" },
        { "$ref": "#/$defs/ops/catalog.delete_row" },
        { "$ref": "#/$defs/ops/schema.install" },
        { "$ref": "#/$defs/ops/schema.register" },
        { "$ref": "#/$defs/ops/schema.connect" },
        { "$ref": "#/$defs/ops/schema.add_tables_and_columns" },
        { "$ref": "#/$defs/ops/statements.count" },
        { "$ref": "#/$defs/ops/transaction" },
        { "$ref": "#/$defs/ops/model.create" },
        { "$ref": "#/$defs/ops/model.creates" },
        { "$ref": "#/$defs/ops/model.save" },
        { "$ref": "#/$defs/ops/model.duplicate_create" },
        { "$ref": "#/$defs/ops/model.update" },
        { "$ref": "#/$defs/ops/model.arithmetic" },
        { "$ref": "#/$defs/ops/model.delete" },
        { "$ref": "#/$defs/ops/model.count" },
        { "$ref": "#/$defs/ops/model.get_by" },
        { "$ref": "#/$defs/ops/model.query" }
      ]
    },
    "stepList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "schemaArgument": {
      "type": "object",
      "required": ["documents"],
      "additionalProperties": false,
      "properties": {
        "documents": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\.dbs$" } },
        "external": { "type": "array", "items": { "type": "string", "pattern": "\\.dbs$" } },
        "manifest_replace": { "type": "object", "required": ["from", "to"], "additionalProperties": false, "properties": { "from": { "type": "string", "minLength": 1 }, "to": { "type": "string" } } }
      }
    },
    "ops": {
      "schema.install": { "type": "object", "required": ["op", "schema", "expect"], "additionalProperties": false, "properties": { "op": { "const": "schema.install" }, "schema": { "$ref": "#/$defs/schemaArgument" }, "expect": { "$ref": "#/$defs/expect" } } },
      "schema.register": { "type": "object", "required": ["op", "schema", "expect"], "additionalProperties": false, "properties": { "op": { "const": "schema.register" }, "schema": { "$ref": "#/$defs/schemaArgument" }, "expect": { "$ref": "#/$defs/expect" } } },
      "schema.connect": { "type": "object", "required": ["op", "schema", "expect"], "additionalProperties": false, "properties": { "op": { "const": "schema.connect" }, "schema": { "$ref": "#/$defs/schemaArgument" }, "expect": { "$ref": "#/$defs/expect" } } },
      "schema.add_tables_and_columns": { "type": "object", "required": ["op", "schema", "expect"], "additionalProperties": false, "properties": { "op": { "const": "schema.add_tables_and_columns" }, "schema": { "$ref": "#/$defs/schemaArgument" }, "expect": { "$ref": "#/$defs/expect" } } },
      "statements.count": { "type": "object", "required": ["op", "steps", "expect"], "additionalProperties": false, "properties": { "op": { "const": "statements.count" }, "steps": { "$ref": "#/$defs/stepList" }, "expect": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/outcomes/count" } } } },
      "transaction": { "type": "object", "required": ["op", "steps", "expect"], "additionalProperties": false, "properties": { "op": { "const": "transaction" }, "steps": { "$ref": "#/$defs/stepList" }, "expect": { "$ref": "#/$defs/expect" } } },
      "dsn.connect": {
        "type": "object",
        "required": ["op", "dsn", "expect"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "dsn.connect" },
          "dsn": { "type": "string", "minLength": 1, "description": "The DSN of the case database for case, otherwise the DSN text of the step (FCV-4)." },
          "expect": { "$ref": "#/$defs/expect" }
        }
      },
      "model.connect": {
        "type": "object",
        "required": ["op", "pool_size", "as"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "model.connect" },
          "pool_size": { "type": "integer", "minimum": 1 },
          "as": { "$ref": "#/$defs/name" }
        }
      },
      "codec.decode": {
        "type": "object",
        "required": ["op", "styles", "raw", "expect"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "codec.decode" },
          "styles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "raw": { "$ref": "#/$defs/argument" },
          "as": { "$ref": "#/$defs/name" },
          "expect": { "$ref": "#/$defs/expect" }
        }
      },
      "codec.encode": {
        "type": "object",
        "required": ["op", "styles", "value"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "codec.encode" },
          "styles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "value": { "$ref": "#/$defs/encodeArgument" },
          "as": { "$ref": "#/$defs/name" },
          "expect": { "$ref": "#/$defs/expect" }
        },
        "anyOf": [{ "properties": { "as": true }, "required": ["as"] }, { "properties": { "expect": true }, "required": ["expect"] }]
      },
      "codec.host_encode": {
        "type": "object",
        "required": ["op", "styles", "value", "key"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "codec.host_encode" },
          "styles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "value": { "$ref": "#/$defs/argument" },
          "key": { "type": "string" },
          "as": { "$ref": "#/$defs/name" },
          "expect": { "$ref": "#/$defs/expect" }
        },
        "anyOf": [{ "properties": { "as": true }, "required": ["as"] }, { "properties": { "expect": true }, "required": ["expect"] }]
      },
      "codec.host_decode": {
        "type": "object",
        "required": ["op", "styles", "raw", "key", "expect"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "codec.host_decode" },
          "styles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "raw": { "$ref": "#/$defs/argument" },
          "key": { "type": "string" },
          "as": { "$ref": "#/$defs/name" },
          "expect": { "$ref": "#/$defs/expect" }
        }
      },
      "codec.blind_index": {
        "type": "object",
        "required": ["op", "value", "key", "expect"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "codec.blind_index" },
          "value": { "$ref": "#/$defs/argument" },
          "key": { "type": "string" },
          "expect": { "$ref": "#/$defs/expect" }
        }
      },
      "ir.validate": {
        "type": "object",
        "required": ["op", "request", "expect"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "ir.validate" },
          "request": { "type": "object", "description": "A request of the protocol (docs/spec/protocol.md) without manifest_hash; the step adds the hash of the schema named by the schema key of the recipe." },
          "expect": { "$ref": "#/$defs/expect" }
        }
      },
      "ir.answer": {
        "type": "object",
        "required": ["op", "chain", "expect"],
        "oneOf": [{ "required": ["answer"], "properties": { "answer": {} } }, { "required": ["answers"], "properties": { "answers": {} } }],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "ir.answer" },
          "chain": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$", "description": "The case of tests/markdown/cases.json that the chain runs (tests/markdown/README.md)." },
          "answer": { "description": "The answer of the chain's one request, as the case gives it (docs/spec/protocol.md section 5, Read)." },
          "answers": { "type": "object", "description": "The answers of a transaction chain keyed by the op of each control message and the kind of each request." },
          "expect": {
            "type": "object",
            "required": ["none"],
            "additionalProperties": false,
            "properties": {
              "none": {
                "type": "object",
                "required": ["value"],
                "additionalProperties": false,
                "properties": { "value": { "description": "The result of the chain in the plain JSON form of tests/markdown/README.md, a row, a list, a count, a value or {error, runs}." } }
              }
            }
          }
        }
      },
      "sql.exec": {
        "type": "object",
        "required": ["op", "sql", "reason"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "sql.exec" },
          "sql": { "$ref": "#/$defs/sql" },
          "reason": { "type": "string", "minLength": 1 }
        }
      },
      "catalog.current_namespace": {
        "type": "object",
        "required": ["op", "expect"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "catalog.current_namespace" },
          "as": { "$ref": "#/$defs/name" },
          "expect": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/outcomes/value" } }
        }
      },
      "catalog.describe_table": {
        "type": "object",
        "required": ["op", "table"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "catalog.describe_table" },
          "table": { "$ref": "#/$defs/name" },
          "as": { "$ref": "#/$defs/name" },
          "expect": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/outcomes/table" } }
        }
      },
      "catalog.table_page": {
        "type": "object",
        "required": ["op", "table", "limit", "offset", "columns"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "catalog.table_page" },
          "table": { "$ref": "#/$defs/name" },
          "limit": { "type": "integer" },
          "offset": { "type": "integer" },
          "columns": { "type": "array", "items": { "$ref": "#/$defs/name" } },
          "as": { "$ref": "#/$defs/name" },
          "expect": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/outcomes/page" } }
        }
      },
      "catalog.read_only_query": {
        "type": "object",
        "required": ["op", "sql", "expect"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "catalog.read_only_query" },
          "sql": { "$ref": "#/$defs/sql" },
          "max_rows": { "type": "integer" },
          "max_bytes": { "type": "integer" },
          "expect": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/outcomes/rows" } }
        }
      },
      "catalog.read_only_grid_query": {
        "type": "object",
        "required": ["op", "sql", "expect"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "catalog.read_only_grid_query" },
          "sql": { "$ref": "#/$defs/sql" },
          "max_rows": { "type": "integer" },
          "max_bytes": { "type": "integer" },
          "expect": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/outcomes/grid" } }
        }
      },
      "catalog.row_snapshot": {
        "type": "object",
        "required": ["op", "page", "index", "as"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "catalog.row_snapshot" },
          "page": { "$ref": "#/$defs/ref" },
          "index": { "type": "integer", "minimum": 0 },
          "as": { "$ref": "#/$defs/name" }
        }
      },
      "catalog.insert_row": {
        "type": "object",
        "required": ["op", "metadata", "values", "expect"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "catalog.insert_row" },
          "metadata": { "$ref": "#/$defs/ref" },
          "values": { "$ref": "#/$defs/assignments" },
          "expect": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/outcomes/rows" } }
        }
      },
      "catalog.update_row": {
        "type": "object",
        "required": ["op", "snapshot", "set", "expect"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "catalog.update_row" },
          "snapshot": { "$ref": "#/$defs/ref" },
          "set": { "$ref": "#/$defs/assignments" },
          "expect": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/outcomes/rows" } }
        }
      },
      "catalog.delete_row": {
        "type": "object",
        "required": ["op", "snapshot", "expect"],
        "additionalProperties": false,
        "properties": {
          "op": { "const": "catalog.delete_row" },
          "snapshot": { "$ref": "#/$defs/ref" },
          "expect": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/outcomes/value" } }
        }
