{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A conformance output as tests/interfaces/check reads it",
  "description": "The output of one language of a conformance run (<language>.json): each vector's result and the statement events it sent, with their kind and SQL. Other members are free.",
  "type": "object",
  "additionalProperties": {
    "anyOf": [
      {
        "type": "null"
      },
      {
        "type": "object",
        "properties": {
          "result": true,
          "statements": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "sql": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    ]
  }
}
