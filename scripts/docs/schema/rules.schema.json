{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contracts/rules.json",
  "description": "The rule registry: each rule with its id, the source it checks, the checker that runs it and the failure it reports; the writing-style rule also lists the forbidden expressions of each language.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": { "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "checker", "failure"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "checker": { "type": "string", "minLength": 1 },
          "failure": { "type": "string", "minLength": 1 },
          "forbidden_ko": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "forbidden_en": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
