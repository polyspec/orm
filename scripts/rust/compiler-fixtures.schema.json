{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "expect", "source"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "expect": { "enum": ["success", "error"] },
      "source": { "type": "string" },
      "code": { "type": "string", "minLength": 1 },
      "diagnostic": { "type": "string", "minLength": 1 },
      "sourceLine": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false,
    "allOf": [
      {
        "if": { "properties": { "expect": { "const": "error" } } },
        "then": { "required": ["code", "diagnostic", "sourceLine"] }
      }
    ]
  }
}
