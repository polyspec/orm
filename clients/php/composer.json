{
    "name": "orm/php-client",
    "description": "PHP executor of the orm compiler: generated typed builders over PDO, plans compiled by ormd",
    "type": "library",
    "version": "0.0.1",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "symfony/yaml": "^7.4",
        "google/protobuf": "^5.36"
    },
    "suggest": {
        "ext-pdo_pgsql": "Db::postgres (ormd -dialect postgres)",
        "ext-pdo_sqlite": "Db::sqlite (ormd -dialect sqlite)",
        "ext-openssl": "host-side AES on PostgreSQL and SQLite (aes columns)"
    },
    "autoload": {
        "psr-4": {
            "Orm\\Compiler\\V1\\": "src/Proto/Orm/Compiler/V1/",
            "GPBMetadata\\Proto\\Orm\\Compiler\\V1\\": "src/Proto/GPBMetadata/Proto/Orm/Compiler/V1/",
            "Orm\\": "src/"
        },
        "classmap": [
            "src/"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
