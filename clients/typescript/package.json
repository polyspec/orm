{
  "name": "@polyspec/orm-typescript",
  "version": "0.0.1",
  "description": "TypeScript ORM: model generator and native SQL assembly for MySQL, PostgreSQL, and SQLite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/polyspec/orm.git"
  },
  "keywords": [
    "orm",
    "mysql",
    "postgres",
    "sqlite"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "orm-gen": "./dist/bin/orm-gen.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run models && tsc -p tsconfig.build.json",
    "models": "node dist/bin/orm-gen.js gen --schema ../../schema/schema.json --out src/models --scan ../../tests/conformance/runner_typescript.mjs --scan tests --scan ../../tests/typescript"
  },
  "dependencies": {
    "mysql2": "^3.24.4",
    "ordered-json": "https://github.com/polyspec/ordered-json/archive/6d23a2a.tar.gz",
    "pg": "^8.23.0",
    "typescript": "^5.9.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1"
  }
}
