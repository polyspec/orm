erDiagram
  battle {
    bigint        seq                      PK  "auto"
    varchar(191)  name
    text          description                  "?"
    datetime(6)   created_ts                   "=now"
    datetime(6)   updated_ts                   "=now onupdate"
    tinyint       is_close                     "=0"
    tinyint       is_display                   "=0"
    datetime(6)   display_start_dt             "?"
    datetime(6)   display_end_dt               "?"
    tinyint       is_allday                    "=0"
    int           target_team_player_count     "=0 unsigned"
    int           success_count                "=0 unsigned"
    int           player_count                 "=0 unsigned"
    int           read_count                   "=0 unsigned"
    varchar(191)  cover_url                    "?"
    bigint        user_seq                 FK
    bigint        service_seq              FK
    bigint        service_module_seq       FK
    bigint        service_member_seq       FK
    datetime(6)   start_dt
    datetime(6)   end_dt
    varchar(36)   uuid                     UK  "?"
    tinyint       is_single_play               "=0"
    int           like_count                   "=0 unsigned"
    varchar(255)  aes_hex_email                "?"
    varchar(255)  aes_hex_phone                "?"
    decimal(13_3) price                        "?"
    varbinary(16) ip                           "?"
    blob          gz_extend                    "?"
    json          json_setting                 "?"
    text          jsons_tags                   "?"
    text          base64_extra                 "?"
    text          serialize_data               "?"
  }
  user {
    bigint        seq   PK "auto"
    varchar(191)  name
  }
  service {
    bigint        seq   PK "auto"
    varchar(191)  name
  }
  service_module {
    bigint        seq   PK "auto"
    bigint        service_seq FK
    varchar(191)  name
  }
  service_member {
    bigint        seq   PK "auto"
    bigint        service_seq FK
    bigint        user_seq    FK
  }

  user           ||--o{ battle         : user_seq
  service        ||--o{ battle         : service_seq
  service_module ||--o{ battle         : service_module_seq
  service_member ||--o{ battle         : service_member_seq
  service        ||--o{ service_module : service_seq
  service        ||--o{ service_member : service_seq
  user           ||--o{ service_member : user_seq

