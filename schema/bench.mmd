erDiagram
  author {
    bigint        seq                      PK  "auto"
    varchar(191)  name
    text          description                  "?"
    datetime(6)   created_ts                   "=now"
    datetime(6)   updated_ts                   "=now onupdate"
    tinyint       is_close                     "=0"
    tinyint       is_display                   "=0"
    datetime(6)   display_start_dt             "?"
    datetime(6)   display_end_dt               "?"
    tinyint       is_allday                    "=0"
    int           target_club_reader_count     "=0 unsigned"
    int           success_count                "=0 unsigned"
    int           reader_count                 "=0 unsigned"
    int           read_count                   "=0 unsigned"
    varchar(191)  photo_url                    "?"
    bigint        user_seq                 FK
    bigint        service_seq              FK
    bigint        service_region_seq       FK
    bigint        service_member_seq       FK
    datetime(6)   start_dt
    datetime(6)   end_dt
    varchar(36)   uuid                     UK  "?"
    tinyint       is_single_work               "=0"
    int           like_count                   "=0 unsigned"
    int           aes_key_version              "=1"
    varchar(255)  aes_hex_email                "?"
    char(64)      email_blind_index            "? lazy"
    varchar(255)  aes_hex_phone                "?"
    char(64)      phone_blind_index            "? lazy"
    decimal(13_3) price                        "?"
    varbinary(16) ip                           "?"
    blob          gz_extend                    "?"
    jsontext      json_setting                 "?"
    jsontext      jsons_tags                   "?"
    text          base64_extra                 "?"
    text          serialize_data               "?"
  }
  user {
    bigint        seq   PK "auto"
    varchar(191)  name
  }
  service {
    bigint        seq   PK "auto"
    varchar(191)  name
  }
  service_region {
    bigint        seq   PK "auto"
    bigint        service_seq FK
    varchar(191)  name
  }
  service_member {
    bigint        seq   PK "auto"
    bigint        service_seq FK
    bigint        user_seq    FK
  }
  composite_account {
    bigint        tenant_id PK
    bigint        account_id PK
    varchar(191)  name
  }
  composite_membership {
    bigint        tenant_id PK, FK
    bigint        account_id PK, FK
    varchar(191)  role
  }
  soft_record {
    bigint        seq PK "auto"
    varchar(191)  name
    datetime(6)   deleted_at "?"
  }
  account {
    bigint        seq PK "auto"
    varchar(191)  name
  }
  project {
    bigint        seq PK "auto"
    varchar(191)  name
  }
  account_project {
    bigint        account_seq PK, FK "-> account.seq"
    bigint        project_seq PK, FK "-> project.seq"
  }
  task {
    bigint        seq   PK "auto"
    varchar(191)  title
    enum(open_done) state
  }

  user           ||--o{ author         : user_seq
  service        ||--o{ author         : service_seq
  service_region ||--o{ author         : service_region_seq
  service_member ||--o{ author         : service_member_seq
  service        ||--o{ service_region : service_seq
  service        ||--o{ service_member : service_seq
  user           ||--o{ service_member : user_seq
  composite_account ||--o{ composite_membership : "(tenant_id, account_id) (account / memberships) cascade"

  %% index author (service_region_seq, is_close, is_display, is_allday) ik
