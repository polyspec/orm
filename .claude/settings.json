{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/var/tools/bin/node \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/polyspec-kit-hook"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/var/tools/bin/node \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/polyspec-kit-hook"
          }
        ]
      }
    ]
  }
}
