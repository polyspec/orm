{
  "name": "@polyspec/dbspec-language",
  "version": "0.0.18",
  "description": "The dbspec language service: diagnostics with ranges, tokens, folding and formatting of one document",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/cli/host.d.ts",
      "import": "./dist/cli/host.js"
    }
  },
  "bin": {
    "dbspec-fmt": "./bin/dbspec-fmt.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p src/cli/tsconfig.json"
  },
  "dependencies": {
    "@polyspec/orm": "0.0.18"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxc-parser": "0.154.0",
    "typescript": "7.0.2"
  }
}
