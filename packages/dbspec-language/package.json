{
  "name": "@polyspec/dbspec-language",
  "version": "0.0.0",
  "private": true,
  "description": "The dbspec language service: diagnostics with ranges, tokens, folding and formatting of one document",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/cli/host.d.ts",
      "import": "./dist/cli/host.js"
    }
  },
  "bin": {
    "dbspec-fmt": "./bin/dbspec-fmt.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json"
  },
  "dependencies": {
    "@polyspec/orm": "0.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
