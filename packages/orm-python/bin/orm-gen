#!/usr/bin/env python3
# orm-gen entry point: 설치되지 않은 checkout에서도 package를 찾는다.
import os
import sys

_SRC = os.path.join(os.path.dirname(os.path.abspath(__file__)), os.pardir, 'src')
if os.path.isdir(os.path.join(_SRC, 'polyspec', 'orm')):
    sys.path.insert(0, _SRC)

from polyspec.orm.bin_orm_gen import main

sys.exit(main())
