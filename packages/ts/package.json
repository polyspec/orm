{
  "name": "@polyspec/orm",
  "version": "0.0.18",
  "description": "TypeScript ORM: model generator and native SQL assembly for MySQL, PostgreSQL, and SQLite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/polyspec/orm.git"
  },
  "keywords": [
    "orm",
    "mysql",
    "postgres",
    "sqlite"
  ],
  "type": "module",
  "engines": {
    "node": ">=26.12.0"
  },
  "bin": {
    "orm-gen": "./dist/bin/orm-gen.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "orm-test": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      }
    },
    "./dbspec": {
      "types": "./dist/dbspec/entry.d.ts",
      "import": "./dist/dbspec/entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/typescript/build.mts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@polyspec/ordered-json": "0.0.9",
    "mysql2": "^3.24.6",
    "oxc-parser": "0.154.0",
    "pg": "^8.23.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "7.0.2"
  }
}
