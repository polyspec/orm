{
  "name": "@polyspec/dbspec-codemirror",
  "version": "0.0.17",
  "description": "CodeMirror 6 extension for dbspec documents: token classes, diagnostics, folding and formatting from @polyspec/dbspec-language",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26.11.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@polyspec/dbspec-language": "0.0.17"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14"
  },
  "devDependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "typescript": "7.0.2"
  }
}
