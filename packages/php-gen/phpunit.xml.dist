<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor-php/phpunit/phpunit/phpunit.xsd"
         bootstrap="../php/tests/bootstrap.php"
         recordTestRunHistory="false"
         colors="false">
    <testsuites>
        <testsuite name="polyspec/orm-gen">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
