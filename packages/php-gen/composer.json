{
    "name": "polyspec/orm-gen",
    "description": "PHP dbspec model generator and scanner CLI for polyspec/orm",
    "type": "library",
    "version": "0.0.18",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "composer-runtime-api": "^2.2",
        "polyspec/orm": "0.0.18",
        "nikic/php-parser": "^5.9.0"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Orm\\": "src/"
        }
    },
    "bin": [
        "bin/orm-gen"
    ],
    "config": {
        "optimize-autoloader": true
    }
}
