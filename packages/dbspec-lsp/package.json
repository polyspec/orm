{
  "name": "@polyspec/dbspec-lsp",
  "version": "0.0.17",
  "description": "The dbspec language server: diagnostics, semantic tokens, folding and formatting from @polyspec/dbspec-language over the Language Server Protocol",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dbspec-lsp": "./bin/dbspec-lsp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=26.11.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@polyspec/dbspec-language": "0.0.17",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-textdocument": "1.0.15"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vscode-jsonrpc": "9.0.3"
  }
}
