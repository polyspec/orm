{
    "name": "polyspec/orm",
    "description": "PHP client of the orm model syntax: generated models over PDO with SQL assembled in process",
    "type": "library",
    "version": "0.0.15",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "composer-runtime-api": "^2.2",
        "polyspec/ordered-json": "0.0.8",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "purrphp/yaml": "^1.0",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "13.4.2"
    },
    "suggest": {
        "ext-pdo_mysql": "mysql:// DSNs",
        "ext-pdo_pgsql": "postgres:// DSNs",
        "ext-pdo_sqlite": "sqlite:// DSNs",
        "ext-openssl": "host-side AES on PostgreSQL and SQLite (aes columns)",
        "ext-orm_dbspec": "Polyspec\\Orm\\Dbspec\\Native\\Dbspec, the dbspec surface of this client implemented in C (packages/php-ext)"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Orm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Orm\\Tests\\Model\\": "gen/",
            "Polyspec\\Orm\\Tests\\MarkdownModel\\": "markdownmodel/"
        },
        "files": [
            "gen/bootstrap.php"
        ]
    },
    "bin": [
        "bin/orm-gen"
    ],
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "polyspec/ordered-json",
                "version": "0.0.8",
                "type": "library",
                "require": {
                    "php": ">=8.2",
                    "ext-json": "*",
                    "ext-pcre": "*"
                },
                "suggest": {
                    "ext-ordered_json": "Native backend from the polyspec/ordered-json-extension PIE package"
                },
                "autoload": {
                    "files": [
                        "src/OrderedJson.php"
                    ]
                },
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/polyspec/ordered-json/releases/download/v0.0.8/polyspec-ordered-json-php-0.0.8.zip",
                    "shasum": "6fa67fff99b422f42ed7ab51ac470cadf8ade699"
                }
            }
        }
    ]
}
