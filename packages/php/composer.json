{
    "name": "polyspec/orm",
    "description": "PHP client of the orm model syntax: generated models over PDO with SQL assembled in process",
    "type": "library",
    "version": "0.0.18",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "composer-runtime-api": "^2.2",
        "polyspec/ordered-json": "0.0.9",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "nikic/php-parser": "^5.9.0",
        "purrphp/yaml": "1.0.0-p1",
        "symfony/yaml": "^8.1"
    },
    "suggest": {
        "ext-pdo_mysql": "mysql:// DSNs",
        "ext-pdo_pgsql": "postgres:// DSNs",
        "ext-pdo_sqlite": "sqlite:// DSNs",
        "ext-openssl": "host-side AES on PostgreSQL and SQLite (aes columns)",
        "ext-polyspec_orm": "the dbspec surface and the error codes of this client implemented in C under the same class names (packages/php-ext)"
    },
    "autoload": {
        "psr-4": {
            "Polyspec\\Orm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Orm\\Tests\\Model\\": "gen/",
            "Polyspec\\Orm\\Tests\\MarkdownModel\\": "markdownmodel/"
        }
    },
    "bin": [
        "bin/orm-gen"
    ],
    "config": {
        "optimize-autoloader": true
    }
}
