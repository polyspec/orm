/bin/
/dist/
/packages/ts/dist/
# The models that orm-gen writes into packages/ts/src/models at each TypeScript build (P34: generated output is never tracked).
/packages/ts/src/models/
/packages/dbspec-language/dist/
/packages/dbspec-codemirror/dist/
/packages/dbspec-lsp/dist/
/packages/dbspec-vscode/dist/
*.vsix
# The build cache that tsc writes beside a tsconfig at any depth (tsBuildInfoFile): generated output that a build rewrites, never tracked (P34).
*.tsbuildinfo
/target/
/benchmarks/rust/target/
/packages/rust/target/
*.test
/docs/perf-raw/
/packages/rust/testing/interfaces/target/

/node_modules/
/packages/*/node_modules/
/packages/ts/testing/interfaces/typescript/node_modules/
/tests/interfaces/typescript/node_modules/
/vendor-php/
/packages/php/vendor/
/packages/php-ext/vendor/
# The environment that mise installs beside the lock of a pypi tool.
/.mise/locks/*/*/.venv/
/docs/.vitepress/cache/
/docs/.vitepress/dist/
/docs/.vitepress/.temp/
/.runtime/
/packages/python/.venv/
# The build tree and the metadata that the setuptools build of uv sync writes beside the source (make orm-install-python).
/packages/python/build/
/packages/python/src/*.egg-info/
# The models that orm-gen writes at each orm-install-python (make python-models; P34: generated output is never tracked).
/packages/python/src/polyspec/orm/models/models.py
__pycache__/
*.pyc
/var/
/vendor/
venv/
*.egg-info/

# The go.work of each Go module that kit link writes for the local links (K205).
go.work
go.work.sum

# The binary that go build writes beside a command of packages/go/cmd (P34: build output is never tracked).
/packages/go/cmd/*/*
!/packages/go/cmd/*/*.go

# The Go models that orm-gen writes at each orm-install-go (make go-models; P34: generated output is never tracked). The tests of
# these packages are hand-written and stay tracked.
/packages/go/model/*.go
!/packages/go/model/*_test.go
/packages/go/complexmodel/
/packages/go/markdownmodel/*.go
!/packages/go/markdownmodel/*_test.go
/packages/go/decimalmodel/*.go
!/packages/go/decimalmodel/*_test.go
# The PHP models that orm-gen writes at each orm-install-php (make php-models; P34: generated output is never tracked). Every file of
# these directories is generated.
/packages/php/gen/
/packages/php/markdownmodel/
/packages/php/complexmodel/
/packages/php/src/native/bin/
# The arginfo header and the copy of the SQLite cancel callback of the PHP extension are build output (make php-ext-release-sources).
/packages/php-ext/src/polyspec_orm_arginfo.h
/packages/php-ext/src/native/sqlite_cancel.c
# The error code constants of TypeScript, PHP and Python are build output (make orm-codes).
/packages/ts/src/codes.ts
/packages/php/src/Code.php
/packages/python/src/polyspec/orm/codes.py
# The link declaration of the development links (kit K869); make link reads it.
/.links
# The cache of ruff, which make lint-python writes at the root of the checkout
/.ruff_cache/
