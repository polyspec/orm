{
  "schema": 1,
  "include": [
    "**/*.md"
  ],
  "exclude": [
    "docs/.vitepress/**",
    "**/node_modules/**",
    "**/vendor/**"
  ],
  "siteLinks": true,
  "changelogs": [
    "CHANGELOG.md"
  ],
  "changelogRules": [
    "unreleased-first",
    "unreleased-once",
    "versions-only",
    "newest-first",
    "unreleased-empty-at-release"
  ]
}
