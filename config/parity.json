{
  "schema": 1,
  "comment": "The implementations of orm, the one source of its language set, and the shared vector suites and the error catalog that each of them holds, as the tree stands. The parity tool of @polyspec/kit reads it (make parity-declarations-check, make parity-check; docs/tool-inventory of kit, Language parity). A missing binding stays missing so that the check reports it.",
  "implementations": [
    {
      "name": "go",
      "runner": "go",
      "roots": ["packages/go", "tests/interfaces/contracts"],
      "tests": ["packages/go/**/coverage_*_test.go"],
      "args": ["-tags", "physical,ormtest,markdown"],
      "errors": { "file": "packages/go/orm/codes.go", "pattern": "^\\tCode\\w+\\s+= \"(\\w+)\"" }
    },
    {
      "name": "php",
      "runner": "php",
      "roots": ["packages/php"],
      "tests": ["packages/php/tests/Coverage*Test.php"],
      "errors": { "file": "packages/php/src/Code.php", "pattern": "^    public const (\\w+) = '\\w+';$" }
    },
    {
      "name": "php-extension",
      "runner": "php",
      "roots": ["packages/php-ext"],
      "tests": ["packages/php-ext/tests/Coverage*Test.php"],
      "args": ["-d", "extension=.runtime/parity/php-extension/orm_dbspec.so"]
    },
    {
      "name": "typescript",
      "runner": "node",
      "roots": ["packages/ts"],
      "tests": ["packages/ts/tests/coverage_*.mjs"],
      "args": ["--conditions=orm-test"]
    },
    {
      "name": "python",
      "runner": "python",
      "roots": ["packages/python"],
      "tests": ["packages/python/tests/coverage_*.py"],
      "command": "packages/python/.venv/bin/python",
      "env": []
    },
    {
      "name": "rust",
      "runner": "cargo",
      "roots": ["packages/rust"],
      "tests": ["packages/rust/**/tests/**/coverage_*.rs"],
      "errors": { "file": "packages/rust/orm/src/codes.rs", "pattern": "^pub const (\\w+): &str = \"\\w+\";$" }
    }
  ],
  "profiles": [
    { "name": "dbspec", "implementations": ["go", "php", "php-extension", "typescript", "python", "rust"] },
    {
      "name": "client",
      "implementations": ["go", "php", "typescript", "python", "rust"],
      "reason": "The PHP extension orm_dbspec implements only the dbspec surface of the PHP client (Polyspec\\Orm\\Dbspec\\Native): it has no query client, codec, DSN, statement events or error codes.",
      "spec": ["contracts/interfaces.json#/extensions/php-extension/description"]
    }
  ],
  "suites": [
    "contracts/fixtures/**/*.json",
    "tests/codec/*.json",
    "tests/conformance/*.json",
    "tests/dbspec/*.json",
    "tests/dsn/*.json",
    "tests/ir/*.json",
    "tests/events/*.json",
    "tests/markdown/*.json"
  ],
  "comparators": ["tests/conformance/check", "tests/interfaces/check"],
  "testPatterns": [
    { "runner": "go", "globs": ["packages/**/*_test.go", "tests/**/*_test.go", "examples/**/*_test.go"] },
    { "runner": "cargo", "globs": ["packages/**/tests/**/*.rs", "tests/**/*.rs"] },
    { "runner": "node", "globs": ["packages/ts/tests/**/*.mjs", "tests/*/**/*.mjs"] },
    { "runner": "php", "globs": ["packages/php/tests/**/*.php", "packages/php-ext/tests/**/*.php", "tests/**/*.php"] },
    { "runner": "python", "globs": ["packages/python/tests/**/*.py", "tests/**/*.py"] }
  ],
