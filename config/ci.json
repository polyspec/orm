{
  "schema": 1,
  "comment": "Kit API checks keep complete preparation. Each binding job declares only its runtime tools and setup, including shared database fixtures; repository Make targets own all build and install dependencies.",
  "parityMode": "phases",
  "setup": {
    "shared": [
      "orm-install-go-lease",
      "orm-install-go-codes"
    ],
    "parity": [
      "orm-install-flowmark",
      "orm-install-interfaces-typescript"
    ],
    "runtimes": {
      "go": [
        "orm-install-go"
      ],
      "php": [
        "orm-install-php"
      ],
      "php-ext": [
        "orm-install-php-extension-runtime",
        "orm-install-server-programs",
        "orm-install-go-lease",
        "orm-install-flowmark"
      ],
      "python": [
        "orm-install-python"
      ],
      "rust": [],
      "ts": [
        "orm-install-interfaces-typescript",
        "orm-install-typescript-runtime"
      ]
    }
  },
  "tools": {
    "parity": [
      "go"
    ],
    "php": [
      "go"
    ],
    "php-ext": [
      "go"
    ],
    "python": [
      "go"
    ],
    "ts": [
      "go"
    ]
  },
  "contexts": {
    "parity": {
      "prepare": "parity-context-prepare",
      "cleanup": "parity-context-cleanup"
    },
    "php-ext": {
      "prepare": "php-extension-context-prepare",
      "cleanup": "php-extension-context-cleanup"
    }
  },
  "runner": "ubuntu-26.04-arm",
  "parityBindings": {
    "go": {
      "setup": [
        "orm-install-parity-go"
      ],
      "tools": [
        "go"
      ]
    },
    "php": {
      "setup": [
        "orm-install-parity-php"
      ],
      "tools": [
        "go",
        "php",
        "composer"
      ]
    },
    "php-extension": {
      "setup": [
        "orm-install-parity-php-extension"
      ],
      "tools": [
        "go",
        "php",
        "composer"
      ]
    },
    "typescript": {
      "setup": [
        "orm-install-parity-common"
      ],
      "tools": [
        "go"
      ]
    },
    "python": {
      "setup": [
        "orm-install-parity-python"
      ],
      "tools": [
        "go",
        "python",
        "uv"
      ]
    },
    "rust": {
      "setup": [
        "orm-install-parity-rust"
      ],
      "tools": [
        "go",
        "rust"
      ]
    }
  }
}
