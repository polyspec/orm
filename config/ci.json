{
  "schema": 1,
  "runtimes": ["go", "php", "php-ext", "python", "rust", "ts"],
  "comment": "Kit gates install each runtime from its pinned lock; the php-ext job prepares its database servers and run-owned fixtures in an isolated job context.",
  "setup": {
    "shared": [
      "orm-install-go-lease",
      "orm-install-go-codes"
    ],
    "runtimes": {
      "go": [
        "orm-install-go"
      ],
      "php": [
        "orm-install-php"
      ],
      "php-ext": [
        "orm-install-php-extension-runtime",
        "orm-install-server-programs",
        "orm-install-go-lease",
        "orm-install-flowmark"
      ],
      "python": [
        "orm-install-python"
      ],
      "rust": [],
      "ts": [
        "orm-install-interfaces-typescript",
        "orm-install-typescript-runtime"
      ]
    }
  },
  "tools": {
    "php": [
      "go"
    ],
    "php-ext": [
      "go"
    ],
    "python": [
      "go"
    ],
    "ts": [
      "go"
    ]
  },
  "contexts": {
    "php-ext": {
      "prepare": "php-extension-context-prepare",
      "cleanup": "php-extension-context-cleanup"
    }
  },
  "runner": "ubuntu-26.04-arm"
}
