// The base API Extractor configuration of every polyspec TypeScript package, copied by kit; change it in kit, never in a
// copy. The api-extractor.json of a package extends it and names its mainEntryPointFilePath; make lint-ts runs API Extractor
// on each such package, after its build wrote the .d.ts. The API report is enabled because ae-undocumented fires only through
// it: without the report an undocumented export passes in silence. addToApiReportFile false makes ae-undocumented and
// ae-forgotten-export errors instead of lines of the report. The report of a package (etc/<package>.api.md) is committed, so
// a change of the public API fails until the report shows it. ae-missing-release-tag is off: release tags (@public, @beta,
// @alpha, @internal) choose what the trimmed .d.ts rollups of a package keep, and polyspec writes no rollup (dtsRollup is
// off) and tags no export, so the message only asked every export for a tag that changes nothing (K139).
{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/var/api-extractor/"
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "extractorMessageReporting": {
      "ae-undocumented": {
        "logLevel": "error",
        "addToApiReportFile": false
      },
      "ae-forgotten-export": {
        "logLevel": "error",
        "addToApiReportFile": false
      },
      "ae-missing-release-tag": {
        "logLevel": "none"
      }
    }
  }
}
