{
  "comment": "Each make target of CHECK_TARGETS declares its scope. An owner target is a per-file check (format, checklist, documents, the unit tests of a checker): make owner-check runs it when a changed path matches its inputs. A suite target is part of the full suite only: make check runs it once, and make owner-check never selects it; a changed feature's own verification and coverage run in its place. make owner-check and make repo-check fail on a target without a scope, an owner target without inputs, a suite target with inputs, and an input pattern that matches no tracked file. A pattern matches a repository path: * within one path segment, ** across segments.",
  "targets": {
    "checklist-check": {"scope": "owner", "inputs": ["docs/checklist.md", "docs/checklist.ko.md", "scripts/checklist/**"]},
    "version-check": {"scope": "owner", "inputs": ["VERSION", "scripts/version/**", "**/Cargo.toml", "**/Cargo.lock", "clients/php/composer.json", "clients/typescript/package.json", "clients/typescript/package-lock.json", "contracts/features.json", "**/*.md"]},
    "testcase-check": {"scope": "owner", "inputs": ["internal/testcase/**", "tests/testcase.mjs", "tests/testcase.test.mjs", "tests/go-test.mjs", "tests/go-test.test.mjs", "tests/run-long.mjs", "tests/testcase.php", "tests/testcase_test.php", "clients/rust/testcase/**"]},
    "repo-check": {"scope": "owner", "inputs": ["**"]},
    "test-servers-check": {"scope": "owner", "inputs": ["scripts/test-servers.sh", "scripts/test-servers.test.mjs", "scripts/test-servers-mysql.mjs", "scripts/test-servers-mysql.test.mjs", "tests/stop-process/**", "tests/lease/**", "internal/procevent/**", "tests/testcase.mjs"]},
    "git-check": {"scope": "owner", "inputs": ["scripts/git/**", "contracts/rules.json"]},
    "docs-rules-check": {"scope": "owner", "inputs": ["**/*.md", "contracts/rules.json", "scripts/docs/**"]},
    "docs-check": {"scope": "owner", "inputs": ["docs/**", "scripts/docs/**", "contracts/interfaces.json", "package.json", "package-lock.json"]},
    "docs-verify-idempotent": {"scope": "owner", "inputs": ["docs/**", "scripts/docs/**", "contracts/interfaces.json", "package.json", "package-lock.json"]},
    "go-model-check": {"scope": "suite"},
    "client-unit-check": {"scope": "suite"},
    "php-min-check": {"scope": "suite"},
    "ts-check": {"scope": "suite"},
    "ts-min-check": {"scope": "suite"},
    "rust-check": {"scope": "suite"},
    "go-fmt-check": {"scope": "owner", "inputs": ["**/*.go"]},
    "go-vet-check": {"scope": "owner", "inputs": ["**/*.go", "go.mod", "go.sum"]},
    "rust-fmt-check": {"scope": "owner", "inputs": ["clients/rust/**/*.rs"]},
    "rust-150-check": {"scope": "suite"},
    "rust-driver-check": {"scope": "suite"},
    "example-check": {"scope": "suite"},
    "client-db-check": {"scope": "suite"},
    "codec-check": {"scope": "suite"},
    "client-pooler-check": {"scope": "suite"},
    "case-database-check": {"scope": "suite"},
    "dialect-facts-check": {"scope": "suite"},
    "conformance-check": {"scope": "suite"},
    "package-check": {"scope": "suite"},
    "dbspec-ddl-check": {"scope": "suite"},
    "dbspec-introspect-check": {"scope": "suite"},
    "dbspec-introspect-ts-check": {"scope": "suite"},
    "dbspec-introspect-php-check": {"scope": "suite"},
    "dbspec-introspect-rust-check": {"scope": "suite"},
    "dbspec-introspect-compare-check": {"scope": "suite"},
    "dbspec-plan-check": {"scope": "suite"},
    "dbspec-apply-check": {"scope": "suite"},
    "dbspec-plan-ts-check": {"scope": "suite"},
    "dbspec-plan-rust-check": {"scope": "suite"},
    "ts-model-check": {"scope": "suite"},
    "dbspec-plan-php-check": {"scope": "suite"},
    "dbspec-apply-php-check": {"scope": "suite"},
    "dbspec-apply-rust-check": {"scope": "suite"},
    "dbspec-apply-ts-check": {"scope": "suite"},
    "dbspec-apply-pairs-check": {"scope": "suite"},
    "feature-unit-check": {"scope": "owner", "inputs": ["scripts/features/**", "contracts/features.json", "contracts/check-inputs.json", "docs/features.md", "docs/features.ko.md", "tests/testcase.mjs", "Makefile"]},
    "feature-check": {"scope": "suite"},
    "go-test-check": {"scope": "suite"}
  }
}
