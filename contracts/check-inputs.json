    "client-pooler-check": {"scope": "suite", "needs": ["databases"]},
    "case-database-check": {"scope": "suite", "needs": ["databases"]},
    "dialect-facts-check": {"scope": "owner", "needs": ["databases"], "inputs": ["tests/dialects/probe.go", "tests/dialects/probe_test.go", "tests/dialects/probes_*.go", "tests/dialects/facts_physical_test.go", "tests/dialects/sqlite_filename_physical_test.go", "tests/dialects/servers.go"]},
