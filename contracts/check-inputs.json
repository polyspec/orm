    "ts-model-check": {"scope": "owner", "needs": [], "inputs": ["clients/typescript/tests/models-scan.mjs", "clients/typescript/tsconfig.build.json"]},
    "dbspec-plan-php-check": {"scope": "owner", "needs": ["databases"], "inputs": ["clients/php/tests/dbspec_plan_apply_test.php"]},
    "dbspec-apply-php-check": {"scope": "owner", "needs": ["databases"], "inputs": ["clients/php/tests/dbspec_apply_test.php"]},
    "dbspec-apply-rust-check": {"scope": "owner", "needs": ["databases"], "inputs": ["clients/rust/orm/tests/dbspec_apply.rs"]},
    "dbspec-apply-ts-check": {"scope": "owner", "needs": ["databases"], "inputs": ["clients/typescript/tests/dbspec-apply-physical.mjs"]},
    "dbspec-apply-pairs-check": {"scope": "owner", "needs": ["databases"], "inputs": ["tests/dialects/apply_clients_physical_test.go", "clients/rust/orm/examples/dbspec_apply.rs", "tests/dbspec/apply/**"]},
    "feature-unit-check": {"scope": "owner", "needs": [], "inputs": ["scripts/features/**", "contracts/features.json", "contracts/check-inputs.json", "docs/features.md", "docs/features.ko.md", "tests/testcase.mjs", "Makefile"]},
    "feature-check": {"scope": "suite", "needs": ["databases"]},
    "go-test-check": {"scope": "suite", "needs": ["databases"]}
  },
  "paths": {
    ".github/runner": {"scope": "suite", "reason": "it names the runner image of every job of the CI workflow, so it changes the machine that runs every target"},
    ".github/workflows/ci.yml": {"scope": "suite", "reason": "it defines the CI job that installs the toolchains and runs make check, so it changes how every target runs in CI"},
    ".github/workflows/docs-pages.yml": {"scope": "suite", "reason": "it builds and publishes the documentation site from every document on each push, so it changes the publication of every page"},
    ".gitignore": {"scope": "lint", "reason": "it only decides which files git ignores; no test reads it, and owner-check and make check list changed files through git"},
    ".node-version": {"scope": "suite", "reason": "it selects the Node release of every check, locally and in CI, so it changes the runtime of every Node and TypeScript target"},
    ".php-version": {"scope": "suite", "reason": "it selects the PHP release of every check, locally and in CI, so it changes the runtime of every PHP target"},
    "LICENSE": {"scope": "lint", "reason": "license text; no code or test reads it"},
    "clients/php/composer.lock": {"scope": "suite", "reason": "it pins the PHP dependencies that every PHP check loads through the autoloader"},
    "clients/rust/rustfmt.toml": {"scope": "lint", "reason": "it configures rustfmt, which rust-fmt-check runs over every Rust file"},
    "go.mod": {"scope": "suite", "reason": "it pins the Go toolchain and the modules of every Go build and test"},
    "go.sum": {"scope": "suite", "reason": "it pins the module checksums of every Go build and test"},
    "rust-toolchain.toml": {"scope": "suite", "reason": "it selects the Rust toolchain of every Rust build and test, locally and in CI"},
    "internal/testdb/testdb.go": {"scope": "suite", "reason": "every Go database test opens its database through it, so it changes the setup of every Go database target"},
    "clients/rust/case-clock/src/lib.rs": {"scope": "suite", "reason": "every Rust test that checks the database clock takes its case clock from it"},
    "clients/rust/case-database/src/lib.rs": {"scope": "suite", "reason": "every Rust database test creates and drops its case database through it"},
    "scripts/cargo-build-copy.sh": {"scope": "suite", "reason": "every make target that runs a Rust program builds and copies that program through it (CARGO_COPY)"}
  }
}
