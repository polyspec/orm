{
  "comment": "Each make target of CHECK_TARGETS declares its scope and the setup steps it needs: needs [\"databases\"] is a target that reads the servers of make test-servers and the bench and decimal databases of the run, which the runner records as not-run, with the failed step and its first failure lines, when the setup step servers or databases/create fails; needs [] runs whatever the setup steps did. An owner target is a per-file check (format, checklist, documents, the unit tests of a checker): make owner-check runs it when a changed path matches its inputs. A suite target is part of the full suite only: make check runs it once, and make owner-check never selects it; a changed feature's own verification and coverage run in its place. make owner-check and make repo-check fail on a target without a scope, an owner target without inputs, a suite target with inputs, and an input pattern that matches no tracked file. A pattern matches a repository path: * within one path segment, ** across segments.",
  "targets": {
    "checklist-check": {"scope": "owner", "needs": [], "inputs": ["docs/checklist.md", "docs/checklist.ko.md", "scripts/checklist/**"]},
    "full-run-check": {"scope": "owner", "needs": [], "inputs": ["scripts/check/**", "scripts/features/owners.mjs", "scripts/client-db-test.sh", "scripts/typescript/sqlite-test.sh", "Makefile", "tests/testcase.mjs"]},
    "version-check": {"scope": "owner", "needs": [], "inputs": ["VERSION", "scripts/version/**", "**/Cargo.toml", "**/Cargo.lock", "clients/php/composer.json", "clients/typescript/package.json", "clients/typescript/package-lock.json", "contracts/features.json", "**/*.md"]},
    "testcase-check": {"scope": "owner", "needs": [], "inputs": ["internal/testcase/**", "tests/testcase.mjs", "tests/testcase.test.mjs", "tests/go-test.mjs", "tests/go-test.test.mjs", "tests/cargo-test.mjs", "tests/cargo-test.test.mjs", "tests/run-long.mjs", "tests/testcase.php", "tests/testcase_test.php", "clients/rust/testcase/**"]},
    "repo-check": {"scope": "owner", "needs": [], "inputs": ["scripts/repo/**"], "lints": ["**"]},
    "test-servers-check": {"scope": "owner", "needs": [], "inputs": ["scripts/test-servers.sh", "scripts/test-servers.test.mjs", "scripts/test-servers-mysql.mjs", "scripts/test-servers-mysql.test.mjs", "tests/stop-process/**", "tests/lease/**", "internal/procevent/**", "tests/testcase.mjs"]},
    "git-check": {"scope": "owner", "needs": [], "inputs": ["scripts/git/**", "contracts/rules.json", ".githooks/**", "Makefile"]},
    "docs-rules-check": {"scope": "owner", "needs": [], "inputs": ["contracts/rules.json", "scripts/docs/**"], "lints": ["**/*.md"]},
    "docs-check": {"scope": "owner", "needs": [], "inputs": ["docs/**", "scripts/docs/**", "contracts/interfaces.json", "package.json", "package-lock.json"]},
    "docs-verify-idempotent": {"scope": "owner", "needs": [], "inputs": ["docs/**", "scripts/docs/**", "contracts/interfaces.json", "package.json", "package-lock.json"]},
    "go-model-check": {"scope": "owner", "needs": [], "inputs": ["clients/go/model/generate.go", "generator/*.go", "cmd/orm-gen/*.go"]},
    "client-unit-check": {"scope": "owner", "needs": [], "inputs": ["clients/php/tests/dsn.php", "clients/php/tests/relation_keys.php", "clients/php/tests/hostcodec.php", "clients/php/tests/engine_test.php", "clients/php/tests/runtime_model_test.php", "clients/php/tests/orm_gen_test.php", "clients/php/tests/perf_extensions_test.php"]},
    "php-min-check": {"scope": "owner", "needs": [], "inputs": ["scripts/php/php-min.sh"]},
    "ts-check": {"scope": "suite", "needs": ["databases"]},
    "ts-min-check": {"scope": "owner", "needs": ["databases"], "inputs": ["scripts/typescript/node-min.sh"]},
    "rust-check": {"scope": "suite", "needs": []},
    "go-fmt-check": {"scope": "owner", "needs": [], "lints": ["**/*.go"]},
    "go-vet-check": {"scope": "owner", "needs": [], "lints": ["**/*.go", "go.mod", "go.sum"]},
    "rust-fmt-check": {"scope": "owner", "needs": [], "lints": ["clients/rust/**/*.rs", "bench/rust/**/*.rs", "tests/interfaces/rust/**/*.rs"]},
    "rust-150-check": {"scope": "owner", "needs": [], "inputs": ["scripts/check-rust-150.sh"]},
    "rust-driver-check": {"scope": "owner", "needs": ["databases"], "inputs": ["bench/rust/**"]},
    "example-check": {"scope": "owner", "needs": ["databases"], "inputs": ["examples/**"]},
    "client-db-check": {"scope": "suite", "needs": ["databases"]},
    "codec-check": {"scope": "owner", "needs": [], "inputs": ["tests/codec/**"]},
