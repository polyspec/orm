{
  "comment": "The repository paths that each make target of CHECK_TARGETS reads. make owner-check runs every target whose inputs include a changed path; make repo-check requires an entry for every target of CHECK_TARGETS and a tracked match for every pattern. A pattern matches a repository path: * within one path segment, ** across segments.",
  "targets": {
    "checklist-check": ["docs/checklist.md", "docs/checklist.ko.md", "scripts/checklist/**"],
    "version-check": ["VERSION", "scripts/version/**", "**/Cargo.toml", "**/Cargo.lock", "clients/php/composer.json", "clients/typescript/package.json", "clients/typescript/package-lock.json", "contracts/features.json", "**/*.md"],
    "testcase-check": ["internal/testcase/**", "tests/testcase.mjs", "tests/testcase.test.mjs", "tests/testcase.php", "tests/testcase_test.php", "clients/rust/testcase/**"],
    "repo-check": ["**"],
    "git-check": ["scripts/git/**", "contracts/rules.json"],
    "docs-rules-check": ["**/*.md", "contracts/rules.json", "scripts/docs/**"],
    "docs-check": ["docs/**", "scripts/docs/**", "contracts/interfaces.json", "package.json", "package-lock.json"],
    "docs-verify-idempotent": ["docs/**", "scripts/docs/**", "contracts/interfaces.json", "package.json", "package-lock.json"],
    "go-model-check": ["clients/go/**", "engine/**", "generator/**", "cmd/**", "schema/**", "go.mod", "go.sum"],
    "client-unit-check": ["clients/php/**", "schema/**", "tests/testcase.php"],
    "php-min-check": ["clients/php/**", "schema/**", "tests/testcase.php", "scripts/php/**"],
    "ts-check": ["clients/typescript/**", "schema/**", "tests/conformance/runner_typescript.mjs", "tests/testcase.mjs", "scripts/typescript/**", "package.json"],
    "ts-min-check": ["clients/typescript/**", "schema/**", "tests/conformance/runner_typescript.mjs", "tests/testcase.mjs", "scripts/typescript/**", "package.json"],
    "rust-check": ["clients/rust/**", "rust-toolchain.toml"],
    "go-fmt-check": ["**/*.go"],
    "rust-fmt-check": ["clients/rust/**/*.rs"],
    "rust-150-check": ["clients/rust/**", "scripts/check-rust-150.sh"],
    "rust-driver-check": ["bench/rust/**"],
    "example-check": ["examples/**", "clients/**", "schema/**"],
    "client-db-check": ["clients/**", "schema/**", "scripts/client-db-test.sh", "tests/testcase.*"],
    "client-pooler-check": ["clients/**", "schema/**", "scripts/client-db-test.sh", "tests/testcase.*"],
    "case-database-check": ["clients/**", "scripts/case-database-check.mjs", "tests/testcase.*"],
    "dialect-facts-check": ["tests/dialects/**", "scripts/test-servers.sh"],
    "conformance-check": ["tests/conformance/**", "clients/**", "engine/**", "schema/**"],
    "package-check": ["scripts/package-check.sh", "clients/**", "VERSION"],
    "dbspec-ddl-check": ["tests/dialects/**", "tests/dbspec/**", "engine/**"],
    "dbspec-introspect-check": ["tests/dialects/**", "tests/dbspec/**", "engine/**"],
    "dbspec-introspect-ts-check": ["clients/typescript/**", "tests/dbspec/**"],
    "dbspec-introspect-php-check": ["clients/php/**", "tests/dbspec/**"],
    "dbspec-introspect-rust-check": ["clients/rust/**", "tests/dbspec/**"],
    "dbspec-introspect-compare-check": ["tests/dbspec/**", "clients/**", "engine/**"],
    "dbspec-plan-check": ["tests/dialects/**", "tests/dbspec/**", "engine/**"],
    "dbspec-apply-check": ["tests/dialects/**", "tests/dbspec/**", "engine/**"],
    "dbspec-plan-ts-check": ["clients/typescript/**", "tests/dbspec/**"],
    "dbspec-plan-rust-check": ["clients/rust/**", "tests/dbspec/**"],
    "ts-model-check": ["clients/typescript/**", "schema/**"],
    "dbspec-plan-php-check": ["clients/php/**", "tests/dbspec/**"],
    "dbspec-apply-php-check": ["clients/php/**", "tests/dbspec/**"],
    "dbspec-apply-rust-check": ["clients/rust/**", "tests/dbspec/**"],
    "dbspec-apply-ts-check": ["clients/typescript/**", "tests/dbspec/**"],
    "dbspec-apply-pairs-check": ["tests/dialects/**", "tests/dbspec/**", "clients/**", "engine/**"],
    "feature-check": ["contracts/**", "scripts/features/**"],
    "go-test-check": ["**/*.go", "go.mod", "go.sum"]
  }
}
