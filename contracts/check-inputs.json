  "paths": {
    ".github/runner": {"scope": "suite", "reason": "it names the runner image of every job of the CI workflow, so it changes the machine that runs every target"},
    ".github/workflows/ci.yml": {"scope": "suite", "reason": "it defines the CI jobs that install the toolchains and run make check and the documentation checks, so it changes how every target runs in CI"},
    ".github/workflows/push-gate.yml": {"scope": "suite", "reason": "it runs the push check on every push, pull request and merge group, so it decides whether each change of every file passes in CI"},
    ".github/workflows/docs-pages.yml": {"scope": "suite", "reason": "it builds and publishes the documentation site from every document on each push to main, so it changes the publication of every page"},
    "scripts/ci/server-programs.mts": {"scope": "suite", "reason": "the CI setup step server-programs runs it to install the programs of the database servers on the Linux runner, so it changes the servers of every database target in CI"},
    "scripts/ci/php-extension-tools.mts": {"scope": "suite", "reason": "the CI setup step php-extension-tools runs it to check phpize and php-config and to install the gen_stub.php and PHP-Parser that the arginfo check of the PHP extension orm_dbspec reads, so it gates the PHP extension targets in CI"},
    "tests/timezone/date.ini": {"scope": "suite", "reason": "WITH_TEST_ENV adds it to the PHP ini scan path of every target that runs database clients, so it sets the time zone of every PHP client the suite starts"},
    ".gitignore": {"scope": "lint", "reason": "it only decides which files git ignores; no test reads it, and owner-check and make check list changed files through git"},
    ".php-version": {"scope": "suite", "reason": "it selects the PHP release of every check, locally and in CI, so it changes the runtime of every PHP target"},
    "mise.toml": {"scope": "suite", "reason": "its tool node selects the Node release of every check, locally and in CI, so it changes the runtime of every Node and TypeScript target"},
    "LICENSE": {"scope": "lint", "reason": "license text; no code or test reads it"},
    "composer.lock": {"scope": "suite", "reason": "it pins the PHP dependencies that every PHP check loads through the autoloader"},
    "composer.json": {"scope": "suite", "reason": "the private Composer root that installs the PHP dependencies every PHP check loads through the autoloader"},
    "packages/rust/rustfmt.toml": {"scope": "lint", "reason": "it configures rustfmt, which rust-fmt-check runs over every Rust file"},
    "go.work": {"scope": "suite", "reason": "it joins the Go modules packages/go, tests and examples, so every Go build and test resolves the orm packages from the checkout"},
    "go.work.sum": {"scope": "suite", "reason": "it pins the checksums of the modules that the workspace of go.work resolves beyond the go.sum of its modules"},
    "packages/go/go.mod": {"scope": "suite", "reason": "it pins the Go toolchain and the modules of every Go build and test"},
    "packages/go/go.sum": {"scope": "suite", "reason": "it pins the module checksums of every Go build and test"},
    "tests/go.mod": {"scope": "suite", "reason": "it pins the modules of the Go runners and physical tests under tests/"},
    "tests/go.sum": {"scope": "suite", "reason": "it pins the module checksums of the Go runners and physical tests under tests/"},
    "examples/go.mod": {"scope": "suite", "reason": "it pins the modules of the Go examples and their output test"},
    "examples/go.sum": {"scope": "suite", "reason": "it pins the module checksums of the Go examples and their output test"},
    "rust-toolchain.toml": {"scope": "suite", "reason": "it selects the Rust toolchain of every Rust build and test, locally and in CI"},
    "packages/go/internal/testdb/testdb.go": {"scope": "suite", "reason": "every Go database test opens its database through it, so it changes the setup of every Go database target"},
    "packages/rust/case-clock/src/lib.rs": {"scope": "suite", "reason": "every Rust test that checks the database clock takes its case clock from it"},
    "packages/rust/case-database/src/lib.rs": {"scope": "suite", "reason": "every Rust database test creates and drops its case database through it"},
    "scripts/free-ports.mts": {"scope": "suite", "reason": "make test-servers chooses the ports of the database servers of this checkout through it, so it changes the servers of every database target"},
    "scripts/publish-output.mts": {"scope": "suite", "reason": "every make target that builds the lease program, the process tools, a stress document or a test binary publishes it through it (PUBLISH)"},
    "scripts/typescript/build.mts": {"scope": "suite", "reason": "every make target and npm script that builds the TypeScript client publishes packages/ts/dist through it"},
    "scripts/cargo-build-copy.mts": {"scope": "suite", "reason": "every make target that runs a Rust program builds and copies that program through it (CARGO_COPY)"}
  }
}
