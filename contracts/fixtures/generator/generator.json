    {
      "id": "unknown-column",
      "requirements": [
        "DSL-37"
      ],
      "steps": [
        {
          "op": "generator.generate",
          "schema": "../generator_scan/names.dbs",
          "options": {
            "sources": {
              "go": {
                "example/example.go": "package example\n\nimport \"example.com/ormexample/model\"\n\nfunc Use() {\n\t_ = model.Product().LtNoSuchColumn(1)\n}\n"
              },
              "typescript": {
                "example/example.ts": "import { Product } from '../model/models.js';\n\nnew Product().ltNoSuchColumn(1);\n"
              },
              "python": {
                "example/example.py": "from model.models import Product\n\nProduct().lt_no_such_column(1)\n"
              },
              "php": {
                "example/example.php": "<?php\n\nuse Example\\Model\\Product;\n\n(new Product())->ltNoSuchColumn(1);\n"
              },
              "rust": {
                "example/example.rs": "mod own { include!(\"../model/orm_model.rs\"); }\nuse own::Product;\n\nfn run() {\n    let _ = Product::new().lt_no_such_column(1);\n}\n"
              }
            }
          },
          "expect": {
            "none": {
              "error": "CONFIG"
            }
          }
        }
      ]
    },
