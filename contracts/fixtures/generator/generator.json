        "DSL-127",
        "PLN-22"
      ],
      "steps": [
        {
          "op": "generator.generate",
          "schema": "item.dbs",
          "options": {
            "schema_replace": {
              "from": "column_under_test",
              "to": "create"
            }
          },
          "expect": {
            "none": {
              "error": "CONFIG",
              "message": "item.create: column name is a reserved method name: create"
            }
          }
        }
