    {
      "id": "scanned-chain-methods-are-generated",
      "requirements": [
        "DSL-38",
        "PLN-1"
      ],
      "steps": [
        {
          "op": "generator.generate",
          "schema": "../generator_scan/names.dbs",
          "options": {
            "sources": {
              "go": {
                "example/example.go": "package example\n\nimport \"example.com/ormexample/model\"\n\nfunc Load() *model.ProductModel {\n\treturn model.Product().GtPrice(1).OrBrandSeq(2).AndLtPrice(3).OrderByPriceDescAndSeqAsc().NewScore(1).Relation(model.Brand().MatchBrandSeqWithSeq().AliasOwner())\n}\n\nfunc Score(p *model.ProductModel) any { return p.GetScore() }\n\nfunc Owner(p *model.ProductModel) (any, error) { return p.GetOwner() }\n"
              },
              "typescript": {
                "example/example.ts": "import { Brand, Product } from '../model/models.js';\n\nconst row = new Product().gtPrice(1).orBrandSeq(2).andLtPrice(3).orderByPriceDescAndSeqAsc().newScore(1).relation(new Brand().matchBrandSeqWithSeq().aliasOwner());\nrow.getScore();\nrow.getOwner();\n"
              },
              "python": {
                "example/example.py": "from model.models import Brand, Product\n\nrow = Product().gt_price(1).or_brand_seq(2).and_lt_price(3).order_by_price_desc_and_seq_asc().new_score(1).relation(Brand().match_brand_seq_with_seq().alias_owner())\nrow.get_score()\nrow.get_owner()\n"
              },
              "php": {
                "example/example.php": "<?php\n\nuse Example\\Model\\Brand;\nuse Example\\Model\\Product;\n\n$row = (new Product())->gtPrice(1)->orBrandSeq(2)->andLtPrice(3)->orderByPriceDescAndSeqAsc()->newScore(1)->relation((new Brand())->matchBrandSeqWithSeq()->aliasOwner());\n$row->getScore();\n$row->getOwner();\n"
              },
              "rust": {
                "example/example.rs": "mod own { include!(\"../model/orm_model.rs\"); }\nuse own::{Brand, Product};\n\nfn run() {\n    let row = Product::new().gt_price(1).or_brand_seq(2).and_lt_price(3).order_by_price_desc_and_seq_asc().new_score(1).relation(Brand::new().match_brand_seq_with_seq().alias_owner());\n    let _ = row.get_score();\n    let _ = row.get_owner();\n}\n"
              }
            }
          },
          "expect": {
            "none": {
              "value": {
                "includes": [
                  "product.gt_price",
                  "product.or_brand_seq",
                  "product.and_lt_price",
                  "product.order_by_price_desc_and_seq_asc",
                  "product.score",
                  "product.owner",
                  "brand.match_brand_seq_with_seq"
                ],
                "excludes": [
                  "product.and_price"
                ]
              }
            }
          }
        }
      ]
    },
