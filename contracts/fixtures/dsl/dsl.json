{
  "$schema": "../../../scripts/features/schema/recipe.schema.json",
  "requirements": [
    "DSL-49",
    "DSL-50",
    "PLN-4"
  ],
  "cases": [
    {
      "id": "chain_list_without_an_operator",
      "requirements": ["DSL-50", "PLN-4"],
      "steps": [
        {
          "op": "markdown.send",
          "column": "slots.i64_value",
          "operator": "eq",
          "params": [{"array": [{"int": "5"}, {"int": "20"}]}],
          "expect": {"message": [5, 20]}
        }
      ]
    },
    {
      "id": "chain_list_with_eq",
      "requirements": ["DSL-50", "PLN-4"],
      "steps": [
        {
          "op": "markdown.send",
          "column": "slots.i64_value",
          "operator": "eq_method",
          "params": [{"array": [{"int": "5"}, {"int": "20"}]}],
          "expect": {"message": [5, 20]}
        }
      ]
    },
    {
      "id": "chain_list_with_ne",
      "requirements": ["DSL-50", "PLN-4"],
      "steps": [
        {
          "op": "markdown.send",
          "column": "slots.i64_value",
          "operator": "ne_method",
          "params": [{"array": [{"int": "5"}, {"int": "20"}]}],
          "expect": {"message": [5, 20]}
        }
      ]
    },
    {
      "id": "chain_value_with_gt",
      "requirements": ["DSL-50", "PLN-4"],
      "steps": [
        {
          "op": "markdown.send",
          "column": "slots.i64_value",
          "operator": "gt_method",
          "params": [{"int": "5"}],
          "expect": {"message": 5}
        }
      ]
    },
    {
      "id": "chain_null_on_a_nullable_column",
      "requirements": ["DSL-49"],
      "steps": [
        {
          "op": "markdown.send",
          "column": "slots.varchar_null_value",
          "operator": "eq",
          "params": [{"nil": true}],
          "expect": {"message": []}
        }
      ]
    }
  ]
}
