              "error": "config",
              "message": "config: the subscriber refuses the statement"
            },
            "postgres": {
              "error": "config",
              "message": "config: the subscriber refuses the statement"
            },
            "sqlite": {
              "error": "config",
              "message": "config: the subscriber refuses the statement"
            }
          }
        },
