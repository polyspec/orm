    {
      "id": "a_subscriber_error_of_a_kind_keeps_its_kind",
      "requirements": [
        "CORE-28",
        "INT-96"
      ],
      "install": false,
      "steps": [
        {
          "op": "model.connect",
          "pool_size": 1,
          "as": "conn"
        },
        {
          "op": "schema.install",
          "connection": "conn"
        },
        {
          "op": "events.fail_subscriber",
          "connection": "conn",
          "kind": "insert",
          "refusal": {
            "code": "config",
            "message": "the subscriber refuses the statement"
          },
          "as": "failing"
        },
        {
          "op": "model.create",
          "connection": "conn",
          "model": "EventProbe",
          "values": {
            "label": {
              "text": "a"
            }
