          "pool_size": 1,
          "as": "connection"
        },
        {
          "op": "transaction",
          "connection": "connection",
          "steps": [
            {
              "op": "model.create",
              "connection": "connection",
              "model": "CompositeAccount",
              "values": {
                "tenant_id": {
                  "int": "990010"
                },
                "account_id": {
                  "int": "1"
                },
                "name": {
                  "text": "kept"
                }
              }
            },
            {
              "op": "transaction",
