  "cases": [
    {
      "id": "sqlite_temporal_checks",
      "requirements": [
        "INT-103",
        "INT-165",
        "INT-176",
        "INT-177",
        "INT-178"
      ],
      "only": [
        "sqlite"
      ],
      "steps": [
        {
          "op": "sql.exec",
          "reason": "a datetime whose CHECK fixes the digits",
          "sql": "CREATE TABLE kcat_temporal_ok (id INTEGER PRIMARY KEY, a DATETIME CHECK (\"a\" IS NULL OR (length(\"a\") = 23 AND substr(\"a\", 1, 19) IS datetime(substr(\"a\", 1, 19)) AND substr(\"a\", 12, 2) < '24' AND substr(\"a\", 20, 1) = '.' AND substr(\"a\", 21) GLOB '[0-9][0-9][0-9]')))"
        },
        {
          "op": "sql.exec",
          "reason": "a value in the dbspec form with the digits that its CHECK fixes",
          "sql": "INSERT INTO kcat_temporal_ok (id, a) VALUES (1, '2026-01-02 03:04:05.123')"
        },
        {
          "op": "sql.exec",
          "reason": "columns declared DATE, DATETIME and TIMESTAMP, whose text a driver could parse into a time value",
          "sql": "CREATE TABLE kcat_query_temporal (id INTEGER PRIMARY KEY, d DATE, dt DATETIME, ts TIMESTAMP)"
        },
        {
          "op": "sql.exec",
          "reason": "a plain query gives the text of each grid cell, the stored text, never a time value (INT-165, INT-153)",
          "sql": "INSERT INTO kcat_query_temporal (id, d, dt, ts) VALUES (1, '2026-01-02', '2026-01-02 03:04:05.123', '2026-01-02 03:04:05')"
        },
        {
          "op": "catalog.read_only_query",
          "sql": "SELECT d, dt, ts FROM kcat_query_temporal",
          "expect": {
            "sqlite": {
              "rows": [
                [
                  {
                    "text": "2026-01-02"
                  },
                  {
                    "text": "2026-01-02 03:04:05.123"
                  },
                  {
                    "text": "2026-01-02 03:04:05"
                  }
                ]
              ]
            }
          }
        },
        {
          "op": "sql.exec",
          "reason": "a datetime column with no CHECK",
          "sql": "CREATE TABLE kcat_temporal_bare (id INTEGER PRIMARY KEY, b DATETIME)"
        },
        {
          "op": "sql.exec",
          "reason": "a text that is no dbspec datetime",
          "sql": "INSERT INTO kcat_temporal_bare (id, b) VALUES (1, 'not a datetime')"
        },
        {
          "op": "catalog.table_page",
          "table": "kcat_temporal_ok",
          "limit": 1,
          "offset": 0,
          "columns": [
            "id",
            "a"
          ],
          "expect": {
            "sqlite": {
              "columns": [
                "id",
                "a"
              ],
              "order_by": [
                "id"
              ],
              "has_more": false,
              "rows": [
                [
                  {
                    "int": "1"
                  },
                  {
                    "datetime": "2026-01-02 03:04:05.123"
                  }
                ]
              ]
            }
          }
        },
        {
          "op": "catalog.table_page",
          "table": "kcat_temporal_bare",
          "limit": 1,
          "offset": 0,
          "columns": [
            "id",
            "b"
          ],
          "expect": {
            "sqlite": {
              "error": "grid_temporal_value",
              "message": "grid_temporal_value: column 2: the stored value is not a dbspec datetime"
            }
          }
        },
        {
          "op": "sql.exec",
