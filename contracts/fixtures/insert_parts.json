{
  "feature": "model_writes",
  "rule": "docs/spec/protocol.md \"Multi-row inserts\": creates(rows, batch) runs rows as batches in the given row order; each batch is batch rows, the last one the rows left when fewer, and each batch is one multi-row INSERT.",
  "cases": [
    {
      "id": "empty",
      "operation": "insert_parts",
      "input": {
        "rows": 0,
        "batch": 3
      },
      "expected": []
    },
    {
      "id": "one_row",
      "operation": "insert_parts",
      "input": {
        "rows": 1,
        "batch": 3
      },
      "expected": [
        1
      ]
    },
    {
      "id": "exact_batches",
      "operation": "insert_parts",
      "input": {
        "rows": 6,
        "batch": 3
      },
      "expected": [
        3,
        3
      ]
    },
    {
      "id": "last_batch_smaller",
      "operation": "insert_parts",
      "input": {
        "rows": 7,
        "batch": 3
      },
      "expected": [
        3,
        3,
        1
      ]
    },
    {
      "id": "batch_over_rows",
      "operation": "insert_parts",
      "input": {
        "rows": 5,
        "batch": 100
      },
      "expected": [
        5
      ]
    },
    {
      "id": "batch_of_one",
      "operation": "insert_parts",
      "input": {
        "rows": 3,
        "batch": 1
      },
      "expected": [
        1,
        1,
        1
      ]
    }
  ],
  "requirements": ["PRT-41"]
}
