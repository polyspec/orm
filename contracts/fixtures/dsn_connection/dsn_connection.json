    {
      "id": "dsn_parameters_of_this_page",
      "requirements": [
        "CFG-2",
        "CFG-19"
      ],
      "steps": [
        {
          "op": "dsn.connect",
          "dsn": "case",
          "query": "timezone=UTC",
          "expect": {
            "mysql": {
              "value": {
                "text": "mysql"
              }
            },
            "postgres": {
              "value": {
                "text": "postgres"
              }
            },
            "sqlite": {
              "value": {
                "text": "sqlite"
              }
            }
          }
        },
        {
          "op": "dsn.connect",
          "dsn": "case",
          "query": "timezone=%2B00:00",
