            "mysql": {
              "value": {
                "text": "mysql"
              }
            },
            "postgres": {
              "value": {
                "text": "postgres"
              }
            },
            "sqlite": {
              "value": {
                "text": "sqlite"
              }
            }
          }
        },
        {
          "op": "dsn.connect",
          "dsn": "case",
          "query": "sslmode=disable",
          "expect": {
            "postgres": {
              "value": {
                "text": "postgres"
              }
            }
          },
          "only": [
            "postgres"
          ]
        },
        {
          "op": "dsn.connect",
          "dsn": "case",
          "query": "host=127.0.0.1",
          "expect": {
            "postgres": {
              "value": {
                "text": "postgres"
              }
            }
          },
          "only": [
            "postgres"
          ]
        },
        {
          "op": "dsn.connect",
          "dsn": "case",
          "query": "_pragma=busy_timeout(5000)&timezone=UTC",
