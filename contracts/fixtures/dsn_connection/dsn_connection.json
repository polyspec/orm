            "sqlite": {
              "value": {
                "text": "sqlite"
              }
            }
          },
          "only": [
            "sqlite"
          ]
        }
      ]
    },
    {
      "id": "sqlite_file_name_is_the_path",
      "requirements": [
        "CFG-26"
      ],
      "only": [
        "sqlite"
      ],
      "steps": [
        {
          "op": "dsn.sqlite_file",
          "name": "named.sqlite",
          "query": "_pragma=busy_timeout(5000)&timezone=%2B00:00",
          "expect": {
            "sqlite": {
              "value": {
                "text": "named.sqlite"
              }
            }
          }
        }
      ]
    },
    {
      "id": "sqlite_refused_dsn_creates_no_file",
      "requirements": [
        "CFG-12"
      ],
      "only": [
        "sqlite"
      ],
      "steps": [
        {
          "op": "dsn.sqlite_file",
          "name": "refused.sqlite",
          "query": "_txlock=immediate",
          "expect": {
            "sqlite": {
              "error": "CONFIG"
            }
          }
        },
        {
          "op": "dsn.sqlite_file",
          "name": "refused.sqlite",
          "query": "timezone=Asia%2FSeoul",
          "expect": {
            "sqlite": {
              "error": "CONFIG"
            }
          }
        },
        {
          "op": "dsn.sqlite_file",
          "name": "refused.sqlite",
          "query": "_pragma=busy_timeout(soon)",
          "expect": {
            "sqlite": {
              "error": "CONFIG"
            }
          }
        }
      ]
    },
    {
      "id": "mysql_session_settings",
      "requirements": [
        "CFG-3"
      ],
      "only": [
        "mysql"
      ],
      "steps": [
        {
          "op": "dsn.connect",
          "dsn": "case",
          "config": {
            "statement_timeout_ms": 237,
            "session_read": {
              "sql": "SELECT @@SESSION.sql_mode, @@SESSION.time_zone, @@SESSION.max_execution_time",
              "row": [
                "ONLY_FULL_GROUP_BY,STRICT_ALL_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION",
                "+00:00",
                "237"
              ]
            }
          },
          "expect": {
            "mysql": {
              "value": {
                "text": "mysql"
              }
            }
          }
        }
      ]
    },
