dbspec 1 aes_rotation

table rot_row {
  seq i64 identity
  aes_key_version i32
  token varchar(255) null
  primary key (seq)
  settings {
    codec token aes hex
    aes_version aes_key_version
  }
}

table rot_pair {
  seq i64 identity
  aes_key_version i32
  token varchar(255) null
  memo varchar(255) null
  primary key (seq)
  settings {
    codec token aes hex
    codec memo aes hex
    aes_version aes_key_version
  }
}

table secret_config {
  seq i64 identity
  aes_key_version i32
  config bytes
  primary key (seq)
  settings {
    select explicit aes_key_version config
    codec config ordered_json aes
    aes_version aes_key_version
  }
}

table rot_parent {
  seq i64 identity
  aes_key_version i32
  token varchar(255) null
  primary key (seq)
  settings {
    codec token aes hex
    aes_version aes_key_version
  }
}

table rot_child {
  seq i64 identity
  rot_parent_seq i64
  aes_key_version i32
  token varchar(255) null
  primary key (seq)
  settings {
    codec token aes hex
    aes_version aes_key_version
  }
}
