dbspec 1 ext_member

use ext_core { ext_account, ext_audit }

table ext_post {
  seq i64 identity
  account_seq i64
  title varchar(191)
  audit_seq i64
  primary key (seq)
  index ix_ext_post_account (account_seq)
  index ix_ext_post_audit (audit_seq)
  foreign key fk_ext_post_account (account_seq) references ext_account (seq) on delete restrict on update restrict
  foreign key fk_ext_post_audit (audit_seq) references ext_audit (seq) on delete restrict on update restrict
  settings {
    audit into ext_post_history column audit_seq references ext_audit action change previous previous_audit_seq
  }
}

table ext_post_history {
  history_id i64 identity
  change varchar(8)
  previous_audit_seq i64 null
  seq i64
  account_seq i64
  title varchar(191)
  audit_seq i64
  primary key (history_id)
  index ix_ext_post_history_row (seq)
}
