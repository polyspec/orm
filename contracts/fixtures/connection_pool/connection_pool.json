      "id": "the_pool_size_is_the_open_maximum",
      "requirements": [
        "CFG-4"
      ],
      "only": [
        "mysql",
        "postgres"
      ],
      "steps": [
        {
          "op": "model.connect",
          "as": "conn",
          "pool_size": 3
        },
        {
          "op": "utils.stats",
          "connection": "conn",
          "expect": {
            "mysql": {
              "json": {
                "max_open_connections": 3,
                "open_connections": 1,
                "in_use": 0,
                "idle": 1
              }
            },
            "postgres": {
              "json": {
                "max_open_connections": 3,
                "open_connections": 1,
                "in_use": 0,
                "idle": 1
              }
            }
          }
        }
      ]
    },
