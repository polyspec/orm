    {
      "id": "a_connection_within_its_lifetime_is_reused",
      "requirements": [
        "CFG-5"
      ],
      "only": [
        "mysql",
        "postgres"
      ],
      "not_through_pooler": "A pooler reuses its server sessions, so a mark of the session does not tell the connections of the client apart.",
      "steps": [
        {
          "op": "model.connect",
          "as": "conn",
          "pool_size": 1,
          "pool_lifetime_ms": 600000
        },
        {
          "op": "utils.run",
          "connection": "conn",
          "statements": [
            {
              "kind": "utility",
              "tables": [],
              "sql": {
                "mysql": "SET @pool_mark = 1",
                "postgres": "SELECT set_config('orm.pool_mark', '1', false)",
                "sqlite": "SELECT 1"
              }
            },
            {
              "kind": "utility",
              "tables": [],
              "sql": {
                "mysql": "SELECT IF(@pool_mark IS NULL, 0, 1)",
                "postgres": "SELECT CASE WHEN current_setting('orm.pool_mark', true) = '1' THEN 1 ELSE 0 END",
                "sqlite": "SELECT 1"
              }
            }
          ],
          "expect": {
            "mysql": {
              "value": {
                "array": [
                  {
                    "array": [
                      {
                        "int": "1"
                      }
                    ]
                  }
                ]
              }
            },
            "postgres": {
              "value": {
                "array": [
                  {
                    "array": [
                      {
                        "int": "1"
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "op": "utils.run",
          "connection": "conn",
          "statements": [
            {
              "kind": "utility",
              "tables": [],
              "sql": {
                "mysql": "SELECT IF(@pool_mark IS NULL, 0, 1)",
                "postgres": "SELECT CASE WHEN current_setting('orm.pool_mark', true) = '1' THEN 1 ELSE 0 END",
                "sqlite": "SELECT 1"
              }
            }
          ],
          "expect": {
            "mysql": {
              "value": {
                "array": [
                  {
                    "array": [
                      {
                        "int": "1"
                      }
                    ]
                  }
                ]
              }
            },
            "postgres": {
              "value": {
                "array": [
                  {
                    "array": [
                      {
                        "int": "1"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
