        {
          "op": "utils.run",
          "connection": "conn",
          "statements": [
            {
              "kind": "utility",
              "tables": [],
              "sql": {
                "mysql": "SELECT COALESCE(@`orm.ormtest.session`, '')",
                "postgres": "SELECT COALESCE(current_setting('ormtest.session', true), '')",
                "sqlite": "SELECT ''"
              }
            }
          ],
          "expect": {
            "mysql": {
              "value": {
                "array": [
                  {
                    "array": [
                      {
                        "text": ""
                      }
                    ]
                  }
                ]
              }
            },
            "postgres": {
              "value": {
                "array": [
                  {
                    "array": [
                      {
                        "text": ""
                      }
                    ]
                  }
                ]
              }
            },
            "sqlite": {
              "value": {
                "array": [
                  {
                    "array": [
                      {
                        "text": ""
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "op": "transaction",
          "connection": "other",
          "steps": [
            {
              "op": "utils.lock",
              "connection": "other",
              "name": "orm_test.session_state"
            }
          ]
        }
      ]
