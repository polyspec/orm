          ],
          "statements": [
            {
              "kind": "select",
              "tables": [],
              "sql": "SELECT CAST(has_table_privilege('orm_priv_probe', 'public.privilege_probe', 'SELECT') AS integer), CAST(has_table_privilege('orm_priv_probe', 'public.privilege_probe', 'INSERT') AS integer), CAST(has_table_privilege('orm_priv_probe', 'public.privilege_probe', 'UPDATE') AS integer), CAST(has_table_privilege('orm_priv_probe', 'public.privilege_probe', 'DELETE') AS integer), CAST(has_table_privilege('orm_priv_probe', 'public.privilege_probe', 'TRUNCATE') AS integer)"
