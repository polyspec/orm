          "op": "utils.privilege",
          "connection": "conn",
          "call": "revoke",
          "table": "public.privilege_probe",
          "role": "invalid-role",
          "privilege": "SELECT",
          "expect": {
            "mysql": {
              "error": "CAPABILITY_UNSUPPORTED"
            },
            "postgres": {
              "error": "CONFIG"
            },
