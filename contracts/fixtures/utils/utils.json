      "id": "local_value_is_readable_in_its_transaction",
      "requirements": [
        "INT-51"
      ],
      "install": false,
      "steps": [
        {
          "op": "model.connect",
          "pool_size": 1,
          "as": "conn"
        },
        {
          "op": "schema.install",
          "connection": "conn"
        },
        {
          "op": "transaction",
          "connection": "conn",
          "steps": [
            {
              "op": "utils.set_local",
              "connection": "conn",
              "name": "ormtest.actor",
              "value": {
                "text": "tester"
              }
            },
            {
              "op": "utils.local",
              "connection": "conn",
              "name": "ormtest.actor",
              "expect": {
                "mysql": {
                  "json": "tester"
                },
                "postgres": {
                  "json": "tester"
                },
                "sqlite": {
                  "json": "tester"
                }
              }
            },
            {
              "op": "utils.local",
              "connection": "conn",
              "name": "ormtest.missing",
              "expect": {
                "mysql": {
                  "error": "NO_ROWS"
                },
                "postgres": {
                  "error": "NO_ROWS"
                },
                "sqlite": {
                  "error": "NO_ROWS"
                }
              }
            }
          ],
          "expect": {
            "mysql": {
              "value": {
                "bool": true
              }
            },
            "postgres": {
              "value": {
                "bool": true
              }
            },
            "sqlite": {
              "value": {
                "bool": true
              }
            }
          }
        },
        {
          "op": "utils.local",
          "connection": "conn",
          "name": "ormtest.actor",
          "expect": {
            "mysql": {
              "error": "CONFIG"
            },
            "postgres": {
              "error": "CONFIG"
            },
            "sqlite": {
              "error": "CONFIG"
            }
          }
        },
        {
          "op": "utils.set_local",
          "connection": "conn",
          "name": "ormtest.actor",
          "value": {
            "text": "tester"
          },
          "expect": {
            "mysql": {
              "error": "CONFIG"
            },
            "postgres": {
              "error": "CONFIG"
            },
            "sqlite": {
              "error": "CONFIG"
            }
          }
        }
      ]
