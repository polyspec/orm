      "id": "timezone_mysql_offset",
      "requirements": [
        "CFG-2",
        "INT-187"
      ],
      "steps": [
        {
          "op": "dsn.connect",
          "dsn": "mysql://root@localhost/orm_example?timezone=%2B09:00",
          "expect": {
            "none": {
              "error": "config",
              "message": "config: dsn timezone \"+09:00\": every connection reads and writes datetime values in UTC"
            }
          }
        }
      ]
    },
