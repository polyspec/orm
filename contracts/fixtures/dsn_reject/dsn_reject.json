    {
      "id": "markdown_connect_refused",
      "requirements": [
        "PRT-64"
      ],
      "steps": [
        {
          "op": "markdown.connect",
          "corpus": "tracker",
          "token": "0123456789abcdef0123456789abcdef",
          "reply": "{\"error\":{\"code\":\"CONFIG\",\"message\":\"connect: the token is not the corpus's token\"}}",
          "received": "{\"op\":\"connect\",\"corpus\":\"tracker\",\"token\":\"0123456789abcdef0123456789abcdef\"}",
          "expect": {
            "none": {
              "error": "CONFIG",
              "message_holds": "connect: the token is not the corpus's token"
            }
          }
        }
      ]
