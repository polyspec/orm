      "requirements": [
        "CFG-37",
        "INT-187"
      ],
      "steps": [
        {
          "op": "dsn.connect",
          "dsn": "mysql://root@db.local/orm_example?charset=latin1",
          "expect": {
            "none": {
              "error": "config",
              "message": "config: mysql DSN has the unknown parameter \"charset\"; it accepts timezone, socket, ssl-mode, ssl-ca"
            }
          }
        }
      ]
    },
