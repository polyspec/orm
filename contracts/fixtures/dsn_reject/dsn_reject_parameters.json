{
  "$schema": "../../../scripts/features/schema/recipe.schema.json",
  "requirements": [
    "CFG-37"
  ],
  "cases": [
    {
      "id": "mysql_charset",
      "requirements": [
        "CFG-37"
      ],
      "steps": [
        {
          "op": "dsn.connect",
          "dsn": "mysql://root@db.local/orm_example?charset=latin1",
          "expect": {
            "none": {
              "error": "CONFIG",
              "message_holds": "has the unknown parameter charset"
            }
          }
        }
      ]
    },
    {
      "id": "mysql_sslmode",
      "requirements": [
        "CFG-37"
      ],
      "steps": [
        {
          "op": "dsn.connect",
          "dsn": "mysql://root@db.local/orm_example?sslmode=disable",
          "expect": {
            "none": {
              "error": "CONFIG",
              "message_holds": "has the unknown parameter sslmode"
            }
          }
        }
      ]
    },
    {
      "id": "postgres_application_name",
      "requirements": [
        "CFG-37"
      ],
      "steps": [
        {
          "op": "dsn.connect",
          "dsn": "postgres://root@db.local/orm_example?application_name=orm",
          "expect": {
            "none": {
              "error": "CONFIG",
              "message_holds": "has the unknown parameter application_name"
            }
          }
        }
      ]
    },
    {
      "id": "postgres_ssl_mode",
      "requirements": [
        "CFG-37"
      ],
      "steps": [
        {
          "op": "dsn.connect",
          "dsn": "postgres://root@db.local/orm_example?ssl-mode=VERIFY_IDENTITY",
          "expect": {
            "none": {
              "error": "CONFIG",
              "message_holds": "has the unknown parameter ssl-mode"
            }
          }
        }
      ]
    },
    {
      "id": "sqlite_cache",
      "requirements": [
        "CFG-37"
      ],
      "steps": [
        {
          "op": "dsn.connect",
          "dsn": "sqlite:///tmp/orm-tls.sqlite?cache=shared",
          "expect": {
            "none": {
              "error": "CONFIG",
              "message_holds": "has the unknown parameter cache"
            }
          }
        }
      ]
    },
    {
      "id": "mysql_bracket_parameter",
      "requirements": [
        "CFG-37"
      ],
      "steps": [
        {
          "op": "dsn.connect",
          "dsn": "mysql://root@db.local/orm_example?ssl-mode%5B%5D=VERIFY_IDENTITY",
          "expect": {
            "none": {
              "error": "CONFIG",
              "message_holds": "has the unknown parameter ssl-mode[]"
            }
          }
        }
      ]
    }
  ]
}
