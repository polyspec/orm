        "PLN-44",
        "PRT-76"
      ],
      "steps": [
        {
          "op": "model.connect",
          "pool_size": 1,
          "as": "db"
        },
        {
          "op": "sql.exec",
          "sql": "INSERT INTO chunk_author (seq, name) WITH d AS (SELECT 0 AS n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) SELECT s.v, CONCAT('author-', s.v) FROM (SELECT a.n + 10 * b.n + 100 * c.n + 1000 * e.n + 10000 * f.n + 1 AS v FROM d a, d b, d c, d e, d f) s WHERE s.v <= 70000",
          "reason": "seeds the author rows 1 to 70000 with set-based SQL in each database, so the IN list can count them"
        },
        {
          "op": "model.count",
          "model": "ChunkAuthor",
          "where": {
            "seq": {
              "array": [
                {
                  "sequence": {
                    "from": 1,
                    "count": 70000
                  }
                },
                {
                  "sequence": {
                    "from": 1,
                    "count": 200
                  }
                },
                {
                  "sequence": {
                    "from": 200001,
                    "count": 100
                  }
                }
              ]
            }
          },
          "expect": {
            "mysql": {
              "value": {
                "int": "70000"
              }
            },
            "postgres": {
              "value": {
                "int": "70000"
              }
            },
            "sqlite": {
              "value": {
                "int": "70000"
              }
            }
          },
          "connection": "db"
        },
        {
          "op": "events.subscribe",
          "connection": "db",
          "as": "recorder"
        },
        {
          "op": "model.query",
          "model": "ChunkAuthor",
          "columns": [
            "seq"
          ],
          "order": [
            "seq"
          ],
          "where": {
            "seq": {
              "array": [
                {
                  "sequence": {
                    "from": 1,
                    "count": 70000
                  }
                },
                {
                  "sequence": {
                    "from": 1,
                    "count": 200
                  }
                },
                {
                  "sequence": {
                    "from": 200001,
                    "count": 100
                  }
                }
              ]
