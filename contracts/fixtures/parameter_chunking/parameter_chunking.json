    {
      "id": "root_in_chunking",
      "requirements": [
        "PLN-44",
        "PRT-76"
      ],
      "steps": [
        {
          "op": "model.connect",
          "pool_size": 1,
          "as": "db"
        },
        {
          "op": "sql.exec",
          "sql": {
            "mysql": "INSERT INTO chunk_author (seq, name) WITH d AS (SELECT 0 AS n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) SELECT s.v, CONCAT('author-', s.v) FROM (SELECT a.n + 10 * b.n + 100 * c.n + 1000 * e.n + 10000 * f.n + 1 AS v FROM d a, d b, d c, d e, d f) s WHERE s.v <= 70000",
            "postgres": "INSERT INTO chunk_author (seq, name) SELECT g, 'author-' || g FROM generate_series(1, 70000) AS g",
            "sqlite": "WITH RECURSIVE g(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM g WHERE i < 70000) INSERT INTO chunk_author (seq, name) SELECT i, 'author-' || i FROM g"
          },
          "reason": "seeds the author rows 1 to 70000 with set-based SQL in each database, so the IN list can count them"
        },
        {
          "op": "model.count",
          "model": "ChunkAuthor",
          "where": {
            "seq": {
              "array": [
                {
                  "sequence": {
                    "from": 1,
                    "count": 70000
                  }
                },
                {
                  "sequence": {
                    "from": 1,
                    "count": 200
                  }
                },
                {
                  "sequence": {
                    "from": 200001,
                    "count": 100
                  }
                }
              ]
            }
          },
          "expect": {
            "mysql": {
              "value": {
                "int": "70000"
              }
            },
            "postgres": {
              "value": {
                "int": "70000"
              }
            },
            "sqlite": {
              "value": {
                "int": "70000"
              }
            }
          },
          "connection": "db"
        },
        {
          "op": "model.query",
          "model": "ChunkAuthor",
          "columns": [
            "seq"
          ],
          "order": [
            "seq"
          ],
          "where": {
            "seq": {
              "array": [
                {
                  "sequence": {
                    "from": 1,
                    "count": 70000
                  }
                },
                {
                  "sequence": {
                    "from": 1,
                    "count": 200
                  }
                },
                {
                  "sequence": {
                    "from": 200001,
                    "count": 100
                  }
                }
              ]
            }
          },
          "limit": 10,
          "expect": {
            "mysql": {
              "error": "IR_INVALID"
            },
            "postgres": {
              "error": "IR_INVALID"
            },
            "sqlite": {
              "error": "IR_INVALID"
            }
          },
          "connection": "db"
        }
      ]
    },
    {
      "id": "split_root_null_identity",
      "requirements": [
        "PRT-35",
        "PRT-76"
      ],
      "steps": [
        {
          "op": "model.connect",
          "pool_size": 1,
          "as": "db"
        },
        {
          "op": "sql.exec",
          "sql": "DROP TABLE chunk_author",
          "reason": "A .dbs declares a primary key, which holds no NULL; only this table without it gives the merge of a split root in list a row whose identity is NULL (PRT-35)."
        },
        {
          "op": "sql.exec",
          "sql": "CREATE TABLE chunk_author (seq BIGINT NULL, name VARCHAR(32) NOT NULL, batch_no BIGINT NULL)",
          "reason": "A .dbs declares a primary key, which holds no NULL; only this table without it gives the merge of a split root in list a row whose identity is NULL (PRT-35)."
        },
        {
          "op": "sql.exec",
          "sql": "INSERT INTO chunk_author (seq, name, batch_no) VALUES (NULL, 'a', 1)",
          "reason": "seeds rows with the identities of the case, each with its batch_no in the IN list"
        },
        {
          "op": "model.query",
          "connection": "db",
          "model": "ChunkAuthor",
          "columns": [
            "seq"
          ],
          "where": {
            "batch_no": {
              "array": [
                {
                  "sequence": {
                    "from": 1,
                    "count": 70000
                  }
                }
              ]
            }
          },
          "expect": {
            "mysql": {
              "error": "CODEC_DECODE"
            },
            "postgres": {
              "error": "CODEC_DECODE"
            },
            "sqlite": {
              "error": "CODEC_DECODE"
            }
          }
        }
      ]
    },
