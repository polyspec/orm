          },
          "limit": 10,
          "expect": {
            "mysql": {
              "error": "ir_invalid"
            },
            "postgres": {
              "error": "ir_invalid"
            },
            "sqlite": {
              "error": "ir_invalid"
            }
          },
          "connection": "db"
        },
        {
          "op": "events.captured",
          "ref": "recorder",
