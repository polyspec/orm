      "id": "sqlite_rolled_back_transaction_reports_the_trigger",
      "requirements": [
        "INT-155"
      ],
      "only": [
        "sqlite"
      ],
      "steps": [
        {
          "op": "sql.exec",
          "sql": "CREATE TRIGGER composite_account_end BEFORE INSERT ON composite_account WHEN NEW.name = 'end' BEGIN SELECT RAISE(ROLLBACK, 'rollback probe ended the transaction'); END",
          "reason": "A .dbs declares no trigger, and this one ends the transaction on the server side of SQLite."
        },
        {
          "op": "model.connect",
          "pool_size": 1,
