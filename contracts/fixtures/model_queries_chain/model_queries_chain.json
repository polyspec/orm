        "binds": [
         7
        ]
       }
      },
      "postgres": {
       "json": {
        "sql": "SELECT \"a\".\"seq\" AS \"a__seq\", \"a\".\"name\" AS \"a__name\", \"a\".\"updated_ts\" AS \"a__updated_ts\", \"a\".\"is_close\" AS \"a__is_close\", \"a\".\"is_display\" AS \"a__is_display\", \"a\".\"read_count\" AS \"a__read_count\", \"a\".\"user_seq\" AS \"a__user_seq\", \"a\".\"service_member_seq\" AS \"a__service_member_seq\", \"a\".\"service_seq\" AS \"a__service_seq\", \"a\".\"start_dt\" AS \"a__start_dt\", \"a\".\"price\" AS \"a__price\", \"service_member_model\".\"seq\" AS \"service_member_model__seq\", \"service_member_model\".\"service_seq\" AS \"service_member_model__service_seq\", \"service_member_model\".\"user_seq\" AS \"service_member_model__user_seq\", \"user_model\".\"seq\" AS \"user_model__seq\", \"user_model\".\"name\" AS \"user_model__name\", (SELECT COALESCE(SUM(\"s1\".\"read_count\"), 0) FROM \"author\" AS \"s1\" WHERE \"s1\".\"user_seq\" = \"user_model\".\"seq\") AS \"user_model__read_total\" FROM \"author\" AS \"a\" INNER JOIN \"service_member\" AS \"service_member_model\" ON \"a\".\"service_member_seq\" = \"service_member_model\".\"seq\" INNER JOIN \"user\" AS \"user_model\" ON \"a\".\"user_seq\" = \"user_model\".\"seq\" WHERE \"a\".\"service_seq\" = $1 ORDER BY \"user_model\".\"seq\" DESC",
        "binds": [
         7
        ]
       }
      },
      "sqlite": {
       "json": {
        "sql": "SELECT \"a\".\"seq\" AS \"a__seq\", \"a\".\"name\" AS \"a__name\", \"a\".\"updated_ts\" AS \"a__updated_ts\", \"a\".\"is_close\" AS \"a__is_close\", \"a\".\"is_display\" AS \"a__is_display\", \"a\".\"read_count\" AS \"a__read_count\", \"a\".\"user_seq\" AS \"a__user_seq\", \"a\".\"service_member_seq\" AS \"a__service_member_seq\", \"a\".\"service_seq\" AS \"a__service_seq\", \"a\".\"start_dt\" AS \"a__start_dt\", \"a\".\"price\" AS \"a__price\", \"service_member_model\".\"seq\" AS \"service_member_model__seq\", \"service_member_model\".\"service_seq\" AS \"service_member_model__service_seq\", \"service_member_model\".\"user_seq\" AS \"service_member_model__user_seq\", \"user_model\".\"seq\" AS \"user_model__seq\", \"user_model\".\"name\" AS \"user_model__name\", (SELECT COALESCE(SUM(\"s1\".\"read_count\"), 0) FROM \"author\" AS \"s1\" WHERE \"s1\".\"user_seq\" = \"user_model\".\"seq\") AS \"user_model__read_total\" FROM \"author\" AS \"a\" INNER JOIN \"service_member\" AS \"service_member_model\" INDEXED BY \"ix_service_member_service\" ON \"a\".\"service_member_seq\" = \"service_member_model\".\"seq\" INNER JOIN \"user\" AS \"user_model\" ON \"a\".\"user_seq\" = \"user_model\".\"seq\" WHERE \"a\".\"service_seq\" = ? ORDER BY \"user_model\".\"seq\" DESC",
        "binds": [
