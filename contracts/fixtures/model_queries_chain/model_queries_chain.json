      "service_seq": {
       "int": "7"
      }
     },
     "joins": [
      {
       "model": "ServiceMember",
       "match": [
        "service_member_seq",
        "seq"
       ],
       "force_index": "ix_service_member_service",
       "as": "service_member"
      },
      {
       "model": "User",
       "match": [
        "user_seq",
        "seq"
       ],
       "add_columns": [
        {
         "expr": {
          "sub": {
           "model": "Author",
           "aggregate": {
            "agg": "sum",
            "column": "read_count"
           },
           "where": {
            "user_seq": {
             "eq": {
              "outer": "seq"
             }
            }
           }
          }
         },
         "as": "read_total"
        }
       ],
       "order": [
        {
         "column": "seq",
         "dir": "desc"
