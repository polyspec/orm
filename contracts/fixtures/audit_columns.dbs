dbspec 1 audit_columns

table card {
  seq i64 identity
  title varchar(191)
  secret text null
  operation_id i64
  deleted_at datetime(6) null
  primary key (seq)
  settings {
    soft_delete deleted_at
    audit into card_history operation operation_id action change previous previous_operation_id exclude (secret)
  }
}

table card_history {
  history_id i64 identity
  change varchar(8)
  previous_operation_id i64 null
  seq i64
  title varchar(191)
  operation_id i64
  deleted_at datetime(6) null
  primary key (history_id)
  index ix_card_history_row (seq)
}

table tag {
  id i64 identity
  label varchar(64)
  color varchar(16) null
  operation_id i64
  primary key (id)
  settings {
    audit into tag_history operation operation_id action change previous previous_operation_id include (label)
  }
}

table tag_history {
  history_id i64 identity
  change varchar(8)
  previous_operation_id i64 null
  label varchar(64)
  operation_id i64
  primary key (history_id)
}
