  "components": [
    {
      "id": "Query",
      "fields": {
        "binding": "Binding",
        "request": "Request",
        "keySelector": "Optional<Function<Row,Key>>"
      },
      "methods": [
        "construct",
        "bind",
        "predicate",
        "join",
        "relation",
        "get",
        "gets",
        "getCount",
        "insert",
        "save",
        "update",
        "delete",
        "sql"
      ],
      "ownership": "Owns mutable query state; never represents a loaded row."
    },
    {
      "id": "Where",
      "fields": {
        "request": "Borrow<Request>",
        "group": "Borrow<Group>",
        "pendingConnector": "Connector"
      },
      "methods": [
        "predicate",
        "and",
        "or",
        "navigate"
      ],
      "ownership": "Borrow is scoped to its callback; cannot execute SQL."
    },
    {
      "id": "Request",
      "fields": {
        "ir": "RequestIR",
        "params": "List<Value>",
        "deferredError": "Optional<Error>"
      },
      "methods": [
        "parameter",
        "attach",
        "shape"
      ],
      "ownership": "attach snapshots all child state and shifts only the snapshot."
    },
    {
      "id": "RequestIR",
      "fields": {
        "version": "I32",
        "schemaHash": "Text",
        "kind": "QueryKind",
        "root": "QueryNode",
        "set": "List<Assignment>",
        "onDuplicate": "List<Assignment>",
        "optimistic": "Optional<Optimistic>",
        "raw": "Optional<Raw>",
        "aggregate": "Optional<Column>",
        "parameterCount": "I64"
      },
      "methods": [],
      "ownership": "Value-free compiler input."
    },
    {
      "id": "QueryNode",
      "fields": {
        "entity": "Entity",
        "columns": "Projection",
        "where": "Optional<Group>",
        "on": "Optional<Group>",
        "having": "Optional<Group>",
        "joins": "List<JoinEdge>",
        "relations": "List<RelationEdge>",
        "order": "List<Order>",
        "groupBy": "List<GroupKey>",
        "limit": "Optional<Limit>",
        "options": "RelationOptions"
      },
      "methods": [],
      "ownership": "Owned condition tree, including nested child nodes."
    },
    {
      "id": "Binding",
      "fields": {
        "executor": "Optional<Executor>",
        "control": "NativeExecutionControl"
      },
      "methods": [
        "resolve"
      ],
      "ownership": "Independent of request IR; does not select ambient transactions."
    },
    {
      "id": "Executor",
      "fields": {},
      "methods": [
        "database",
        "queryStep",
        "writeStep"
      ],
      "ownership": "Adapter boundary for concrete database and pinned transaction executors."
    },
    {
      "id": "Db",
      "fields": {
        "connection": "ConnectionResource",
        "compiler": "Compiler",
        "plans": "PlanCache",
        "statements": "StatementCache",
        "config": "RuntimeConfig"
      },
      "methods": [
        "transaction",
        "queryStep",
        "writeStep"
      ],
      "ownership": "Owns connections and caches, never query predicates or row values."
    },
    {
      "id": "Tx",
      "fields": {
        "database": "Borrow<Db>",
        "connection": "PinnedConnection",
        "state": "TxState"
      },
      "methods": [
        "queryStep",
        "writeStep",
        "commit",
        "rollback"
      ],
      "ownership": "Completion invalidates every retained bound query and row."
    },
    {
      "id": "Row",
      "fields": {
        "identity": "PrimaryKey",
        "loaded": "Bool",
        "values": "ValueStore",
        "projection": "Projection",
        "dirty": "OrderedMap<Column,Assignment>",
        "deferredError": "Optional<Error>",
        "relations": "Map<Relation,RelatedValue>",
        "binding": "Binding",
        "originalVersion": "Optional<Value>"
      },
      "methods": [
        "getColumn",
        "has",
        "setColumn",
        "relLoaded",
        "bind",
        "update",
        "updateOptimistic",
        "delete",
        "deleteCascade",
        "export"
      ],
      "ownership": "Loaded identity, local values and pending changes have distinct roles."
    },
    {
      "id": "Collection",
      "fields": {
        "orderedKeys": "List<Key>",
        "items": "Map<Key,Row>"
      },
      "methods": [
        "put",
        "get",
        "first",
        "len",
        "keys",
        "entries"
      ],
      "ownership": "Equal keys replace in place. Integer and string keys remain distinct."
    },
    {
      "id": "Page",
      "fields": {
        "items": "Collection<Row>",
        "total": "I64",
        "pages": "I64",
        "current": "I64",
        "per": "I64"
      },
      "methods": [],
      "ownership": "per is positive and total is independent of page range."
    },
    {
      "id": "Compiler",
      "fields": {},
      "methods": [
        "compile"
      ],
      "ownership": "Accepts RequestIR and returns immutable Plan; has no executor."
    },
    {
      "id": "Plan",
      "fields": {
        "schemaHash": "Text",
        "kind": "QueryKind",
        "steps": "List<Step>"
      },
      "methods": [],
      "ownership": "Cached and immutable while executing."
    },
    {
      "id": "Step",
      "fields": {
        "id": "I32",
        "role": "StepRole",
        "sql": "Text",
        "bindSlots": "List<BindSlot>",
        "parent": "Optional<ParentRef>",
        "assemble": "Optional<Assemble>"
      },
      "methods": [],
      "ownership": "Executes in plan order."
    },
    {
      "id": "Assemble",
      "fields": {
        "entity": "Entity",
        "columns": "List<OutColumn>",
        "children": "List<ChildAttachment>"
      },
      "methods": [],
      "ownership": "Maps positional values to rows and relation attachments."
    },
    {
      "id": "ExecutionRows",
      "fields": {
        "binding": "Binding",
        "plan": "Plan",
        "params": "List<Value>",
        "steps": "OrderedMap<StepId,StepRows>"
      },
      "methods": [
        "related",
        "stepAssemble"
      ],
      "ownership": "Rows inherit the root executor used by this execution."
    },
    {
      "id": "Error",
      "fields": {
        "code": "Text",
        "message": "Text",
        "cause": "Optional<NativeError>"
      },
      "methods": [],
      "ownership": "Errors are distinct from empty results and native defaults."
    }
  ],
