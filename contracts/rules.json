{
  "version": 1,
  "rules": [
    {
      "id": "api.single-source",
      "source": "contracts/interfaces.json",
      "checker": "interface-check",
      "failure": "public API symbols, fields, returns, errors, or call order differ from the common interface"
    },
    {
      "id": "schema.generated",
      "source": "contracts/fixtures/bench/*.dbs",
      "checker": "go-model-check and ts-model-check",
      "failure": "the committed generated clients are not reproducible from the dbspec source"
    },
    {
      "id": "aes.version-column",
      "source": "docs/spec/dbspec.md",
      "checker": "dbspec-go-check, dbspec-php-check, dbspec-ts-check and dbspec-rust-check",
      "failure": "a table whose column has the aes codec stage parses without an aes_version setting naming a non-null integer column"
    },
    {
      "id": "docs.language-pair",
      "source": "docs/**/*.md",
      "checker": "docs-check",
      "failure": "an English Markdown page is missing its adjacent .ko.md translation"
    },
    {
      "id": "docs.translation-shape",
      "source": "docs/**/*.md and docs/**/*.ko.md",
      "checker": "docs-check",
      "failure": "translation headings, code fences, tables, or links differ between the two pages"
    },
    {
      "id": "docs.writing-style",
      "source": "docs/operations/document-rules.md",
      "checker": "docs-rules-check",
      "failure": "configured informal, figurative, personifying, or ambiguous wording appears in a manual",
      "forbidden_ko": [
        "계약",
        "묶임",
        "진술",
        "남처럼",
        "읽힌다",
        "대가",
        "비켜서고",
        "1급",
        "산다",
        "단언",
        "부재",
        "퇴역",
        "죽은",
        "부여",
        "봉투",
        "게이트",
        "붙은",
        "가장자리",
        "이름으로",
        "말한다",
        "돈다",
        "회수",
        "센다",
        "자리에",
        "싣는다",
        "싣고",
        "두지",
        "낸다",
        "답한다",
        "꽂으면",
        "나간다",
        "달고",
        "흘린다",
        "흘려보낸",
        "보낸다",
        "투영",
        "침묵",
        "가리킨다",
        "밝힌다",
        "안다",
        "소속은",
        "고아",
        "입양",
        "뺏다",
        "뺏기",
        "흉내",
        "박다",
        "사건",
        "경계",
        "무는지",
        "물어야",
        "못 박다",
        "잽니다",
        "죽이나",
        "죽이다",
        "재다",
        "놓으라",
        "비싼",
        "유도",
        "덮이고",
        "실어"
      ],
      "forbidden_en": [
        "contract",
        "boundary",
        "gate",
        "envelope",
        "orphan",
        "adopt",
        "pretend",
        "silence",
        "speaks",
        "knows",
        "dies",
        "kills"
      ]
    },
    {
      "id": "tests.language-parity",
      "source": "config/parity.json and contracts/features.json",
      "checker": "parity-check",
      "failure": "a language test file that config/parity.json does not declare, or a parity unit binding that the parity check cannot run"
    },
    {
      "id": "status.evidence",
      "source": "docs/plans/execution/checklist.md",
      "checker": "docs-check",
      "failure": "a checklist item is marked complete without implementation, test, documentation, and publication evidence"
    },
    {
      "id": "git.subject-format",
      "source": "config/commits.json",
      "checker": "commits-check",
      "failure": "a commit of the checked range (RANGE, otherwise HEAD) does not use type(scope): Subject (#id) with a body, or breaks the limits of config/commits.json"
    }
  ]
}
