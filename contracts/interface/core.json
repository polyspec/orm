{
  "comment": "The cases of the members of packages/rust/interface.json that need no database (docs/spec/core.md CORE-70 to CORE-72, CORE-80 to CORE-83), one group per member in the case form of binding G-5: the keys of a case are the parameters of its member, a receiver is an instance value {new, args, then}, a keyed map is a list of [key, value] with the key {int}, and a class result is observed by after. A failure is raises: its kind, its category and its whole message (CORE-12). A value of orm_value is {kind, value} of the kinds null, bool, int (a number, or its decimal text outside the safe integers), float, text, bytes as {hex}, list and map (CORE-62, CORE-63), and the group orm_value holds the cases of the alias: a value that from_host refuses.",
  "db.connect": [
    {
      "id": "no_uri",
      "rule": "CFG-20",
      "dsn": "not a uri",
      "pool_size": 1,
      "cfg": {},
      "raises": {
        "kind": "config",
        "category": "value",
        "message": "config: dsn must be a URI using mysql://, postgres://, sqlite://, or markdown://"
      }
    },
    {
      "id": "unsupported_scheme",
      "rule": "CFG-1",
      "dsn": "oracle://localhost/app",
      "pool_size": 1,
      "cfg": {},
      "raises": {
        "kind": "config",
        "category": "value",
        "message": "config: unsupported DSN scheme \"oracle\"; want mysql, postgres, sqlite, or markdown"
      }
    },
    {
      "id": "fragment",
      "rule": "CFG-20",
      "dsn": "sqlite:///var/app.sqlite#part",
      "pool_size": 1,
      "cfg": {},
      "raises": {
        "kind": "config",
        "category": "value",
        "message": "config: sqlite DSN has a fragment, which no connection reads"
      }
    },
    {
      "id": "sqlite_relative_path",
      "rule": "CFG-11",
      "dsn": "sqlite://app.sqlite",
      "pool_size": 1,
      "cfg": {},
      "raises": {
        "kind": "config",
        "category": "value",
        "message": "config: sqlite DSN must include an absolute database path"
      }
    },
    {
      "id": "idle_size_above_pool_size",
      "rule": "CFG-5",
      "dsn": "sqlite:///var/app.sqlite",
      "pool_size": 2,
      "cfg": {
        "pool_idle_size": 3
      },
      "raises": {
        "kind": "config",
        "category": "value",
        "message": "config: pool idle size must be between 0 and the pool size 2"
      }
    },
    {
      "id": "aes_version_not_declared",
      "rule": "COD-8",
      "dsn": "sqlite:///var/app.sqlite",
      "pool_size": 1,
      "cfg": {
        "aes_version": 2,
        "aes_keys": [
          [
            {
              "int": 1
            },
            "k1"
          ]
        ]
      },
      "raises": {
        "kind": "config",
        "category": "value",
        "message": "config: aes current version is not declared"
      }
    }
  ],
