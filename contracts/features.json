      "title": "In-process planner",
      "title_ko": "프로세스 내 planner",
      "status": "implemented",
      "description": "Validate a value-free request against the manifest and render the dialect SQL, bind slots, and assembly metadata in the client process. The four planners produce identical statements.",
      "description_ko": "값이 없는 request를 manifest로 검증하고 dialect SQL, bind slot, 조립 정보를 client process에서 만든다. 네 planner는 같은 statement를 만든다.",
      "inputs": {
        "type": "RequestIR",
        "fields": [
          "schema_hash",
          "kind",
          "query",
          "set",
          "rows"
        ]
      },
      "outputs": {
        "type": "Plan",
        "fields": [
          "steps",
          "bind_slots",
          "assemble"
        ]
      },
      "state": [
        "validate the request",
        "render the statements",
        "cache the plan by request shape"
      ],
