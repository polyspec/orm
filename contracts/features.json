{
  "manifest_version": 1,
  "contract_version": "0.0.1",
  "source": {
    "read_order": [
      "contracts/features.json",
      "contracts/interfaces.json",
      "docs/protocol.md",
      "docs/dsl.md",
      "docs/features.md"
    ],
    "path_rule": "All paths in this file are repository-relative. Read every referenced fixture, test, document, and verification command before changing a feature."
  },
  "features": [
    {
      "id": "dsn_connection",
      "title": "DSN URI connection",
      "title_ko": "DSN URI 연결",
      "status": "implemented",
      "description": "Open a database from one URI DSN. The URI scheme selects the driver, the timezone parameter sets the connection time zone, and the client plans statements in its own process.",
      "description_ko": "하나의 URI DSN으로 데이터베이스를 연다. URI scheme이 driver를 정하고 timezone 파라미터가 연결 시간대를 정하며, client는 자기 process에서 statement를 계획한다.",
      "inputs": {
        "type": "DsnConnectionRequest",
        "fields": [
          "dsn",
          "connection_options"
        ]
      },
      "outputs": {
        "type": "Db",
        "fields": [
          "connection_pool",
          "planners",
          "plan_cache"
        ]
      },
      "state": [
        "parse DSN scheme and time zone",
        "select native driver",
        "load and check the schema manifest",
        "open connection pool"
      ],
      "errors": [
        {
          "code": "CONFIG",
          "when": "the DSN scheme, the parameters, or a named MySQL time zone is invalid"
        },
        {
          "code": "SCHEMA_HASH_MISMATCH",
          "when": "the generated models come from another schema.json"
        }
      ],
      "clients": {
        "go": "pass",
        "php": "pass",
        "rust": "pass",
        "typescript": "pass"
      },
      "fixtures": [],
      "tests": [
        "clients/go/orm/dsn_test.go",
        "clients/go/orm/timezone_test.go",
        "clients/php/tests/dsn.php",
        "tests/typescript/dsn.mjs",
        "clients/rust/orm/tests/zone.rs"
      ],
      "docs": [
        "docs/config.md",
        "docs/usage.md"
      ],
      "verification": [
        {
          "id": "dsn-go",
          "command": "go test ./clients/go/orm -run 'ParseDSN|ConnectionTimeZone' -count=1"
        },
        {
          "id": "dsn-php",
          "command": "php clients/php/tests/dsn.php"
        },
        {
          "id": "dsn-typescript",
          "command": "npm run typescript:build && node tests/typescript/dsn.mjs"
        },
        {
          "id": "dsn-rust",
          "command": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --manifest-path clients/rust/Cargo.toml --locked -p orm --test zone"
        }
      ]
    },
    {
      "id": "model_queries",
      "title": "Model queries",
      "title_ko": "모델 조회",
      "status": "implemented",
      "description": "Build conditions, joins, relations, columns, subqueries, aggregates, and pages with the generated model methods and read the rows as models and collections.",
      "description_ko": "생성된 모델 메서드로 조건, 조인, 관계, 컬럼, 서브쿼리, 집계, 페이지를 만들고 행을 모델과 컬렉션으로 읽는다.",
      "inputs": {
        "type": "Model",
        "fields": [
          "conditions",
          "joins",
          "relations",
          "columns",
          "order",
          "limit"
        ]
      },
      "outputs": {
        "type": "Collection",
        "fields": [
          "models",
          "keys",
          "fetched_values"
        ]
      },
      "state": [
        "build a value-free request and a parameter list",
        "plan once per request shape",
        "run the main and relation statements",
        "assemble models by position"
      ],
      "errors": [
        {
          "code": "CONFIG",
          "when": "the chain is incomplete or the model has no connection outside a transaction"
        },
        {
          "code": "IR_INVALID",
          "when": "the request shape is invalid"
        },
        {
          "code": "EMPTY_IN",
          "when": "an IN list is empty"
        }
      ],
      "clients": {
        "go": "pass",
        "php": "pass",
        "rust": "pass",
        "typescript": "pass"
      },
      "fixtures": [
        "tests/conformance/vectors.json"
      ],
      "tests": [
        "clients/go/model/model_test.go",
        "clients/php/tests/model_test.php",
        "tests/typescript/model.mjs",
        "clients/rust/tests/src/integration.rs",
        "engine/engine_test.go"
      ],
      "docs": [
        "docs/dsl.md",
        "docs/usage.md",
        "docs/protocol.md"
      ],
      "verification": [
        {
          "id": "queries-go",
          "command": "go test ./clients/go/model -run 'Conditions|JoinsAndRelations|ColumnsAndSubqueries' -count=1"
        },
        {
          "id": "queries-php",
          "command": "php clients/php/tests/model_test.php"
        },
        {
          "id": "queries-typescript",
          "command": "npm run typescript:build && node tests/typescript/model.mjs"
        }
      ]
    },
    {
      "id": "model_writes",
      "title": "Model writes",
      "title_ko": "모델 쓰기",
      "status": "implemented",
      "description": "Create, create many, update with optional optimistic locking, save, and delete with optional recursive relation deletion, including the duplication assignments of an upsert.",
      "description_ko": "생성, 다건 생성, 선택적 낙관적 잠금 갱신, 저장, 선택적 관계 재귀 삭제를 수행하며 upsert의 duplication 할당을 포함한다.",
      "inputs": {
        "type": "Model",
        "fields": [
          "sets",
          "plus_minus",
          "raw_sets",
          "duplication"
        ]
      },
      "outputs": {
        "type": "Model",
        "fields": [
          "stored_row",
          "affected_rows"
        ]
      },
      "state": [
        "assign values and timestamps",
        "encrypt AES columns with the current key version",
        "run the write statement",
        "return the stored row"
      ],
      "errors": [
        {
          "code": "OPTIMISTIC_LOCK",
          "when": "an optimistic update matched no row"
        },
        {
          "code": "DUPLICATE_KEY",
          "when": "an insert conflicts with a unique key"
        },
        {
          "code": "FOREIGN_KEY",
          "when": "a write breaks a foreign key"
        }
      ],
      "clients": {
        "go": "pass",
        "php": "pass",
        "rust": "pass",
        "typescript": "pass"
      },
      "fixtures": [
        "tests/conformance/vectors.json"
      ],
      "tests": [
        "clients/go/model/model_test.go",
        "clients/php/tests/model_test.php",
        "tests/typescript/model.mjs",
        "clients/rust/tests/src/integration.rs"
      ],
      "docs": [
        "docs/dsl.md",
        "docs/usage.md"
      ],
      "verification": [
        {
          "id": "writes-go",
          "command": "go test ./clients/go/model -run 'Writes' -count=1"
        }
      ]
    },
    {
      "id": "transactions",
      "title": "Transactions",
      "title_ko": "트랜잭션",
      "status": "implemented",
      "description": "Run a callback in a transaction shared by the current execution flow, with savepoints for nested calls, deadlock retry, isolation, read-only mode, timeoutMs, row locks, named locks, and transaction-local values.",
      "description_ko": "현재 실행 흐름이 공유하는 트랜잭션에서 콜백을 실행한다. 중첩 호출은 savepoint를 쓰고, 교착 재시도, 격리 수준, 읽기 전용, timeoutMs, 행 잠금, 이름 잠금, 트랜잭션 지역 값을 제공한다.",
      "inputs": {
        "type": "TransactionRequest",
        "fields": [
          "callback",
          "isolation",
          "read_only",
          "timeout_ms",
          "retry"
        ]
      },
      "outputs": {
        "type": "TransactionResult",
        "fields": [
          "callback_result"
        ]
      },
      "state": [
        "begin or create a savepoint",
        "run models without a connection in the flow transaction",
        "commit or roll back",
        "retry on deadlock"
      ],
      "errors": [
        {
          "code": "CONFIG",
          "when": "a row lock or named lock runs outside a transaction, or the transaction connection is used concurrently"
        },
        {
          "code": "DEADLOCK",
          "when": "the retries are exhausted"
        },
        {
          "code": "CAPABILITY_UNSUPPORTED",
          "when": "the dialect rejects an option"
        }
      ],
      "clients": {
        "go": "pass",
        "php": "pass",
        "rust": "pass",
        "typescript": "pass"
      },
      "fixtures": [],
      "tests": [
        "clients/go/model/model_test.go",
        "clients/go/orm/cancel_test.go",
        "clients/php/tests/model_test.php",
        "tests/typescript/model.mjs",
        "clients/rust/orm/tests/zone.rs",
        "clients/rust/tests/src/integration.rs"
      ],
      "docs": [
        "docs/config.md",
        "docs/dsl.md",
        "docs/errors.yaml"
      ],
      "verification": [
        {
          "id": "transactions-go",
          "command": "go test ./clients/go/model -run 'Transactions' -count=1"
        }
      ],
      "public_constraints": [
        "The chain declares no cancellation operation: a flow cancels through the host language primitive on a connection handle (Go WithContext, TypeScript withSignal, Rust dropping the statement future), and a cancelled statement returns CANCELED.",
        "PHP cancellation is not implemented yet.",
        "The interface manifest prohibits query_cancel, transaction_cancel, and in_flight_cancellation symbols."
      ]
    },
    {
      "id": "model_generation",
      "title": "Model generation",
      "title_ko": "모델 생성",
      "status": "implemented",
      "description": "Generate the models from schema.json with the generator of each language. Go and Rust scan the sources and generate the chain methods they call; PHP resolves chains at run time and TypeScript types the scanned chains.",
      "description_ko": "언어별 생성기로 schema.json에서 모델을 만든다. Go와 Rust는 소스를 읽어 호출한 체인 메서드를 만들고, PHP는 실행 시 체인을 해석하며 TypeScript는 읽은 체인에 타입을 붙인다.",
      "inputs": {
        "type": "GeneratorRequest",
        "fields": [
          "schema_json",
          "output",
          "scan_paths"
        ]
      },
      "outputs": {
        "type": "GeneratedModels",
        "fields": [
          "models",
          "chain_methods",
          "schema_hash"
        ]
      },
      "state": [
        "load schema.json and check its hash",
        "scan calls",
        "reject names outside the chain rules",
        "write the models"
      ],
      "errors": [
        {
          "code": "CONFIG",
          "when": "a called name does not follow the chain rules or a column name is reserved"
        },
        {
          "code": "SCHEMA_INVALID",
          "when": "schema.json was edited by hand"
        }
      ],
      "clients": {
        "go": "pass",
        "php": "pass",
        "rust": "pass",
        "typescript": "pass"
      },
      "fixtures": [],
      "tests": [
        "internal/ormgen/gen_go_test.go",
        "clients/php/tests/engine_test.php",
        "tests/typescript/generate.mjs",
        "clients/rust/orm-build/tests/generate.rs"
      ],
      "docs": [
        "docs/dsl.md",
        "docs/usage.md"
      ],
      "verification": [
        {
          "id": "generation-go",
          "command": "go test ./internal/ormgen -run 'Gen' -count=1 && cd clients/go/model && go generate ./ && git diff --exit-code -- ."
        },
        {
          "id": "generation-typescript",
          "command": "npm run typescript:build && node tests/typescript/generate.mjs"
        },
        {
          "id": "generation-rust",
          "command": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --manifest-path clients/rust/Cargo.toml --locked -p orm-build"
        }
      ]
    },
    {
      "id": "schema_definition",
      "title": "Schema definition and migration",
      "title_ko": "스키마 정의와 마이그레이션",
      "status": "implemented",
      "description": "Build schema.json from Mermaid diagrams, render DDL for each dialect, import a database into a diagram, and compare two manifests into forward and rollback migrations.",
      "description_ko": "Mermaid 다이어그램에서 schema.json을 만들고, dialect별 DDL을 렌더링하며, 데이터베이스를 다이어그램으로 가져오고, 두 manifest를 비교해 forward와 rollback migration을 만든다.",
      "inputs": {
        "type": "SchemaDocument",
        "fields": [
          "entities",
          "relations",
          "indexes",
          "checks",
          "comments",
          "renames"
        ]
      },
      "outputs": {
        "type": "SchemaManifest",
        "fields": [
          "schema_hash",
          "entities",
          "ddl",
          "migration"
        ]
      },
      "state": [
        "parse diagrams",
        "validate names, keys, and relations",
        "compute the schema hash",
        "render DDL or migration statements"
      ],
      "errors": [
        {
          "code": "SCHEMA_INVALID",
          "when": "a diagram breaks a schema rule"
        },
        {
          "code": "CONFIG",
          "when": "a command argument or database connection is invalid"
        }
      ],
      "clients": {
        "go": "pass",
        "php": "pass",
        "rust": "pass",
        "typescript": "pass"
      },
