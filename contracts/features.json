        "clients/php/tests/schema_db_test.php",
        "clients/rust/orm-build/tests/schema_cases.rs",
        "clients/rust/orm-build/tests/tools.rs",
        "clients/rust/orm-build/tests/cli.rs",
        "tests/typescript/schema-cases.mjs",
        "tests/typescript/schema-tools.mjs"
      ],
      "docs": [
        "docs/schema.md",
        "docs/dialects.md"
      ],
      "verification": [
        {
          "id": "schema-go",
          "command": "go test ./engine/schema ./internal/ormgen -count=1"
        },
        {
          "id": "schema-php",
          "command": "php clients/php/tests/schema_test.php && php clients/php/tests/schema_tool_test.php && php clients/php/tests/schema_db_test.php"
        },
        {
          "id": "schema-rust",
          "command": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --manifest-path clients/rust/Cargo.toml --locked -p orm-build --features cli"
        },
        {
          "id": "schema-typescript",
          "command": "npm run typescript:build && node tests/typescript/schema-cases.mjs && node tests/typescript/schema-tools.mjs"
        }
      ]
