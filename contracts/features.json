    {
      "id": "authenticated_encryption",
      "title": "Authenticated encryption",
      "title_ko": "인증 암호화",
      "status": "implemented",
      "description": "Encode authenticated versioned AES values and blind indexes, read mixed key versions, and rotate every encrypted column of a table in batches.",
      "description_ko": "인증과 버전이 있는 AES 값과 blind index를 인코딩하고, 섞인 key version을 읽으며, 테이블의 모든 암호화 컬럼을 배치로 회전한다.",
      "inputs": {
        "type": "AESKeyring",
        "fields": [
          "versions",
          "current_version"
        ]
      },
      "outputs": {
        "type": "AESRotationStatus",
        "fields": [
          "current",
          "total",
          "pending",
          "versions"
        ]
      },
      "state": [
        "encrypt with the current version",
        "decrypt by the stored version",
        "rewrite stale rows in batches"
      ],
      "errors": [
        {
          "code": "CONFIG",
          "when": "a key version is missing"
        },
        {
          "code": "CODEC_UNSUPPORTED",
          "when": "a value cannot be decoded"
        }
      ],
      "clients": {
        "go": "pass",
        "php": "pass",
        "rust": "pass",
        "typescript": "pass"
      },
