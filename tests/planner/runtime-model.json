    {
      "id": "i16-field-accepts-plus",
      "requirements": [
        "DBS-112"
      ],
      "steps": [
        {
          "op": "planner.compile",
          "schema": "runtime-model.dbs",
          "input": {
            "ir_version": 1,
            "entity": "note",
            "kind": "update",
            "n_params": 2,
            "set": [
              {
                "column": "rank",
                "plus_p": 0
              }
            ],
            "where": {
              "items": [
                {
                  "pred": {
                    "column": "id",
                    "op": "eq",
                    "p": 1
                  }
                }
              ]
            }
          },
          "expect": {
            "none": {
              "value": {
                "mysql": [
                  {
                    "role": "main",
                    "sql": "UPDATE `note` SET `rank` = `note`.`rank` + ? WHERE `note`.`id` = ?",
                    "slots": [
                      {
                        "from": "param",
                        "param": 0,
                        "type": "i16"
                      },
                      {
                        "from": "param",
                        "param": 1,
                        "type": "i64"
                      }
                    ],
                    "tables": [
                      "note"
                    ]
                  }
                ],
                "postgres": [
                  {
                    "role": "main",
                    "sql": "UPDATE \"note\" SET \"rank\" = \"note\".\"rank\" + $1 WHERE \"note\".\"id\" = $2",
                    "slots": [
                      {
                        "from": "param",
                        "param": 0,
                        "type": "i16"
                      },
                      {
                        "from": "param",
                        "param": 1,
                        "type": "i64"
                      }
                    ],
                    "tables": [
                      "note"
                    ]
                  }
                ],
                "sqlite": [
                  {
                    "role": "main",
                    "sql": "UPDATE \"note\" SET \"rank\" = \"note\".\"rank\" + ? WHERE \"note\".\"id\" = ?",
                    "slots": [
                      {
                        "from": "param",
                        "param": 0,
                        "type": "i16"
                      },
                      {
                        "from": "param",
                        "param": 1,
                        "type": "i64"
                      }
                    ],
                    "tables": [
                      "note"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
