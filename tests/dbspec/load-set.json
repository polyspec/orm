        {
          "op": "dbspec.load_set",
          "owned": [
            "dbspec 1 shop",
            "",
            "use core { account }",
            "",
            "table item {",
            "  seq i64",
            "  account_seq i64",
            "  primary key (seq)",
            "  index ix_item_account (account_seq)",
            "  foreign key fk_item_account (account_seq) references account (seq) on delete restrict on update restrict",
            "}"
          ],
          "external": [
            "dbspec 1 core",
            "",
            "table account {",
            "  seq i64",
            "  primary key (seq)",
            "}"
          ],
          "expect": {
            "none": {
              "documents": [
                {
                  "name": "shop",
                  "external": false
                },
                {
                  "name": "core",
                  "external": true
                }
              ]
            }
          }
        }
      ]
    },
