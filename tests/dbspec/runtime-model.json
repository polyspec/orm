{
  "$schema": "../../scripts/features/schema/recipe.schema.json",
  "requirements": [
    "DBS-65",
    "DBS-85",
    "DBS-111",
    "DBS-112"
  ],
  "cases": [
    {
      "id": "entities-of-a-document",
      "requirements": [
        "DBS-111",
        "DBS-112"
      ],
      "steps": [
        {
          "op": "dbspec.runtime_model",
          "documents": [
            "../../contracts/fixtures/bench/bench.dbs"
          ],
          "expect": {
            "none": {
              "entities": [
                "author",
                "user",
                "service",
                "service_region",
                "service_member",
                "composite_account",
                "composite_membership",
                "soft_record",
                "soft_link",
                "account",
                "project",
                "account_project",
                "task",
                "hex_cell",
                "time_cell",
                "clock_cell",
                "day_cell",
                "upsert_cell",
                "uuid_cell",
                "ip_hex_cell",
                "bind_cell",
                "audit_record",
                "audited_note",
                "audited_note_history"
              ],
              "models": {
                "author": {
                  "table": "author",
                  "primary_key": [
                    "seq"
                  ],
                  "identity": "seq",
                  "updated": "updated_ts",
                  "soft_delete": "",
                  "aes_version": "aes_key_version",
                  "audit_column": "",
                  "fields": {
                    "seq": {
                      "type": "i64",
                      "nullable": false,
                      "primary_key": true
                    },
                    "price": {
                      "type": "decimal",
                      "nullable": true
                    },
                    "created_ts": {
                      "default": true,
                      "default_now": true
                    },
                    "is_close": {
                      "default": true,
                      "default_now": false
                    },
                    "user_seq": {
                      "default": false,
                      "foreign_key": true
                    },
                    "name": {
                      "foreign_key": false,
                      "codec": []
                    },
                    "aes_hex_email": {
                      "codec": [
                        "aes",
                        "hex"
                      ],
                      "blind_index": "email_blind_index"
                    },
                    "json_setting": {
                      "codec": [
                        "ordered_json"
                      ]
                    },
                    "gz_extend": {
                      "codec": [
                        "gz"
                      ]
                    }
                  },
                  "key_names": [
                    "ik",
                    "ix_author_service_member",
                    "ix_email_blind_index",
                    "ix_phone_blind_index",
                    "ix_service",
                    "ix_user",
                    "uq_author_uuid"
                  ]
                },
                "composite_membership": {
                  "primary_key": [
                    "tenant_id",
                    "account_id"
                  ],
                  "identity": ""
                },
                "soft_record": {
                  "soft_delete": "deleted_at"
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "entities-of-a-set-and-their-settings",
      "requirements": [
        "DBS-65",
        "DBS-85",
        "DBS-111",
        "DBS-112"
      ],
      "steps": [
        {
          "op": "dbspec.runtime_model",
          "documents": [
            "runtime-model-shop.dbs",
            "../../contracts/fixtures/audit.dbs"
          ],
          "expect": {
            "none": {
              "entities": [
                "item",
                "item_history",
                "audit",
                "member",
                "member_history",
                "member_record"
              ],
              "models": {
                "member": {
                  "table": "service_member",
                  "audit_column": "audit_seq",
                  "audit_record": "member_audit",
                  "fields": {
                    "rank": {
                      "type": "i16"
                    },
                    "key": {
                      "type": "uuid"
                    },
                    "opens": {
                      "type": "time"
                    }
                  }
                },
                "item": {
                  "audit_column": "audit_seq",
                  "audit_record": "audit"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
