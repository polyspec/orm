{
  "version": 1,
  "note": "export cases write the Mermaid lines and the dropped objects [kind, table, name] of their document; import cases read their Mermaid lines into the document named imported and the dropped objects; invalid cases report exactly the listed [rule, line, column] diagnostics. Lines join with LF and end with one. docs/mermaid.md.",
  "export": [
    {
      "document": [
        "dbspec 1 shop",
        "",
        "# accounts",
        "table users {",
        "  id i64 identity",
        "  mail varchar(64)",
        "  age i32 null",
        "  note varchar(32) null default 'say \"hi\"'",
        "  primary key (id)",
        "  unique uq_users_mail (mail)",
        "  check ck_users_age (age >= 0)",
        "  settings {",
        "    immutable",
        "  }",
        "}",
        "",
        "table orders {",
        "  id i64 identity",
        "  user_id i64 null",
        "  total decimal(10,2) default 0.00",
        "  primary key (id)",
        "  index ix_orders_user (user_id)",
        "  foreign key fk_orders_user (user_id) references users (id) on delete set_null on update restrict",
        "}"
      ],
      "dropped": [
        [
          "foreign_key",
          "orders",
          "fk_orders_user"
        ],
        [
          "index",
          "orders",
          "ix_orders_user"
        ],
        [
          "check",
          "users",
          "ck_users_age"
        ],
        [
          "comment",
          "users",
          "users"
        ],
        [
          "default",
          "users",
          "note"
        ],
        [
          "settings",
          "users",
          "users"
        ],
        [
          "unique",
          "users",
          "uq_users_mail"
        ]
      ],
      "id": "shop",
      "mermaid": [
        "erDiagram",
        "    orders {",
        "        i64 id PK \"identity\"",
        "        i64 user_id FK \"null\"",
        "        decimal(10-2) total \"default 0.00\"",
        "    }",
        "    users {",
        "        i64 id PK \"identity\"",
        "        varchar(64) mail UK",
        "        i32 age \"null\"",
        "        varchar(32) note \"null\"",
        "    }",
        "    users |o--o{ orders : \"fk_orders_user (user_id) references (id)\""
      ]
    }
