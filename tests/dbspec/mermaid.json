        "    order_line {",
        "        i64 id PK",
        "        i64 customer_id FK",
        "        decimal(8-2) price \"default 1.50\"",
        "    }",
        "    customer ||--o{ order_line : places",
        "    order_line }o--|| customer : \"fk_line_customer (customer_id) references (id)\"",
