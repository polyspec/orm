          "dialects": [
            "sqlite"
          ],
          "query": "SELECT at || '' FROM w",
          "want": "10:20:30.000"
        },
        {
          "dialects": [
            "sqlite"
          ],
          "query": "SELECT stamp || '' FROM w",
          "want": "2026-01-02 03:04:05.000000"
