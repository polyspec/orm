{
  "version": 1,
  "note": "The database data of each case of plan-cases.json, keyed by case id: before runs before the plan steps, after runs after them (docs/spec/plans.md, physical run). The source and plan of the case are the dbspec.parse and dbspec.parse_plan steps of plan-cases.json.",
  "cases": {
    "create-from-empty": {
      "before": [],
