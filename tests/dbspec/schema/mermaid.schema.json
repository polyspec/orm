{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tests/dbspec/mermaid.json",
  "description": "The Mermaid vectors: documents exported to Mermaid with what the export drops, Mermaid diagrams imported to documents, invalid diagrams with their errors, and round trips of a document file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "note",
    "export",
    "import",
    "invalid",
    "round_trip"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "export": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "document",
          "documents",
          "mermaid",
          "dropped"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "document": {
            "$ref": "#/$defs/lines"
          },
          "documents": {
            "$ref": "#/$defs/documents"
          },
          "mermaid": {
            "$ref": "#/$defs/lines"
          },
          "dropped": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "minItems": 3,
              "maxItems": 3,
              "items": false
            }
          }
        }
      }
    },
    "import": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mermaid",
          "document",
          "dropped"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mermaid": {
            "$ref": "#/$defs/lines"
          },
          "document": {
            "$ref": "#/$defs/lines"
          },
          "dropped": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "minItems": 3,
              "maxItems": 3,
              "items": false
            }
          }
        }
      }
    },
    "invalid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mermaid",
          "errors"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mermaid": {
            "$ref": "#/$defs/lines"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "minItems": 3,
              "maxItems": 3,
              "items": false
            }
          }
        }
      }
    },
    "round_trip": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "imported",
          "dropped"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "imported": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "minItems": 3,
              "maxItems": 3,
              "items": false
            }
          },
          "dropped": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "minItems": 3,
              "maxItems": 3,
              "items": false
            }
          }
        }
      }
    }
  },
  "$defs": {
    "lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/lines"
      }
    }
  }
}
