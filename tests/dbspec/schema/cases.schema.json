{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tests/dbspec/cases.json",
  "description": "The shared dbspec vectors that every implementation reads: the hashes and the document sets. Every section has at least one case, and a section or field the format does not name is refused. The canonical, normalize, invalid, positions and files cases are recipes in the sibling *.json files; tests/dbspec/cases.mts checks what this schema cannot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirements",
    "version",
    "note",
    "hashes",
    "sets"
  ],
  "properties": {
    "requirements": {
      "description": "The requirement ids of docs/spec that the cases of each section test, read by the parity check of @polyspec/kit (R15) and by no runner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hashes",
        "sets"
      ],
      "properties": {
        "hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]+$"
          }
        },
        "sets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]+$"
          }
        }
      }
    },
    "version": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "documents",
          "manifestText",
          "schemaText",
          "manifestHash",
          "schemaHash"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "documents": {
            "$ref": "#/$defs/linesMap"
          },
          "manifestText": {
            "$ref": "#/$defs/lines"
          },
          "schemaText": {
            "$ref": "#/$defs/lines"
          },
          "manifestHash": {
            "type": "string"
          },
          "schemaHash": {
            "type": "string"
          }
        }
      }
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "documents",
          "parsing",
          "errors"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/lines"
            }
          },
          "parsing": {
            "$ref": "#/$defs/linesMap"
          },
          "errors": {
            "$ref": "#/$defs/errors"
          },
          "external": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/lines"
            }
          },
          "manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manifestText",
              "externalText",
              "schemaText",
              "created",
              "manifestHash",
              "schemaHash"
            ],
            "properties": {
              "manifestText": {
                "$ref": "#/$defs/lines"
              },
              "externalText": {
                "$ref": "#/$defs/lines"
              },
              "schemaText": {
                "$ref": "#/$defs/lines"
              },
              "created": {
                "$ref": "#/$defs/lines"
              },
              "manifestHash": {
                "type": "string"
              },
              "schemaHash": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linesMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/lines"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "column",
          "rule"
        ],
        "properties": {
          "line": {
            "type": "integer"
          },
          "column": {
            "type": "integer"
          },
          "rule": {
            "type": "string"
          }
        }
      }
    }
  }
}
