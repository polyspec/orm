        {
          "op": "dbspec.parse_positions",
          "text": [
            "dbspec 1 wiki",
            "",
            "table page {",
            "  id varchar(64)",
            "  title varchar(191)",
            "  body text",
            "  sort_order i32",
            "  state varchar(16)",
            "  primary key (id)",
            "  settings {",
            "    markdown body",
            "    store files",
            "    key_prefix 'page-'",
            "    title title",
            "    body body",
            "    order sort_order",
            "    checkbox state todo '.'",
            "    checkbox state doing '~'",
            "    checkbox state done 'x'",
            "    state_machine state initial todo",
            "    state_machine state todo -> doing",
            "    state_machine state doing -> done require (sort_order)",
            "    state_machine state terminal done",
            "    state_machine state history page_history row page_id from from_state to to_state at changed_at",
            "    state_machine state limit doing 3",
            "  }",
            "}",
            "",
            "table page_history {",
            "  history_id i64 identity",
            "  page_id varchar(64)",
            "  from_state varchar(16)",
            "  to_state varchar(16)",
            "  changed_at datetime(6)",
            "  sort_order i32 null",
            "  primary key (history_id)",
            "  index ix_page_history_page (page_id)",
            "  foreign key fk_page_history_page (page_id) references page (id) on delete restrict on update restrict",
            "}",
            "",
            "table section {",
            "  id varchar(64)",
            "  page_id varchar(64)",
            "  body text",
            "  primary key (id)",
            "  index ix_section_page (page_id)",
            "  foreign key fk_section_page (page_id) references page (id) on delete restrict on update restrict",
            "  settings {",
            "    store block fk_section_page list",
            "  }",
            "}",
            "",
            "table ledger {",
            "  id varchar(64)",
            "  amount i64",
            "  primary key (id)",
            "  settings {",
            "    store document table",
            "  }",
            "}"
