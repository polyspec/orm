{
  "version": 1,
  "note": "The native cases of the PHP generator, which the PHP extension runs too (docs/spec/feature-coverage.md FCV-2). Each case calls methods on one model of contracts/fixtures/bench/dbspec-set.json (calls: name and argument count). expected.declared lists exactly the @method tags the generator writes beyond the schema, with expected.types the type of a tag; expected.rejected is the text of the CONFIG error, which names the call in its PHP spelling. receiver is the PHP expression the calls are made on instead of $m ({model} is the model); chain true makes the calls as one chain on it. The chain names that every generator takes are the scanned- cases of contracts/fixtures/generator/generator.json.",
  "cases": [
    { "id": "scanned-calls-declare-exactly-their-tags", "operation": "scan", "model": "Author", "calls": [], "body": "$m->ltSeq(1);\n$m->geReadCount(1);\n$m->lkName(1);\n$m->neIsClose(1);\n$m->andLtSeq(1);\n$m->orIsClose(1);\n$m->andReadCount(1);\n$m->seqAndName(1, 1);\n$m->isCloseOrReadCount(1, 1);\n$m->betweenReadCount(1);\n$m->gtStartDt(1, 1);\n$m->startDtLtEndDt(1);\n$m->getsBySeqAndIsClose(1, 1);\n$m->getBySeq(1);\n$m->getCountByServiceSeq(1);\n$m->orderBySeqDescAndNameAsc();\n$m->joinUserSeqWithSeq(1);\n$m->leftJoinServiceSeqWithSeq(1);\n$m->matchUserSeqWithSeq();\n$m->aliasMine();\n$m->newExtra(1);\n$m->getExtra();\n$m->possibleSeq(1);\n$m->addColumnTotal(fn(): int => 1);\n$m->tupleUserSeqWithServiceSeq(1);\n(new Author())->andGeReadCount(1)->orNeIsClose(1);\n", "expected": { "declared": ["addColumnTotal", "aliasMine", "andGeReadCount", "andLtSeq", "andReadCount", "betweenReadCount", "geReadCount", "getBySeq", "getCountByServiceSeq", "getExtra", "getsBySeqAndIsClose", "gtStartDt", "isCloseOrReadCount", "joinUserSeqWithSeq", "leftJoinServiceSeqWithSeq", "lkName", "ltSeq", "matchUserSeqWithSeq", "neIsClose", "newExtra", "orIsClose", "orNeIsClose", "orderBySeqDescAndNameAsc", "possibleSeq", "seqAndName", "startDtLtEndDt", "tupleUserSeqWithServiceSeq"] } },
    { "id": "schema-methods-are-not-redeclared", "operation": "scan", "model": "Author", "calls": [{ "name": "seq", "args": 1 }, { "name": "addColumnName", "args": 0 }, { "name": "orderBySeqAsc", "args": 0 }, { "name": "getSeq", "args": 0 }, { "name": "gets", "args": 0 }], "expected": { "declared": [] } },
    { "id": "unknown-column", "operation": "scan", "model": "Author", "calls": [{ "name": "ltNoSuchColumn", "args": 1 }], "expected": { "rejected": "Author.ltNoSuchColumn" } },
    { "id": "unknown-operator", "operation": "scan", "model": "Author", "calls": [{ "name": "xyzSeq", "args": 1 }], "expected": { "rejected": "Author.xyzSeq" } },
    { "id": "operator-not-for-the-column", "operation": "scan", "model": "Author", "calls": [{ "name": "lkSeq", "args": 1 }], "expected": { "rejected": "Author.lkSeq" } },
    { "id": "unknown-finder-column", "operation": "scan", "model": "Author", "calls": [{ "name": "getsByNoSuch", "args": 1 }], "expected": { "rejected": "Author.getsByNoSuch" } },
    { "id": "order-without-direction", "operation": "scan", "model": "Author", "calls": [{ "name": "orderBySeqAndName", "args": 0 }], "expected": { "rejected": "Author.orderBySeqAndName" } },
    { "id": "get-without-a-named-value", "operation": "scan", "model": "Author", "calls": [{ "name": "getNothing", "args": 0 }], "expected": { "rejected": "Author.getNothing" } },
    { "id": "invoked-new-receiver", "operation": "scan", "model": "Author", "receiver": "(new {model})($db)", "calls": [{ "name": "ltSeq", "args": 1 }, { "name": "andLkName", "args": 1 }], "expected": { "declared": ["andLkName", "ltSeq"] } },
    { "id": "invoked-new-receiver-chain", "operation": "scan", "model": "Author", "receiver": "(new {model})($db)", "chain": true, "calls": [{ "name": "andLtSeq", "args": 1 }, { "name": "orGeReadCount", "args": 1 }, { "name": "lkName", "args": 1 }], "expected": { "declared": ["andLtSeq", "lkName", "orGeReadCount"] } },
    { "id": "too-few-arguments", "operation": "scan", "model": "Author", "calls": [{ "name": "ltSeq", "args": 0 }], "expected": { "rejected": "Author.ltSeq takes 1 argument" } },
    { "id": "too-many-arguments", "operation": "scan", "model": "Author", "calls": [{ "name": "seqAndName", "args": 3 }], "expected": { "rejected": "Author.seqAndName takes 2 arguments" } },
    { "id": "join-needs-the-child", "operation": "scan", "model": "Author", "calls": [{ "name": "joinUserSeqWithSeq", "args": 0 }], "expected": { "rejected": "Author.joinUserSeqWithSeq takes 1 argument" } },
    {"id": "getter-type-new-literal", "operation": "scan", "model": "Author", "calls": [], "body": "$m->newExtra(42);\n$m->getExtra();\n", "expected": {"declared": ["getExtra", "newExtra"], "types": {"getExtra": "int"}}},
    {"id": "getter-type-new-parameter", "operation": "scan", "model": "Author", "calls": [], "body": "function f(Author $m, string $title): void\n{\n    $m->newTitle($title);\n}\n$m->getTitle();\n", "expected": {"declared": ["getTitle", "newTitle"], "types": {"getTitle": "string"}}},
    {"id": "getter-type-addcolumn-closure", "operation": "scan", "model": "Author", "calls": [], "body": "$m->addColumnTotal(fn(): int => 1);\n$m->getTotal();\n", "expected": {"declared": ["addColumnTotal", "getTotal"], "types": {"getTotal": "int"}}},
    {"id": "getter-type-addcolumn-untyped-rejected", "operation": "scan", "model": "Author", "calls": [], "body": "$m->addColumnTotal(fn($row) => 1);\n", "expected": {"rejected": "addColumnTotal"}},
    {"id": "getter-type-relation-model", "operation": "scan", "model": "Author", "calls": [], "body": "$m->getAuthorModel();\n$m->getAuthorModels();\n", "expected": {"declared": ["getAuthorModel", "getAuthorModels"], "types": {"getAuthorModel": "?Author", "getAuthorModels": "\\Polyspec\\Orm\\Collection<Author>"}}},
    {"id": "getter-type-relation-alias-cardinality", "operation": "scan", "model": "Author", "calls": [], "body": "$m->relation((new \\Polyspec\\Orm\\Tests\\Scanned\\User())->matchUserSeqWithSeq()->aliasWriter())->gets();\n$m->getWriter();\n$m->relations((new \\Polyspec\\Orm\\Tests\\Scanned\\ServiceMember())->matchServiceSeqWithServiceSeq()->aliasMembers())->get();\n$m->getMembers();\n", "expected": {"declared": ["getMembers", "getWriter"], "types": {"getMembers": "\\Polyspec\\Orm\\Collection<ServiceMember>", "getWriter": "?User"}}}
  ]
}
