{
    "name": "polyspec/orm-release-consumer",
    "description": "A project that installs polyspec/orm from the release zips",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "polyspec/orm": "0.0.17",
        "polyspec/ordered-json": "0.0.9"
    },
    "repositories": [
        {
            "type": "artifact",
            "url": "artifacts"
        },
        {
            "type": "package",
            "package": {
                "name": "polyspec/ordered-json",
                "version": "0.0.9",
                "type": "library",
                "require": {
                    "php": ">=8.5",
                    "ext-json": "*",
                    "ext-pcre": "*"
                },
                "suggest": {
                    "ext-ordered_json": "Native backend from the polyspec/ordered-json-extension PIE package"
                },
                "autoload": {
                    "psr-4": {
                        "Polyspec\\OrderedJson\\": "src/"
                    },
                    "files": [
                        "src/OrderedJson.php"
                    ]
                },
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/polyspec/ordered-json/releases/download/v0.0.9/polyspec-ordered-json-php-0.0.9.zip",
                    "shasum": "5f93a2c0df5967163801cb3d4d087e44834bb456"
                }
            }
        }
    ],
    "config": {
        "platform": {
            "php": "8.5.0"
        }
    }
}
