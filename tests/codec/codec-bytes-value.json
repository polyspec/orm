{
  "$schema": "../../scripts/features/schema/recipe.schema.json",
  "requirements": [
    "COD-63",
    "COD-70"
  ],
  "cases": [
    {
      "id": "bytes_under_value_stages",
      "requirements": [
        "COD-63",
        "COD-70"
      ],
      "steps": [
        {
          "op": "codec.encode",
          "styles": [
            "json"
          ],
          "value": {
            "bytes_hex": "00ff"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: json: the value is not a JSON value"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "json"
          ],
          "value": {
            "array": [
              {
                "int": "1"
              },
              {
                "bytes_hex": "00ff"
              }
            ]
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: json: the value is not a JSON value"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "serialize"
          ],
          "value": {
            "bytes_hex": "00ff"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: serialize: the value is not a codec value"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "yaml"
          ],
          "value": {
            "bytes_hex": "00ff"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: yaml: the value is not a codec value"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "serialize"
          ],
          "value": {
            "array": [
              {
                "int": "1"
              },
              {
                "bytes_hex": "00ff"
              }
            ]
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: serialize: the value is not a codec value"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "yaml"
          ],
          "value": {
            "object": [
              [
                "a",
                {
                  "bytes_hex": "00ff"
                }
              ]
            ]
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: yaml: the value is not a codec value"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "gz"
          ],
          "value": {
            "bytes_hex": "00ff"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: a first gz stage takes a string value"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "base64"
          ],
          "value": {
            "bytes_hex": "00ff"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: a first base64 stage takes a string value"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [],
          "value": {
            "bytes_hex": "00ff"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: an empty stage list takes a string value"
            }
          }
        }
      ]
    }
  ]
}
