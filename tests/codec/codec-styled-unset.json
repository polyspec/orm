{
  "$schema": "../../scripts/features/schema/recipe.schema.json",
  "requirements": [
    "COD-70"
  ],
  "cases": [
    {
      "id": "styled_value_unset",
      "requirements": [
        "COD-70"
      ],
      "steps": [
        {
          "op": "codec.encode",
          "styles": [
            "json"
          ],
          "value": {
            "styled_unset": true
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: styled value is unset"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "serialize"
          ],
          "value": {
            "styled_unset": true
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: styled value is unset"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "yaml"
          ],
          "value": {
            "styled_unset": true
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: styled value is unset"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "gz"
          ],
          "value": {
            "styled_unset": true
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: styled value is unset"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "base64"
          ],
          "value": {
            "styled_unset": true
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: styled value is unset"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [],
          "value": {
            "styled_unset": true
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: styled value is unset"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "unknown"
          ],
          "value": {
            "styled_unset": true
          },
          "expect": {
            "none": {
              "error": "codec_unsupported",
              "message": "codec_unsupported: style unknown"
            }
          }
        }
      ]
    }
  ]
}
