{
  "$schema": "../../scripts/features/schema/recipe.schema.json",
  "requirements": [
    "COD-16",
    "COD-70"
  ],
  "cases": [
    {
      "id": "non_finite_under_value_stages",
      "requirements": [
        "COD-16",
        "COD-70"
      ],
      "steps": [
        {
          "op": "codec.encode",
          "styles": [
            "json"
          ],
          "value": {
            "f64": "NaN"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: json: non-finite number"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "json"
          ],
          "value": {
            "f64": "Infinity"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: json: non-finite number"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "json"
          ],
          "value": {
            "f64": "-Infinity"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: json: non-finite number"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "json"
          ],
          "value": {
            "array": [
              {
                "int": "1"
              },
              {
                "f64": "NaN"
              }
            ]
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: json: non-finite number"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "json"
          ],
          "value": {
            "object": [
              [
                "a",
                {
                  "array": [
                    {
                      "f64": "Infinity"
                    }
                  ]
                }
              ]
            ]
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: json: non-finite number"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "json",
            "gz",
            "base64"
          ],
          "value": {
            "f64": "-Infinity"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: json: non-finite number"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "serialize"
          ],
          "value": {
            "f64": "NaN"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: serialize: number is not finite"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "serialize"
          ],
          "value": {
            "f64": "Infinity"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: serialize: number is not finite"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "serialize"
          ],
          "value": {
            "f64": "-Infinity"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: serialize: number is not finite"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "serialize"
          ],
          "value": {
            "array": [
              {
                "int": "1"
              },
              {
                "f64": "NaN"
              }
            ]
          },
          "expect": {
