              "error": "codec_encode",
              "message": "codec_encode: yaml: number is not finite"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "yaml"
          ],
          "value": {
            "f64": "-Infinity"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: yaml: number is not finite"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "yaml"
          ],
          "value": {
            "array": [
              {
                "int": "1"
              },
              {
                "f64": "NaN"
              }
            ]
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: yaml: number is not finite"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "yaml"
          ],
          "value": {
            "object": [
              [
                "a",
                {
                  "array": [
                    {
                      "f64": "Infinity"
                    }
                  ]
                }
              ]
            ]
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: yaml: number is not finite"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "yaml",
            "gz",
            "base64"
          ],
          "value": {
            "f64": "-Infinity"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: yaml: number is not finite"
            }
          }
        }
      ]
    }
  ]
