                    {
                      "f64": "Infinity"
                    }
                  ]
                }
              ]
            ]
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: serialize: number is not finite"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "serialize",
            "gz",
            "base64"
          ],
          "value": {
            "f64": "-Infinity"
          },
          "expect": {
            "none": {
              "error": "codec_encode",
              "message": "codec_encode: serialize: number is not finite"
            }
          }
        },
        {
          "op": "codec.encode",
          "styles": [
            "yaml"
          ],
          "value": {
            "f64": "NaN"
          },
          "expect": {
