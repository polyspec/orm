    {
      "id": "commit_write_conflict",
      "requirements": [
        "PRT-69",
        "PRT-71",
        "PRT-72"
      ],
      "steps": [
        {
          "op": "ir.answer",
          "chain": "transaction_retry_commit",
          "answers": {
            "begin": {
              "ok": true
            },
            "one": {
              "rows": [
                {
                  "id": "P1",
                  "name": "Ann",
                  "email": "ann@example.com",
                  "age": 30,
                  "active": true,
                  "score": "1.50"
                }
              ]
            },
            "update": {
              "affected": 1,
              "keys": []
            },
            "commit": {
              "error": {
                "code": "WRITE_CONFLICT",
                "message": "people.flowmark.md:3: a row the transaction read changed since it was read"
              }
            },
            "rollback": {
              "ok": true
            }
          },
          "expect": {
            "none": {
              "value": {
                "error": "WRITE_CONFLICT",
                "runs": 1
              }
            }
          }
        }
      ]
    },
