<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd unit for the PHP compile daemon on macOS (docs/checklist.md T5.7). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.orm.ormd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/orm/bin/ormd-0.0.1-darwin-arm64</string>
    <string>-socket</string><string>/var/run/orm/ormd.sock</string>
    <string>-schema</string><string>/srv/app/schema/schema.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/var/log/orm/ormd.log</string>
</dict>
</plist>
