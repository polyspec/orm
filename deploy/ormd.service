# systemd unit for the PHP compile daemon (docs/checklist.md T5.7). Paths are declared, absolute, no symlinks.
[Unit]
Description=orm compile daemon (ormd 0.0.1)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
RuntimeDirectory=orm
RuntimeDirectoryMode=0750
ExecStart=/opt/orm/bin/ormd-0.0.1-linux-amd64 -socket /run/orm/ormd.sock -schema /srv/app/schema/schema.json
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
