<?xml version="1.0" encoding="UTF-8"?>
<!--
  The PHPUnit configuration of the package's tests. Each test class declares its size: #[Small] for a case that computes in
  memory and reads repository files, #[Medium] for one that runs statements on a database of TEST_ENV, #[Large] for one that
  runs a child process (php, go, node). No timer ends a case: neither PHPUnit (enforceTimeLimit is off) nor the test
  runner of kit, which holds no time limit since kit 0.0.105, so a case ends on the event that it waits for (T385.1).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../vendor-php/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         recordTestRunHistory="false"
         colors="false"
         enforceTimeLimit="false"
         requireCoverageMetadata="false"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnEmptyTestSuite="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerErrors="true">
    <php>
        <env name="ORM_PHP_MODE" value="extension" force="true"/>
    </php>
    <testsuites>
        <testsuite name="polyspec/orm-php-ext">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
