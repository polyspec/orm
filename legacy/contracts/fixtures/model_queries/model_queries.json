    {
      "id": "a_refused_row_ends_the_read_and_keeps_the_connection",
      "requirements": [
        "COD-41",
        "PRT-66",
        "PRT-68"
      ],
      "steps": [
        {
          "op": "model.connect",
          "pool_size": 1,
          "as": "db"
        },
        {
          "op": "sql.exec",
          "reason": "996 rows after the five of the seed, so that the 1001 rows of the read span more than one batch of a flowmark answer (PRT-66)",
          "sql": "INSERT INTO author (name, user_seq, service_seq, service_region_seq, service_member_seq, start_dt, end_dt) WITH d AS (SELECT 0 AS n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) SELECT CONCAT('author-', s.v), 1, 1, 1, 1, '2026-06-01 00:00:00.000000', '2026-06-01 00:00:00.000000' FROM (SELECT a.n + 10 * b.n + 100 * c.n + 6 AS v FROM d a, d b, d c) s WHERE s.v <= 1001"
        },
        {
          "op": "sql.exec",
          "reason": "an early row whose stored aes_hex_email is no hex text, which the hex stage of its codec refuses on read (PRT-68)",
          "sql": "UPDATE author SET aes_hex_email = 'zz' WHERE seq = 2"
        },
        {
          "op": "model.query",
          "connection": "db",
          "model": "Author",
          "order": [
            "seq"
          ],
          "columns": [
            "seq",
            "aes_key_version",
            "aes_hex_email"
          ],
          "expect": {
            "mysql": {
              "error": "CODEC_DECODE",
              "message": "CODEC_DECODE: author.aes_hex_email: hex: odd length or non-hex input"
            },
            "postgres": {
              "error": "CODEC_DECODE",
              "message": "CODEC_DECODE: author.aes_hex_email: hex: odd length or non-hex input"
            },
            "sqlite": {
              "error": "CODEC_DECODE",
              "message": "CODEC_DECODE: author.aes_hex_email: hex: odd length or non-hex input"
            }
          }
        },
