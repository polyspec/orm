{
  "$schema": "../../../../scripts/features/schema/recipe.schema.json",
  "requirements": [
    "PRT-67",
    "INT-150",
    "DIA-154"
  ],
  "fixture": "contracts/fixtures/conformance_verification/dbspec-set.json",
  "cases": [
    {
      "id": "text_not_utf8_into_a_text_slot_is_refused",
      "requirements": [
        "PRT-67"
      ],
      "steps": [
        {
          "op": "model.connect",
          "pool_size": 1,
          "as": "db"
        },
        {
          "op": "model.creates",
          "connection": "db",
          "model": "BindCell",
          "rows": [
            {
              "label": {
                "text": "raw"
              },
              "body": {
                "text_hex": "ff"
              }
            }
          ],
          "batch": 1,
          "expect": {
            "mysql": {
              "error": "CODEC_ENCODE"
            },
            "postgres": {
              "error": "CODEC_ENCODE"
            },
            "sqlite": {
              "error": "CODEC_ENCODE"
            }
          }
        },
        {
          "op": "model.count",
          "connection": "db",
          "model": "BindCell",
          "expect": {
            "mysql": {
              "value": {
                "int": "0"
              }
            },
            "postgres": {
              "value": {
                "int": "0"
              }
            },
            "sqlite": {
              "value": {
                "int": "0"
              }
            }
          }
        }
      ]
    },
    {
      "id": "text_not_utf8_through_a_statement_reads_back",
      "databases_differ": "A text that is not UTF-8 is refused by MySQL and PostgreSQL and stored as its bytes by SQLite (DIA-220).",
      "requirements": [
        "PRT-67",
        "INT-150"
      ],
      "steps": [
        {
          "op": "model.connect",
          "pool_size": 1,
          "as": "db"
        },
        {
          "op": "utils.run",
          "connection": "db",
          "statements": [
            {
              "kind": "insert",
              "tables": [
                "bind_cell"
              ],
              "sql": {
                "mysql": "INSERT INTO bind_cell (label, body) VALUES ('raw', ?)",
                "postgres": "INSERT INTO bind_cell (label, body) VALUES ('raw', $1)",
                "sqlite": "INSERT INTO bind_cell (label, body) VALUES ('raw', ?)"
              },
              "params": [
                {
                  "text_hex": "ff"
                }
              ]
            },
            {
              "kind": "select",
              "tables": [
                "bind_cell"
              ],
              "sql": "SELECT body FROM bind_cell WHERE label = 'raw'"
            }
          ],
          "expect": {
            "mysql": {
              "error": "DRIVER",
              "message_holds": "Incorrect string value"
            },
            "postgres": {
              "error": "DRIVER",
              "message_holds": "invalid byte sequence for encoding \"UTF8\""
            },
            "sqlite": {
              "value": {
                "array": [
                  {
                    "array": [
                      {
                        "bytes_hex": "ff"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
  ]
}
