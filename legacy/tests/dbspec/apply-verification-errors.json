          "call": "apply",
          "sql": [
            "PRAGMA foreign_keys = 0"
          ],
          "stop_on_applied": "stop",
          "fail_statements": [
            {
              "statement": "PRAGMA foreign_keys = 0",
              "message": "restore failed"
            },
            {
              "statement": "PRAGMA locking_mode = normal",
              "message": "release failed"
            }
          ],
          "expect": {
            "none": {
              "failure": "stop",
              "cleanup": [
                "restore failed",
                "release failed"
              ]
            }
          }
