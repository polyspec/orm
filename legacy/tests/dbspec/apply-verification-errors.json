            "ref": "plan"
          },
          "call": "apply",
          "sql": [
            "PRAGMA foreign_keys = 0"
          ],
          "fail_statements": [
            {
              "statement": "BEGIN EXCLUSIVE",
              "message": "begin failed",
              "sqlite_result": 5
            },
            {
              "statement": "PRAGMA foreign_keys = 0",
              "message": "restore failed"
            }
          ],
          "expect": {
            "none": {
              "code": "locked",
              "cleanup": [
                "restore failed"
              ]
            }
          }
        }
