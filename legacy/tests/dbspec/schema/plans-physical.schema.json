{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tests/dbspec/plans-physical.json",
  "description": "The database data of the cases of plan-cases.json, keyed by case id: before runs before the plan steps, after runs after them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "note",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "cases": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "before",
          "after"
        ],
        "properties": {
          "before": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/behavior"
            }
          },
          "after": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/behavior"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "effect"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        },
        "rollback": {
          "type": "string"
        },
        "restore": {
          "type": "string"
        },
        "restore_if": {
          "type": "string"
        },
        "rollback_restore": {
          "type": "string"
        },
        "irreversible": {
          "type": "string"
        },
        "finalize": {
          "const": true
        },
        "null_checks": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              },
              {
                "type": [
                  "string",
                  "null"
                ]
              }
            ],
            "minItems": 3,
            "maxItems": 3,
            "items": false
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "rollback"
          ],
          "properties": {
            "rollback": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "irreversible"
          ],
          "properties": {
            "irreversible": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "finalize"
          ],
          "properties": {
            "finalize": {
              "const": true
            }
          }
        }
      ]
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "sql": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "want": {
          "type": "string"
        },
        "fails": {
          "const": true
        },
        "dialects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "mysql",
              "postgres",
              "sqlite"
            ]
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "sql"
          ],
          "properties": {
            "sql": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
