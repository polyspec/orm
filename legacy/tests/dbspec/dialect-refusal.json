{
  "$schema": "../../scripts/features/schema/recipe.schema.json",
  "version": 1,
  "note": "The refusal of a dialect that is none of mysql, postgres and sqlite, and of a server that is not a server of the dialect (DBS-174). The other five runtimes bind every case. Rust takes a dialect and a server by enum types, so a name that is none of them has no call: its compile fixtures dbs174-plan-unknown-dialect-e0308 and dbs174-render-unknown-dialect-e0308 hold that refusal, and Rust binds only the case introspect-server-of-another-dialect, whose postgres dialect and MariaDB server are values of both types.",
  "requirements": [
    "DBS-174"
  ],
  "cases": [
    {
      "id": "plan-steps-unknown-dialect",
      "requirements": [
        "DBS-174"
      ],
      "steps": [
        {
          "op": "dbspec.parse_plan",
          "lines": [
            "dbplan 1 dialect",
            "from empty",
            "",
            "dbspec 1 schema",
            "",
            "table item {",
            "  id i64",
            "  primary key (id)",
            "}"
          ],
          "as": "plan",
          "expect": {
            "none": {
              "diagnostics": []
            }
          }
        },
        {
          "op": "dbspec.plan_steps",
          "source": null,
          "plan": {
            "ref": "plan"
          },
          "dialect": "oracle",
          "expect": {
            "none": {
              "refused": "oracle"
            }
          }
        }
      ]
    },
    {
      "id": "render-unknown-dialect",
      "requirements": [
        "DBS-174"
      ],
      "steps": [
        {
          "op": "dbspec.render",
          "documents": [
            "../../contracts/fixtures/audit.dbs"
          ],
          "dialect": "oracle",
          "expect": {
            "none": {
              "refused": "oracle"
            }
          }
        }
      ]
    },
    {
      "id": "introspect-unknown-dialect",
      "requirements": [
        "DBS-174"
      ],
      "steps": [
        {
          "op": "dbspec.introspect_refusal",
          "dialect": "oracle",
          "expect": {
            "none": {
              "refused": "oracle"
            }
          }
        }
      ]
    },
    {
      "id": "introspect-server-of-another-dialect",
      "requirements": [
        "DBS-174"
      ],
      "steps": [
        {
          "op": "dbspec.introspect_refusal",
          "dialect": "postgres",
          "server": "mariadb",
          "expect": {
            "none": {
              "refused": "mariadb"
            }
          }
        }
      ]
    },
    {
      "id": "introspect-unknown-server",
      "requirements": [
        "DBS-174"
      ],
      "steps": [
        {
          "op": "dbspec.introspect_refusal",
          "dialect": "mysql",
          "server": "oracle",
          "expect": {
            "none": {
              "refused": "oracle"
            }
          }
        }
      ]
    }
  ]
}
