          "text": [
            "dbspec 1 notes",
            "",
            "# uses the people document",
            "use people { person }",
            "",
            "# a note",
            "table note {",
            "  # the key",
            "  id i64 identity",
            "  # the author",
            "  author_id i64",
            "  body varchar(64)",
            "  # the primary key",
            "  primary key (id)",
            "  # the unique key",
            "  unique uq_note_body (body)",
            "  # the index",
            "  index ix_note_author (author_id)",
            "  # the foreign key",
            "  foreign key fk_note_author (author_id) references person (id) on delete restrict on update restrict",
            "  # the check",
            "  check ck_note_id (id > 0)",
            "  # the settings",
            "  settings {",
            "    # a setting",
            "    immutable",
            "    # the end of the settings",
            "  }",
            "  # the end of the table",
            "}",
            "",
            "table key_note {",
            "  id i64",
            "  # only the primary key",
            "  primary key (id)",
            "}",
            "",
            "table setting_note {",
            "  id i64",
            "  primary key (id)",
            "  settings {",
            "    # only a setting",
            "    immutable",
            "  }",
            "}",
            "",
            "table closing_note {",
            "  id i64",
            "  primary key (id)",
            "  settings {",
            "    immutable",
            "    # only the end of the settings",
            "  }",
            "}",
            "",
            "# a diagram",
            "diagram main {",
            "  # an entry",
            "  note at 0 0",
            "  # the end of the diagram",
            "}",
            "",
            "# the end of the document"
          ],
          "set": {
            "people": [
