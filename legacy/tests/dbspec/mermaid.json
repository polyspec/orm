          "text": [
            "dbspec 1 shop",
            "",
            "# accounts",
            "table users {",
            "  id i64 identity",
            "  mail varchar(64)",
            "  age i32 null",
            "  note varchar(32) null default 'say \"hi\"'",
            "  primary key (id)",
            "  unique uq_users_mail (mail)",
            "  check ck_users_age (age >= 0)",
            "  settings {",
            "    immutable",
            "  }",
            "}",
            "",
            "table orders {",
            "  id i64 identity",
            "  user_id i64 null",
            "  total decimal(10,2) default 0.00",
            "  primary key (id)",
            "  index ix_orders_user (user_id)",
            "  foreign key fk_orders_user (user_id) references users (id) on delete set_null on update restrict",
            "}"
          ],
          "expect": {
            "none": {
              "value": {
                "mermaid": "erDiagram\n    orders {\n        i64 id PK \"identity\"\n        i64 user_id FK \"null\"\n        decimal(10-2) total \"default 0.00\"\n    }\n    users {\n        i64 id PK \"identity\"\n        varchar(64) mail UK\n        i32 age \"null\"\n        varchar(32) note \"null\"\n    }\n    users |o--o{ orders : \"fk_orders_user (user_id) references (id)\"\n",
