              "error": "SCHEMA_INVALID",
              "diagnostics": ["1:1 header"]
            }
          }
        }
      ]
    },
    {
      "id": "external-text-without-header",
      "requirements": [
        "SCH-12",
        "DBS-156"
      ],
      "steps": [
        {
          "op": "dbspec.load_set",
          "owned": [
            "dbspec 1 shop",
            "",
            "use core { account }",
            "",
            "table item {",
            "  seq i64",
            "  account_seq i64",
            "  primary key (seq)",
            "  index ix_item_account (account_seq)",
            "  foreign key fk_item_account (account_seq) references account (seq) on delete restrict on update restrict",
            "}"
          ],
          "external": [
            "table account {}"
          ],
          "expect": {
            "none": {
