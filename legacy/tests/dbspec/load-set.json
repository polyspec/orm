              "diagnostics": ["1:1 header"]
            }
          }
        }
      ]
    },
    {
      "id": "document-with-a-diagnostic",
      "requirements": [
        "SCH-12"
      ],
      "steps": [
        {
          "op": "dbspec.load_set",
          "owned": [
            "dbspec 1 shop",
            "",
            "table item {",
            "  seq i64",
            "}"
          ],
          "external": [],
          "expect": {
            "none": {
              "error": "SCHEMA_INVALID",
              "diagnostics": ["3:7 key"]
            }
          }
        }
      ]
    },
    {
      "id": "every-diagnostic-of-every-document-counted-from-its-document",
      "requirements": [
        "SCH-12"
      ],
      "steps": [
        {
          "op": "dbspec.load_set",
          "owned": [
            "dbspec 1 first",
            "",
            "table item {",
            "  seq i64",
            "}",
            "",
            "table part {",
            "  seq i64",
            "}",
            "dbspec 1 second",
            "",
            "table stock {",
            "  seq i64",
            "}"
          ],
          "external": [],
          "expect": {
            "none": {
              "error": "SCHEMA_INVALID",
              "diagnostics": ["3:7 key", "7:7 key", "3:7 key"]
            }
          }
        }
      ]
    },
    {
      "id": "manifest-diagnostics-joined-exactly",
      "requirements": [
        "SCH-12"
      ],
      "steps": [
        {
          "op": "dbspec.load_set",
          "owned": [
            "dbspec 1 first",
            "",
            "table item {",
            "  seq nosuchtype",
            "  primary key (seq)",
            "}",
            "dbspec 1 second",
            "",
            "table stock {",
            "  seq i64",
            "  label varchar(0)",
            "  primary key (seq)",
            "}"
          ],
          "external": [],
          "expect": {
            "none": {
              "error": "SCHEMA_INVALID",
              "message": "4:7 type: document first: type \"nosuchtype\" is not a dbspec type; 5:9 type: document second: varchar(n) needs 1 <= n <= 16383"
            }
          }
        }
      ]
    },
    {
      "id": "manifest-text-with-a-repeated-document",
      "requirements": [
        "SCH-12",
        "DBS-99"
      ],
      "steps": [
        {
          "op": "dbspec.load_set",
          "owned": [
            "dbspec 1 accounts",
            "",
            "table tenant {",
            "  id i64 identity",
            "  name varchar(50)",
            "  primary key (id)",
            "}",
            "dbspec 1 accounts",
            "",
            "table tenant {",
            "  id i64 identity",
            "  name varchar(50)",
            "  primary key (id)",
            "}"
          ],
          "external": [],
          "expect": {
            "none": {
              "error": "SCHEMA_INVALID",
              "diagnostics": ["1:10 name.duplicate"]
            }
          }
        }
      ]
