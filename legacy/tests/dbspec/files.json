{
  "$schema": "../../../scripts/features/schema/recipe.schema.json",
  "requirements": [
    "DBS-4",
    "DBS-155",
    "DBS-171"
  ],
  "cases": [
    {
      "id": "dbschema-project",
      "requirements": [
        "DBS-4",
        "DBS-155",
        "DBS-171"
      ],
      "steps": [
        {
          "op": "dbspec.read_file",
          "path": "files/dbschema.dbs",
          "expect": {
            "none": {
              "errors": [
                {
                  "line": 1,
                  "column": 1,
                  "rule": "signature"
                }
              ]
            }
          }
        },
        {
          "op": "dbspec.read_bytes",
          "path": "files/dbschema.dbs",
          "expect": {
            "none": {
              "errors": [
                {
                  "line": 1,
                  "column": 1,
                  "rule": "signature"
                }
              ]
            }
          }
        }
      ]
    },
