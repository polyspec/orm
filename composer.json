{
    "name": "polyspec/orm-workspace",
    "description": "Development root of the repository, not published: it installs packages/php from its directory and takes the polyspec packages of other repositories from their GitHub releases",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "polyspec/orm": "0.0.18"
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Orm\\Tests\\Model\\": "packages/php/gen/",
            "Polyspec\\Orm\\Tests\\MarkdownModel\\": "packages/php/markdownmodel/"
        },
        "files": [
            "packages/php/gen/bootstrap.php"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/php",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "package",
            "package": {
                "name": "polyspec/ordered-json",
                "version": "0.0.9",
                "type": "library",
                "require": {
                    "php": ">=8.5",
                    "ext-json": "*",
                    "ext-pcre": "*"
                },
                "suggest": {
                    "ext-ordered_json": "Native backend from the polyspec/ordered-json-extension PIE package"
                },
                "autoload": {
                    "psr-4": {
                        "Polyspec\\OrderedJson\\": "src/"
                    },
                    "files": [
                        "src/OrderedJson.php"
                    ]
                },
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/polyspec/ordered-json/releases/download/v0.0.9/polyspec-ordered-json-php-0.0.9.zip",
                    "shasum": "5f93a2c0df5967163801cb3d4d087e44834bb456"
                }
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/yaml",
            "no-api": true
        }
    ],
    "config": {
        "vendor-dir": "vendor-php",
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "2.3.1",
        "phpunit/phpunit": "13.4.2",
        "opis/json-schema": "2.6.0"
    }
}
