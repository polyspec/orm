{
    "name": "polyspec/orm-workspace",
    "description": "Development root of the repository, not published: it installs packages/php from its directory and takes the polyspec packages of other repositories from their GitHub releases",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "polyspec/orm": "0.0.19"
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Orm\\Tests\\Model\\": "packages/php/gen/",
            "Polyspec\\Orm\\Tests\\MarkdownModel\\": "packages/php/markdownmodel/",
            "Polyspec\\Orm\\Tests\\ComplexModel\\": "packages/php/complexmodel/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/php",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "package",
            "package": {
                "name": "polyspec/ordered-json",
                "version": "0.0.13",
                "type": "library",
                "require": {
                    "php": ">=8.4",
                    "ext-json": "*",
                    "ext-pcre": "*"
                },
                "suggest": {
                    "ext-ordered_json": "Native backend from the polyspec/ordered-json-extension PIE package"
                },
                "autoload": {
                    "psr-4": {
                        "Polyspec\\OrderedJson\\": "src/"
                    },
                    "files": [
                        "src/OrderedJson.php"
                    ]
                },
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/polyspec/ordered-json/releases/download/v0.0.13/polyspec-ordered-json-php-0.0.13.zip",
                    "shasum": "8fdf3c11ebd46eb7e82180623bd4481d7496567a"
                }
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/yaml",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/json-schema",
            "no-api": true
        }
    ],
    "config": {
        "vendor-dir": "vendor-php",
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "2.3.3",
        "phpunit/phpunit": "13.4.5",
        "opis/json-schema": "2.6.0-p1"
    }
}
