{
    "name": "polyspec/orm-workspace",
    "description": "Development root of the repository, not published: it installs packages/orm-php from its directory and takes the polyspec packages of other repositories from their GitHub releases",
    "type": "project",
    "license": "MIT",
    "require": {
        "polyspec/orm": "0.0.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/orm-php",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "package",
            "package": {
                "name": "polyspec/ordered-json",
                "version": "0.0.7",
                "type": "library",
                "require": {
                    "php": ">=8.2",
                    "ext-json": "*",
                    "ext-pcre": "*"
                },
                "suggest": {
                    "ext-ordered_json": "Native backend from the polyspec/ordered-json-extension PIE package"
                },
                "autoload": {
                    "files": [
                        "src/OrderedJson.php"
                    ]
                },
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/polyspec/ordered-json/releases/download/v0.0.7/polyspec-ordered-json-php-0.0.7.zip",
                    "shasum": "ba76343b5d6a2ce7db53fc88bc71b0706fa5fd4a"
                }
            }
        }
    ],
    "config": {
        "vendor-dir": "vendor-php",
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.0"
        }
    }
}
