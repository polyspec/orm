{
    "name": "polyspec/orm-workspace",
    "description": "Development root of the repository, not published: it installs legacy/packages/php from its directory and takes the polyspec packages of other repositories from their GitHub releases",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "polyspec/orm": "0.0.33"
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Orm\\Tests\\Model\\": "legacy/packages/php/gen/",
            "Polyspec\\Orm\\Tests\\MarkdownModel\\": "legacy/packages/php/markdownmodel/",
            "Polyspec\\Orm\\Tests\\BindModel\\": "legacy/packages/php/bindmodel/",
            "Polyspec\\Orm\\Tests\\ComplexModel\\": "legacy/packages/php/complexmodel/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "legacy/packages/php",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "composer",
            "url": "https://github.com/polyspec/ordered-json/releases/download/v0.0.25/packages.json"
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/yaml",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/json-schema",
            "no-api": true
        }
    ],
    "config": {
        "vendor-dir": "vendor-php",
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "2.3.3",
        "phpunit/phpunit": "13.4.5",
        "min-0-max/json-schema": "2.6.0-p2"
    }
}
