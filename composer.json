{
    "name": "polyspec/orm-workspace",
    "description": "Development root of the repository, not published: it installs packages/php and packages/php-gen from their directories and takes the polyspec packages of other repositories from their GitHub releases",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "polyspec/orm": "0.0.18",
        "polyspec/orm-gen": "0.0.18"
    },
    "autoload-dev": {
        "psr-4": {
            "Polyspec\\Orm\\Tests\\Model\\": "packages/php/gen/",
            "Polyspec\\Orm\\Tests\\MarkdownModel\\": "packages/php/markdownmodel/",
            "Polyspec\\Orm\\Tests\\ComplexModel\\": "packages/php/complexmodel/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/php",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/php-gen",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "package",
            "package": {
                "name": "polyspec/ordered-json",
                "version": "0.0.10",
                "type": "library",
                "require": {
                    "php": ">=8.4",
                    "ext-json": "*",
                    "ext-pcre": "*"
                },
                "suggest": {
                    "ext-ordered_json": "Native backend from the polyspec/ordered-json-extension PIE package"
                },
                "autoload": {
                    "psr-4": {
                        "Polyspec\\OrderedJson\\": "src/"
                    },
                    "files": [
                        "src/OrderedJson.php"
                    ]
                },
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/polyspec/ordered-json/releases/download/v0.0.10/polyspec-ordered-json-php-0.0.10.zip",
                    "shasum": "efa11f67aa6191755cdf716396ef543ab1e8e412"
                }
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/yaml",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/min-0-max/json-schema",
            "no-api": true
        }
    ],
    "config": {
        "vendor-dir": "vendor-php",
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "2.3.1",
        "phpunit/phpunit": "13.4.5",
        "opis/json-schema": "2.6.0-p1"
    }
}
