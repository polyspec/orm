// The oxlint configuration of every polyspec repository, copied by kit; change it in kit, never in a copy. make lint-ts runs
// oxlint with -c of this file, --type-aware (oxlint-tsgolint, which reads the TypeScript 7 project) and --deny-warnings. The
// correctness rules fail, and so does a promise that is neither awaited nor handled: it lets a test end before its work does.
// allowForKnownSafeCalls is the option of typescript-eslint for node:test (K138): test, describe, it and suite, with skip,
// only and todo, return a promise that the runner itself awaits, so a top-level registration is no floating promise. The
// subtest t.test of a TestContext shares the name test; the runner of Node 26 waits for an unawaited one and reports it.
// No escape hatch from the types of TypeScript (K155): no explicit any and no type assertion that changes nothing.
// @ts-ignore and @ts-nocheck are forbidden; @ts-expect-error needs a description of the error it expects, and tsc fails it
// when nothing errs.
// No unsafe flow of any (K157): an any value is no argument, assignment, callee, object of a member access or return value
// of a typed place, and a type assertion does not narrow a type; JSON is read through a schema (K158) and an unknown value is
// narrowed by a check.
// No swallowed error (K256): no empty block, an empty catch included, and no catch that only rethrows; an error thrown in a
// catch carries the caught one as its cause (preserve-caught-error, P8, K334).
// No non-null assertion (K156): a value whose type admits undefined or null is read with a check, or with a throwing accessor
// that names what it expects (present of scripts/kit/present.mts in kit), never asserted away with `!`.
// oxc/number-arg-out-of-range is off: it allows toFixed and toExponential 0 to 20 and toPrecision 1 to 21, the limits before
// ES2018, which raised them to 100 (ECMA-262 Number.prototype.toExponential, toFixed and toPrecision: fractionDigits 0 to
// 100, precision 1 to 100), so it fails valid code such as toExponential(25); oxlint 1.88.0 and oxc main keep the old
// limits, and no oxc issue reports it (K161).
// The type-aware rules, which oxlint-tsgolint runs, apply to TypeScript files only, as typescript-eslint's disableTypeChecked
// turns them off for JavaScript (K170): in a plain .js or .mjs file every untyped parameter is any, so they report only that
// the file is JavaScript. An override cannot enable a category, so the base turns off the type-aware rules of correctness
// (the type_aware rules of oxlint --rules) and the override of TypeScript enables them with the rules above; the rules
// without types (ban-ts-comment, no-explicit-any, no-non-null-assertion and the rest of correctness) apply to every file.
{
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "oxc/number-arg-out-of-range": "off",
    "no-empty": "error",
    "no-useless-catch": "error",
    "preserve-caught-error": "error",
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": "allow-with-description", "ts-ignore": true, "ts-nocheck": true, "ts-check": false, "minimumDescriptionLength": 3 }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "off",
    "typescript/await-thenable": "off",
    "typescript/no-array-delete": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/no-for-in-array": "off",
    "typescript/no-implied-eval": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unsafe-unary-minus": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off"
  },
  "overrides": [
    {
      "files": ["**/*.{ts,mts,cts,tsx}"],
      "rules": {
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-type-assertion": "error",
        "typescript/no-floating-promises": [
          "error",
          {
            "allowForKnownSafeCalls": [
              { "from": "package", "package": "node:test", "name": ["test", "describe", "it", "suite", "skip", "only", "todo"] }
            ]
          }
        ],
        "typescript/await-thenable": "error",
        "typescript/no-array-delete": "error",
        "typescript/no-base-to-string": "error",
        "typescript/no-duplicate-type-constituents": "error",
        "typescript/no-for-in-array": "error",
        "typescript/no-implied-eval": "error",
        "typescript/no-meaningless-void-operator": "error",
        "typescript/no-misused-spread": "error",
        "typescript/no-redundant-type-constituents": "error",
        "typescript/no-unsafe-unary-minus": "error",
        "typescript/no-useless-default-assignment": "error",
        "typescript/require-array-sort-compare": "error",
        "typescript/restrict-template-expressions": "error",
        "typescript/unbound-method": "error"
      }
    }
  ]
}
