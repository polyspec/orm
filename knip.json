// The knip configuration of orm (T391): what make runs or spawns that knip cannot see from the manifests, each with its
// reason. make lint-ts runs knip from the root, which reads this file; it was config/knip-entries.json, which kit merged
// into its own configuration before kit 0.0.98 (K1050).
{
  "node": {
    "entry": [
      // every test file, which a make target runs with node --test
      "**/*.test.{ts,mts,cts,mjs,cjs,js}",
      // every script, which a make target or a workflow runs with node
      "scripts/**/*.{ts,mts,cts,mjs,cjs,js}",
      // every benchmark, which a make target runs with node
      "benchmarks/**/*.{ts,mts,cts,mjs,cjs,js}",
      // the VitePress configuration of the site under docs/, which make docs-build runs with vitepress build docs
      "docs/.vitepress/config.mts",
      // the VitePress theme of the site under docs/, which VitePress loads by its path
      "docs/.vitepress/theme/index.ts",
      // the TypeScript thin-slice demo, which the usage guide runs with node and the thin-slice checks run
      "examples/thin-slice/ts/main.mts",
      // the Rust compiler fixture runner, which make rust-compiler-fixtures-check runs with node (Makefile)
      "scripts/rust/compiler-fixtures.mts",
      // the dbspec comparison check, which make runs with node
      "tests/dbspec/compare/check.mts",
      // the writer of the stress documents, which make runs with node
      "tests/dbspec/stress.mts",
      // the Go test runner, which the repository checks and the CI spawn
      "tests/go-run.mts",
      // the process that tests/interfaces/check/extract.mts starts by its path to end the groups of the checker when the checker ends
      "tests/interfaces/check/reaper.mts",
      // constructor declarations passed by the native interface-extractor test to its spawned TypeScript compiler
      "tests/interfaces/check/fixtures/typescript-constructor.ts"
    ]
  },
  "ignoreBinaries": [
    // the SQLite shell that make decimal-bench-sqlite runs (scripts/decimal-bench-sqlite.mts)
    "sqlite3",
    // the POSIX tool that the tests of scripts/features/coverage and scripts/test-servers use to block a child on a pipe
    "mkfifo",
    // Homebrew, which scripts/php/php-min.mts uses to find the lowest supported PHP on macOS
    "brew",
    // the Rust compiler whose version scripts/repo/check.test.mts reads
    "rustc",
    // the MySQL client that make test-servers and its tests run
    "mysql",
    // the MySQL server that make test-servers starts
    "mysqld",
    // the PostgreSQL control tool that make test-servers runs
    "pg_ctl",
    // the MySQL tool that loads the time zone tables for make test-servers
    "mysql_tzinfo_to_sql",
    // GNU make, which the tests of scripts/check/run, scripts/repo/python-venv and tests/cargo-test run on the Makefile
    "make",
    // the PHP of .php-version, which scripts/ci/php-extension-tools.mts, scripts/php-without-mysql.mts and the interface and repository checks run
    "php",
    // the Go of mise.toml, which tests/go-run.mts and tests/go-test.mts run
    "go",
    // the PostgreSQL client that the test servers of the PostgreSQL database check run against the primary, the replica and the pooler (scripts/test-servers.test.mts)
    "psql",
    // the PostgreSQL command that creates the cluster of the replica tests (scripts/test-servers.test.mts)
    "initdb",
    // the PostgreSQL command that copies the primary into the replica (scripts/test-servers.test.mts)
    "pg_basebackup",
    // the MariaDB server, client and time zone loader that make orm-test-mariadb runs (scripts/test-servers-mariadb.mts)
    "mariadbd",
    "mariadb",
    "mariadb-tzinfo-to-sql",
    // the tool that names the fmt headers for the MariaDB build of make orm-install-mariadb (scripts/mariadb-build.mts)
    "pkg-config"
  ],
  "ignoreDependencies": [
    // the Vue of VitePress, which the site theme (docs/.vitepress/theme/index.ts) imports; vitepress pins it
    "vue",
    // the MySQL driver of the TypeScript client (packages/ts), which the root's database checks import through the workspace
    "mysql2",
    // the PostgreSQL driver of the TypeScript client (packages/ts), which the root's database checks import through the workspace
    "pg"
  ],
  "workspaces": {
    // the TypeScript client @polyspec/orm, a workspace of the root package.json
    "packages/ts": {
      "entry": [
        // the TypeScript client tests, each run by node from a make target (ts-check/test, client-unit-check, client-db-check and the feature checks of contracts/features.json)
        "tests/*.mjs",
        // the type tests of the TypeScript client, which tsc checks through packages/ts/tsconfig.json and orm-gen scans for the models
        "tests/*.ts",
        // the TypeScript conformance runner, which tests/conformance/check/recipe_vectors.mts spawns
        "testing/conformance/runner_typescript.mts",
        // the TypeScript declaration extractor, which tests/interfaces/check spawns with its own TypeScript
        "testing/interfaces/typescript.mts",
        // the TypeScript apply runner, which the Go physical apply tests spawn
        "testing/dbspec/apply/typescript.mts",
        // the TypeScript compare runner, which tests/dbspec/compare/runners.mts spawns
        "testing/dbspec/compare/typescript.mts",
        // the TypeScript introspect runner, which the Go physical introspect tests spawn
        "testing/dbspec/introspect/typescript.mts",
        // the dbspec tool command that the dbspec checks run from packages/ts/dist
        "src/tools/cli.ts",
        // the generated models of the Markdown fixture, which the markdown tests load from dist
        "src/models/markdown_fixture/models.ts",
        // the generated models of the decimal fixture, which the decimal tests load from dist
        "src/models/decimal_fixture/models.ts"
      ]
    },
    // the dbspec language service, a workspace of the root package.json
    "packages/dbspec-language": {
      "entry": [
        // the . export of @polyspec/dbspec-language, built to dist/index.js
        "src/index.ts",
        // the dbspec-language command, built by src/cli/tsconfig.json and run by the dbspec-language checks
        "src/cli/main.ts"
      ]
    },
    // the VS Code extension of dbspec, a workspace of the root package.json
    "packages/dbspec-vscode": {
      "entry": [
        // the VS Code integration test, which make dbspec-vscode-check runs
        "tests/integration/run.mjs",
        // the suite that @vscode/test-electron loads by path from tests/integration/run.mjs
        "tests/integration/suite/index.cjs"
      ]
    }
  }
}
